// ---------------------------------------------------------------------------
// MarketplaceCall — the canonical, sensor-neutral operational projection of a
// call. This is NOT a CallGrid table: `provider` records which sensor produced
// the row (CallGrid today; Ringba/Invoca/an internal auction tomorrow project
// into the SAME shape). The raw Interaction + Interaction.metadata remain the
// audit record and are never stopped or deleted; this row is the normalized,
// queryable projection the Intelligence layer reads instead of parsing JSON.
//
// Invariants (see docs/CALLGRID_INTELLIGENCE_FOUNDATION.md §Persistence):
//   • Idempotent: unique on (provider, externalId) — re-projecting is an upsert.
//   • Traceable: interactionId + provider + externalId point back to the source.
//   • Money is integer CENTS. Unknown values are null, NEVER defaulted to 0.
//   • Attribution is nullable EXTERNAL-reference ids only — no Buyer/Vendor/
//     Source/Campaign tables are introduced here; canonical entities come later
//     and can be linked without rewriting rows.
//   • sourceOccurredAt (when the call happened) is separate from createdAt/
//     updatedAt (when Loop wrote/updated the projection).
// ---------------------------------------------------------------------------
model MarketplaceCall {
  id             String @id @default(cuid())
  organizationId String

  // Provenance: `provider` is the sensor id (e.g. 'callgrid'). Sensor-neutral.
  provider      String
  externalId    String
  // Traceability back to the raw source event (Interaction.id). Kept as a plain
  // reference (not a formal relation) so the raw Interaction model is untouched.
  interactionId String?

  // When the call actually occurred at the source.
  sourceOccurredAt DateTime

  // Status / disposition. `status` is the canonical event type; `rawStatus` is
  // the provider-native string (preserves BUSY/FAILED/REJECTED distinctions the
  // coarse taxonomy collapses).
  status                   String?
  rawStatus                String?
  endedBy                  String?
  // CONNECTED duration: elapsed time AFTER the call connects, per CallGrid's
  // CallDuration. Renamed from `durationSeconds` (Sprint 37) because that name
  // read as total elapsed time and invited comparison against total-duration
  // figures that measure something else. Billable duration is a THIRD quantity
  // and must never populate this field.
  //
  // @map keeps the physical column so no migration is required.
  connectedDurationSeconds Int?    @map("durationSeconds")

  // Attribution — nullable external-reference ids + best-known labels.
  buyerExternalId       String?
  buyerLabel            String?
  vendorExternalId      String?
  vendorLabel           String?
  sourceExternalId      String?
  sourceLabel           String?
  campaignExternalId    String?
  campaignLabel         String?
  destinationExternalId String?

  // Geo (nullable — only the webhook path supplies these today).
  callerState String?
  callerZip   String?

  // Economics — integer CENTS, null when unmeasured (never 0-defaulted).
  revenueCents Int?
  payoutCents  Int?
  costCents    Int?
  rateCents    Int?

  // Outcome flags — null when the sensor did not say.
  // RENAMED from `qualified` (Sprint 36). CallGrid sends no qualified field of
  // any kind — this is DERIVED by Loop as billable OR converted OR paid, and
  // sat here beside genuine provider flags where it was indistinguishable from
  // one. It means "the call produced a positive commercial outcome", NOT "the
  // call met a qualification standard", and an executive reading a
  // qualification RATE reads it as call quality.
  //
  // @map keeps the physical column `qualified` so this rename needs NO
  // migration: migrations here are manually dispatched, and a code/schema skew
  // would take production down. Rename the column itself in a dedicated
  // migration when one is being deployed anyway.
  monetized Boolean? @map("qualified")
  billable  Boolean?
  converted Boolean?
  paid      Boolean?
  completed Boolean?
  noRoute   Boolean?
  duplicate Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, externalId])
  @@index([organizationId, sourceOccurredAt])
  @@index([organizationId, buyerExternalId])
  @@index([organizationId, vendorExternalId])
  @@index([organizationId, sourceExternalId])
  @@index([organizationId, campaignExternalId])
  @@index([organizationId, status])
  @@index([organizationId, monetized])
  @@index([organizationId, billable])
  @@index([organizationId, converted])
  @@map("marketplace_calls")
}

// ---------------------------------------------------------------------------
// Auction reporting — verified aggregate snapshots
// ---------------------------------------------------------------------------
//
// These three models store CallGrid's AGGREGATE report output. They are not
// event tables. CallGrid exposes no event-level bid or ping record, so a
// `MarketplaceBid` row would be a fabrication with a plausible schema — the
// most expensive kind.
//
// TWO GRAINS, DELIBERATELY UNJOINED
//   MarketplaceBidSourceSnapshot       one row per SOURCE per report window
//   MarketplacePingDestinationSnapshot one row per DESTINATION per report window
//
// Source and destination are opposite sides of the marketplace. There is no
// foreign key between them and no shared identifier, because the provider
// asserts no relationship between them. Nothing may join them by name.
//
// UNITS
//   *Cents    integer cents. Converted once, at the ingestion boundary, by the
//             same `Math.round(dollars * 100)` rule MarketplaceCall uses. The
//             dollars premise is EVIDENCE-GATED per run — see
//             MarketplaceReportRun.moneyUnitEvidence. It is not assumed here.
//   *Percent  percentage POINTS as the provider reported them: 14.473684 means
//             14.473684%. Provider rates are stored verbatim and never
//             recomputed over them; Loop-derived rates are computed at read
//             time from counts, where the denominator is explicit.
//
// NULL vs ZERO
//   Every metric is nullable. Null means the provider did not report the field.
//   Zero means the provider reported zero. Ingestion never coerces one into the
//   other.

/// Aggregate bid statistics for one source over one report window.
/// Combines GET /api/reports/bidStats with GET /api/reports/bidStats/rejections,
/// which share the source grain and are joined on sourceId within one window.
model MarketplaceBidSourceSnapshot {
  id             String @id @default(cuid())
  organizationId String

  /// Sensor id, e.g. 'callgrid'. Sensor-neutral by design.
  provider String

  /// Inclusive window as REQUESTED, in UTC. See reportTimezone.
  reportWindowStart DateTime
  reportWindowEnd   DateTime

  /// The timezone Loop requested the window in. NOT a claim about the timezone
  /// CallGrid buckets in: the three GET report endpoints accept no
  /// reportTimeZone parameter, so provider-side bucketing is UNVERIFIED.
  reportTimezone String

  /// Provider-native source id. The only legitimate join key.
  sourceExternalId String
  sourceName       String?

  // Provenance
  sourceEndpoint      String
  sourcePage          Int?
  sourceTotalPages    Int?
  providerPayloadHash String
  fetchedAt           DateTime

  // Observed bidStats metrics — null means not reported.
  total    Int?
  bids     Int?
  rated    Int?
  won      Int?
  rejected Int?

  totalBidAmountCents Int?
  totalWonAmountCents Int?
  avgBidCents         Int?
  avgWinningBidCents  Int?

  /// Provider-reported rates, in percentage points, stored verbatim.
  winRatePercent    Float?
  bidRatePercent    Float?
  rejectRatePercent Float?

  // Observed bidStats/rejections metrics. Null means the rejections report
  // returned no row for this source — which is NOT the same as zero rejections.
  rejectedDetail   Int?
  callerIdRejected Int?
  closed           Int?
  paused           Int?
  /// Provider `duplicate`. Distinct from duplicateBids; never summed together.
  duplicateCaller  Int?
  duplicateBids    Int?
  failedAcceptance Int?
  failedTagRules   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, provider, reportWindowStart, reportWindowEnd, sourceExternalId], name: "bid_source_snapshot_identity")
  @@index([organizationId, reportWindowStart])
  @@index([organizationId, provider, sourceExternalId])
  @@map("marketplace_bid_source_snapshots")
}

/// Aggregate ping statistics for one destination over one report window.
/// Source: GET /api/reports/pingStats.
model MarketplacePingDestinationSnapshot {
  id             String @id @default(cuid())
  organizationId String

  provider String

  reportWindowStart DateTime
  reportWindowEnd   DateTime
  reportTimezone    String

  destinationExternalId String
  destinationName       String?

  /// The provider's own row date. pingStats buckets rows per day, so a
  /// multi-day window returns one row per destination PER DAY. Ingestion is
  /// single-day; this field is what lets it prove that rather than assume it.
  providerRowDate DateTime?

  // Provenance
  sourceEndpoint      String
  sourcePage          Int?
  sourceTotalPages    Int?
  providerPayloadHash String
  fetchedAt           DateTime

  // Observed metrics — null means not reported.
  accepted         Int?
  agents           Int?
  failedAcceptance Int?
  failedTagRules   Int?
  minRevenue       Int?
  missingAmount    Int?
  invalidNumber    Int?
  durationElapsed  Int?
  pingTimeout      Int?
  apiFailed        Int?
  rateLimited      Int?
  suppressed       Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, provider, reportWindowStart, reportWindowEnd, destinationExternalId], name: "ping_destination_snapshot_identity")
  @@index([organizationId, reportWindowStart])
  @@index([organizationId, provider, destinationExternalId])
  @@map("marketplace_ping_destination_snapshots")
}

/// One ingestion attempt against one report endpoint for one window.
///
/// This exists so that "no rows" can be told apart from "we could not read the
/// report". Without it, a 500 and an empty day are the same absence of data,
/// and the platform would render a provider outage as zero marketplace activity.
model MarketplaceReportRun {
  id             String @id @default(cuid())
  organizationId String

  provider       String
  /// 'bidStats' | 'bidRejections' | 'pingStats'. Not an enum: the set is defined
  /// by what the provider verifiably exposes, and widening it must be a code
  /// change with evidence, not a migration.
  endpoint       String
  /// The HTTP path actually called.
  sourceEndpoint String

  reportWindowStart DateTime
  reportWindowEnd   DateTime
  reportTimezone    String

  status MarketplaceReportRunStatus

  /// Set only for non-success statuses. Never contains the credential.
  errorClassification String?
  errorDetail         String?

  fetchedAt        DateTime
  pagesFetched     Int?
  sourceTotalPages Int?
  rowCount         Int?
  /// True when pagination hit its cap. A truncated report is never reconciled
  /// or aggregated as if it were complete.
  truncated        Boolean  @default(false)

  inserted Int @default(0)
  updated  Int @default(0)
  skipped  Int @default(0)
  failed   Int @default(0)

  /// Provider footerTotals, verbatim. Kept SEPARATE from recomputedTotals so a
  /// provider/Loop disagreement stays visible instead of being averaged away.
  providerFooterTotals Json?
  /// Totals Loop recomputed by summing the rows it stored.
  recomputedTotals     Json?

  /// Whether the dollars premise behind every *Cents column was PROVEN for this
  /// run (a money field carried fractional decimals) or merely consistent with
  /// the data (all integers). Money-based findings are gated on 'proven-dollars'.
  moneyUnitEvidence String?

  /// Row keys actually returned, for drift detection against the observed contract.
  observedRowKeys Json?

  providerPayloadHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, provider, endpoint, reportWindowStart, reportWindowEnd], name: "report_run_identity")
  @@index([organizationId, provider, endpoint, fetchedAt])
  @@map("marketplace_report_runs")
}

enum MarketplaceReportRunStatus {
  /// Every declared page read, rows stored.
  SUCCESS
  /// Read cleanly, provider returned no rows. A real, reportable fact.
  EMPTY
  /// Non-2xx or network failure.
  ENDPOINT_FAILURE
  /// 2xx whose body was not JSON.
  MALFORMED_RESPONSE
  /// 2xx JSON whose shape we could not read. NEVER treated as empty.
  UNKNOWN_ENVELOPE
  /// Some pages read, page budget exhausted before totalPages.
  PARTIAL_PAGINATION
}

// ===========================================================================
// LOOP COGNITIVE ARCHITECTURE FOUNDATION (Increment 1 — canonical domain)
// ---------------------------------------------------------------------------
// The canonical cognitive layer: identity, durable memory, governed knowledge,
// explainable active state, governance policy, transactional outbox,
// subscriptions, intelligence hypotheses, and decision records.
//
// CONSOLIDATION (see docs/architecture/loop-cognitive-architecture.md):
//   - This is NOT a parallel event system. MemoryEvent is the org-scoped
//     canonical durable log; the existing `LoopEvent` gateway is REUSED as the
//     inbound ingress (its idle `processed` flag becomes the consumer seam in
//     Increment 2). `DomainEvent` (Executive Brain fact log) and `Customer`
//     (CRM identity aggregate) COEXIST and reference CognitiveIdentity later.
//   - Tenancy follows the newest subsystem precedent (Work OS, vk_*): a plain
//     indexed `organizationId` with NO Organization FK. Integrity and org
//     scoping are enforced in the repositories (resolve-within-org, fail to
//     null), which is the platform's mandated tenancy discipline. Cross-model
//     references are plain id columns validated at the repository layer; adding
//     FKs is shared future debt tracked with the other no-FK subsystems.
//   - Additive only. No existing table is renamed, altered, or dropped.
// ===========================================================================

// ---- Cognitive enums ------------------------------------------------------

/// What kind of thing an identity is. Extensible without touching the engine.
enum CognitiveEntityType {
  PERSON
  COMPANY
  HOUSEHOLD
  EMPLOYEE
  CREATOR
  BUYER
  VENDOR
  SOURCE
  CAMPAIGN
  PRODUCT
  SERVICE
  PROPERTY
  LOCATION
  OPPORTUNITY
  DOCUMENT
  CALL
  EMAIL
  MEETING
  WORK_ITEM
  OTHER
}

enum CognitiveIdentityStatus {
  ANONYMOUS
  KNOWN
  ACTIVE
  INACTIVE
  ARCHIVED
}

/// The capacity in which an identity currently participates. An identity is
/// stable and may hold multiple overlapping roles over time.
enum IdentityRoleType {
  ANONYMOUS_VISITOR
  KNOWN_VISITOR
  CONSUMER
  LEAD
  CRM_CONTACT
  BUSINESS_CONTACT
  CREATOR
  EMPLOYEE
  BUYER_CONTACT
  VENDOR_CONTACT
  PARTNER
  CLIENT
  HOUSEHOLD_MEMBER
  OTHER
}

enum IdentityRoleStatus {
  ACTIVE
  INACTIVE
}

enum IdentityEvidenceType {
  AUTHENTICATED_ACCOUNT
  EMAIL
  PHONE
  FIRST_PARTY_COOKIE
  SESSION_ID
  DEVICE_ID
  CALLER_ID
  FORM_SUBMISSION
  EXPLICIT_LINK
  HOUSEHOLD_LINK
  OTHER
}

/// How an identity resolution was reached. Mirrors the processor's resolution
/// precedence (authenticated > confirmed link > verified contact > session).
enum IdentityResolutionMethod {
  AUTHENTICATED
  EXPLICIT_LINK
  VERIFIED_EMAIL
  VERIFIED_PHONE
  SESSION_CONTINUITY
  PSEUDONYMOUS
  HOUSEHOLD
  MANUAL
  OTHER
}

enum IdentityResolutionStatus {
  PROPOSED
  CONFIRMED
  REJECTED
  REVERSED
}

/// What happened. Immutable historical fact type. NEVER a derived conclusion
/// (PRODUCT_CLICKED, not INTERESTED_IN_PURPLE_SHOES).
enum MemoryEventType {
  PAGE_VIEWED
  SEARCH_PERFORMED
  LINK_CLICKED
  FORM_SUBMITTED
  CALL_STARTED
  CALL_COMPLETED
  EMAIL_RECEIVED
  EMAIL_SENT
  SMS_SENT
  SMS_RECEIVED
  PRODUCT_VIEWED
  PRODUCT_CLICKED
  PURCHASE_COMPLETED
  APPOINTMENT_REQUESTED
  BOOKING_COMPLETED
  WORK_CREATED
  WORK_STEP_COMPLETED
  CAMPAIGN_STATUS_CHANGED
  CONSENT_CHANGED
  IDENTITY_LINKED
  IDENTITY_UNLINKED
  OTHER
}

enum MemoryProcessingStatus {
  RECEIVED
  NORMALIZED
  IDENTITY_RESOLVED
  MEMORY_PERSISTED
  STATE_UPDATED
  PUBLISHED
  FAILED
  DEAD_LETTERED
}

/// The epistemic class of an assertion. Declared/observed facts are NOT the
/// same as inferred/predicted beliefs, and must never be collapsed.
enum AssertionClass {
  DECLARED
  OBSERVED
  INFERRED
  PREDICTED
  ORGANIZATIONAL
}

enum AssertionStatus {
  PROPOSED
  ACTIVE
  SUPERSEDED
  REJECTED
  EXPIRED
  REVOKED
}

enum CognitiveValueType {
  STRING
  NUMBER
  BOOLEAN
  DATE
  DATETIME
  IDENTITY_REFERENCE
  JSON
}

enum IdentityRelationshipType {
  MEMBER_OF
  EMPLOYED_BY
  HOUSEHOLD_MEMBER_OF
  CONTACT_FOR
  CREATOR_REPRESENTED_BY
  BUYER_OF
  VENDOR_TO
  PARTNER_OF
  RELATED_TO
  INTRODUCED_BY
  ASSIGNED_TO
  OWNS
  MANAGES
  PARTICIPATED_IN
  OTHER
}

enum RelationshipStatus {
  PROPOSED
  ACTIVE
  INACTIVE
  REVERSED
}

/// The purpose for which data may be retained, accessed, reasoned over, or
/// acted upon. Purpose limitation is enforced deny-by-default.
enum DataPurpose {
  PERSONALIZATION
  SERVICE_DELIVERY
  SALES
  MARKETING
  ANALYTICS
  OPERATIONS
  SUPPORT
  AI_REASONING
  AGGREGATION
  EXTERNAL_ADVERTISING
  OTHER
}

enum DataSensitivity {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  SENSITIVE
  HIGHLY_SENSITIVE
}

enum DataScope {
  INDIVIDUAL
  AGGREGATE
  COMMERCIAL
  OPERATIONAL
  INTERNAL
  PUBLIC
}

/// Lawful basis for holding/using the data. Absence (NONE) denies by default.
enum ConsentBasis {
  CONSENT
  CONTRACT
  LEGITIMATE_INTEREST
  LEGAL_OBLIGATION
  VITAL_INTEREST
  PUBLIC_TASK
  NONE
}

enum GovernancePolicyStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

/// The active-state projection domain. Domain-specific — never one giant blob.
enum ActiveStateDomain {
  COMMERCE
  SERVICE_JOURNEY
  COMMUNICATION
  RELATIONSHIP
  SUPPORT
  COMMERCIAL
  ACCOUNT
  RISK
  OPERATIONAL
  WORK
  CAMPAIGN
  CREATOR
  OTHER
}

enum ActiveStateStatus {
  ACTIVE
  STALE
  EXPIRED
  SUPPRESSED
  REVOKED
}

enum DecayModel {
  NONE
  LINEAR
  EXPONENTIAL
  FIXED_EXPIRATION
  RULE_DEFINED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
  DEAD_LETTERED
}

/// Lifecycle of ONE delivery of a state change to ONE subscriber (Increment 3).
/// Distinct from OutboxStatus: an outbox row fans out to many deliveries, each of
/// which can succeed, retry, or dead-letter independently. SUCCEEDED (not
/// PUBLISHED) is the terminal success — publication is a parent-level conclusion.
enum DeliveryStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  DEAD_LETTERED
}

enum SubscriberType {
  INTERNAL_HANDLER
  BRAIN
  CRM
  WORK_OS
  WEBSITE
  SMS
  EMAIL
  CALLGRID_INTELLIGENCE
  CREATOR_HUB
  DASHBOARD
  OTHER
}

enum SubscriptionDeliveryMode {
  INTERNAL_SYNC
  INTERNAL_ASYNC
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
}

enum HypothesisStatus {
  PROPOSED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  EXPIRED
  SUPERSEDED
}

enum HypothesisGeneratedBy {
  DETERMINISTIC_RULE
  STATISTICAL_MODEL
  AI_MODEL
  HUMAN
}

enum DecisionOutcome {
  SEND
  QUEUE
  SUPPRESS
  ESCALATE
  RECOMMEND
  CREATE_WORK
  NO_ACTION
}

/// Lifecycle of one attempt at one processing stage (Increment 2).
enum ProcessingAttemptStatus {
  PROCESSING
  SUCCEEDED
  FAILED
  DEAD_LETTERED
}

// ---- Cognitive models -----------------------------------------------------

/// WHO or WHAT this is. The stable canonical entity. NOT the CRM Contact —
/// CRM/Customer rows reference this; this never depends on them.
model CognitiveIdentity {
  id             String                  @id @default(cuid())
  organizationId String
  entityType     CognitiveEntityType
  displayName    String?
  canonicalKey   String
  status         CognitiveIdentityStatus @default(ANONYMOUS)
  metadata       Json                    @default("{}")
  archivedAt     DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([organizationId, entityType, canonicalKey])
  @@index([organizationId, entityType])
  @@index([organizationId, status])
  @@map("cognitive_identities")
}

/// The CAPACITY in which an identity participates. Multiple roles may overlap;
/// assigning a role never overwrites the identity's entity type.
model IdentityRole {
  id             String             @id @default(cuid())
  organizationId String
  identityId     String
  roleType       IdentityRoleType
  status         IdentityRoleStatus @default(ACTIVE)
  effectiveFrom  DateTime           @default(now())
  effectiveTo    DateTime?
  sourceEventId  String?
  metadata       Json               @default("{}")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId, identityId])
  @@index([organizationId, roleType, status])
  @@map("identity_roles")
}

/// Evidence that supports an identity's existence/resolution. Raw identifiers
/// are NEVER stored — only a keyed hash (normalizedValueHash).
model IdentityEvidence {
  id                  String               @id @default(cuid())
  organizationId      String
  identityId          String
  evidenceType        IdentityEvidenceType
  normalizedValueHash String
  source              String?
  confidence          Float?
  consentBasis        ConsentBasis         @default(NONE)
  permittedPurposes   DataPurpose[]        @default([])
  observedAt          DateTime             @default(now())
  expiresAt           DateTime?
  revokedAt           DateTime?
  metadata            Json                 @default("{}")
  createdAt           DateTime             @default(now())

  @@index([organizationId, identityId])
  @@index([organizationId, evidenceType, normalizedValueHash])
  @@map("identity_evidence")
}

/// A reversible link asserting two identities are the same/related. Confirmed
/// links are never hard-deleted; reversal is recorded.
model IdentityResolutionLink {
  id                String                   @id @default(cuid())
  organizationId    String
  sourceIdentityId  String
  targetIdentityId  String
  method            IdentityResolutionMethod
  confidence        Float?
  status            IdentityResolutionStatus @default(PROPOSED)
  evidenceSummary   Json                     @default("{}")
  consentBasis      ConsentBasis             @default(NONE)
  permittedPurposes DataPurpose[]            @default([])
  establishedAt     DateTime                 @default(now())
  establishedBy     String?
  reversedAt        DateTime?
  reversedBy        String?
  reversalReason    String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([organizationId, sourceIdentityId])
  @@index([organizationId, targetIdentityId])
  @@index([organizationId, status])
  @@map("identity_resolution_links")
}

/// WHAT HAPPENED. Immutable historical fact. Payload is never overwritten;
/// a derived conclusion belongs in knowledge/state, not here.
model MemoryEvent {
  id                     String                 @id @default(cuid())
  organizationId         String
  eventType              MemoryEventType
  occurredAt             DateTime
  receivedAt             DateTime               @default(now())
  sourceSystem           String
  sourceEventId          String
  actorIdentityId        String?
  subjectIdentityId      String?
  objectIdentityId       String?
  channel                String?
  context                Json                   @default("{}")
  payload                Json                   @default("{}")
  sensitivity            DataSensitivity        @default(INTERNAL)
  consentBasis           ConsentBasis           @default(NONE)
  permittedPurposes      DataPurpose[]          @default([])
  retentionPolicy        String?
  // Aggregate eligibility is stored SEPARATELY from individual-use purposes.
  aggregationEligibility Boolean                @default(false)
  processingStatus       MemoryProcessingStatus @default(RECEIVED)
  createdAt              DateTime               @default(now())

  @@unique([organizationId, sourceSystem, sourceEventId])
  @@index([organizationId, subjectIdentityId, occurredAt])
  @@index([organizationId, eventType, occurredAt])
  @@index([organizationId, processingStatus])
  @@map("memory_events")
}

/// WHAT WE KNOW OR BELIEVE, and why. Declared/observed/inferred/predicted are
/// distinct classes and must not be flattened into "facts".
model KnowledgeAssertion {
  id                String             @id @default(cuid())
  organizationId    String
  subjectIdentityId String
  predicate         String
  valueType         CognitiveValueType @default(STRING)
  value             Json               @default("{}")
  assertionClass    AssertionClass
  status            AssertionStatus    @default(PROPOSED)
  sourceEventId     String?
  sourceIdentityId  String?
  confidence        Float?
  sensitivity       DataSensitivity    @default(INTERNAL)
  scope             DataScope          @default(INDIVIDUAL)
  permittedPurposes DataPurpose[]      @default([])
  consentBasis      ConsentBasis       @default(NONE)
  effectiveFrom     DateTime           @default(now())
  effectiveTo       DateTime?
  lastVerifiedAt    DateTime?
  expiresAt         DateTime?
  supersededById    String?
  ownerIdentityId   String?
  ruleVersion       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([organizationId, subjectIdentityId, predicate, status])
  @@index([organizationId, status, expiresAt])
  @@map("knowledge_assertions")
}

/// HOW two identities are connected. Direction is explicit (from → to); meaning
/// lives in the typed relationshipType, never only in free-text metadata.
model IdentityRelationship {
  id                String                   @id @default(cuid())
  organizationId    String
  fromIdentityId    String
  toIdentityId      String
  relationshipType  IdentityRelationshipType
  status            RelationshipStatus       @default(ACTIVE)
  confidence        Float?
  sourceEventId     String?
  effectiveFrom     DateTime                 @default(now())
  effectiveTo       DateTime?
  permittedPurposes DataPurpose[]            @default([])
  metadata          Json                     @default("{}")
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([organizationId, fromIdentityId, relationshipType])
  @@index([organizationId, toIdentityId, relationshipType])
  @@map("identity_relationships")
}

/// FOR WHAT PURPOSE data may be retained, accessed, aggregated, reasoned over,
/// or disclosed. Evaluation is deny-by-default (see GovernanceEvaluator).
model DataGovernancePolicy {
  id                          String                 @id @default(cuid())
  organizationId              String
  name                        String
  description                 String?
  appliesToEntityType         CognitiveEntityType?
  appliesToEventType          MemoryEventType?
  appliesToAssertionPredicate String?
  sensitivity                 DataSensitivity?
  allowedPurposes             DataPurpose[]          @default([])
  deniedPurposes              DataPurpose[]          @default([])
  allowedChannels             String[]               @default([])
  aggregationAllowed          Boolean                @default(false)
  aiReasoningAllowed          Boolean                @default(false)
  externalDisclosureAllowed   Boolean                @default(false)
  retentionDays               Int?
  requiresConsent             Boolean                @default(false)
  requiresHumanApproval       Boolean                @default(false)
  status                      GovernancePolicyStatus @default(DRAFT)
  version                     Int                    @default(1)
  effectiveFrom               DateTime               @default(now())
  effectiveTo                 DateTime?
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, appliesToEntityType])
  @@index([organizationId, appliesToEventType])
  @@map("data_governance_policies")
}

/// WHAT IS CURRENTLY TRUE — a derived, domain-scoped projection. One row per
/// (org, identity, domain, stateKey). Never a giant per-identity blob.
model ActiveStateRecord {
  id                   String             @id @default(cuid())
  organizationId       String
  identityId           String
  domain               ActiveStateDomain
  stateKey             String
  valueType            CognitiveValueType @default(STRING)
  value                Json               @default("{}")
  confidence           Float?
  status               ActiveStateStatus  @default(ACTIVE)
  sourceEventId        String?
  lastChangedByEventId String?
  calculationRule      String?
  ruleVersion          String?
  effectiveAt          DateTime           @default(now())
  lastEvaluatedAt      DateTime           @default(now())
  expiresAt            DateTime?
  decayModel           DecayModel         @default(NONE)
  scope                DataScope          @default(INDIVIDUAL)
  sensitivity          DataSensitivity    @default(INTERNAL)
  permittedPurposes    DataPurpose[]      @default([])
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([organizationId, identityId, domain, stateKey])
  @@index([organizationId, identityId, domain])
  @@index([organizationId, domain, stateKey, status])
  @@index([organizationId, expiresAt])
  @@map("active_state_records")
}

/// WHY a state holds its value. Every non-static state must have inspectable
/// evidence citing a memory event, knowledge assertion, or relationship.
model ActiveStateEvidence {
  id                   String   @id @default(cuid())
  organizationId       String
  activeStateRecordId  String
  memoryEventId        String?
  knowledgeAssertionId String?
  relationshipId       String?
  weight               Float?
  contribution         Float?
  observedAt           DateTime @default(now())
  createdAt            DateTime @default(now())

  @@index([organizationId, activeStateRecordId])
  @@map("active_state_evidence")
}

/// The audit trail of state changes. Every change to an ActiveStateRecord
/// creates exactly one revision.
model ActiveStateRevision {
  id                  String   @id @default(cuid())
  organizationId      String
  activeStateRecordId String
  previousValue       Json?
  newValue            Json?
  previousConfidence  Float?
  newConfidence       Float?
  changeReason        String?
  sourceEventId       String?
  ruleVersion         String?
  changedAt           DateTime @default(now())
  createdAt           DateTime @default(now())

  @@index([organizationId, activeStateRecordId, changedAt])
  @@map("active_state_revisions")
}

/// Transactional outbox: the state write and its outbox row commit together.
/// Nothing publishes before the transaction commits.
/// What kind of thing an outbox row is about.
///
/// Loop has ONE event bus, not one per subsystem. Active state was the first
/// subject; decisions are the second; work items, memory, knowledge and identity
/// are named here so the next subsystem is a value rather than a second outbox.
/// This is the SUBJECT, never the event — what happened is `eventType`.
enum OutboxSubjectType {
  ACTIVE_STATE
  DECISION
  WORK_ITEM
  MEMORY
  KNOWLEDGE
  IDENTITY
}

model StateChangeOutbox {
  id                    String            @id @default(cuid())
  organizationId        String
  /// What changed. Subscribers switch on this.
  subjectType           OutboxSubjectType @default(ACTIVE_STATE)
  /// The id of the thing that changed, within `subjectType`.
  subjectId             String?
  /// What happened to it, e.g. 'ActiveStateChanged', 'DecisionAssigned'.
  /// Distinct from `subjectType`: one subject emits many event types.
  eventType             String            @default("ActiveStateChanged")
  /// NULLABLE, deliberately. Many decisions describe the BUSINESS rather than a
  /// person — "revenue concentration increased", "profit volatility rose" — and
  /// have no CognitiveIdentity. Fabricating one to satisfy a column would put
  /// non-entities into the identity graph and force every identity query to
  /// filter them out. Populated only when the subject genuinely has an identity.
  identityId            String?
  domain                ActiveStateDomain
  stateKey              String
  changeType            String
  activeStateRecordId   String?
  activeStateRevisionId String?
  payload               Json              @default("{}")
  status                OutboxStatus      @default(PENDING)
  attemptCount          Int               @default(0)
  availableAt           DateTime          @default(now())
  publishedAt           DateTime?
  lastError             String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([organizationId, status, availableAt])
  @@index([organizationId, subjectType, subjectId])
  @@map("state_change_outbox")
}

/// Which internal product/service should react to which state changes.
/// Increment 1 supports INTERNAL_HANDLER delivery only.
model StateChangeSubscription {
  id                String                   @id @default(cuid())
  organizationId    String
  subscriberType    SubscriberType
  subscriberKey     String
  domain            ActiveStateDomain?
  stateKeyPattern   String?
  eventTypes        String[]                 @default([])
  requiredPurposes  DataPurpose[]            @default([])
  minimumConfidence Float?
  deliveryMode      SubscriptionDeliveryMode @default(INTERNAL_SYNC)
  endpointOrHandler String
  // Whether the parent state-change publication must WAIT for this subscriber to
  // succeed. Optional (default) subscribers retry and dead-letter on their own
  // and never block the parent; a required subscriber's dead-letter fails it.
  required          Boolean                  @default(false)
  status            SubscriptionStatus       @default(ACTIVE)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, domain, status])
  @@map("state_change_subscriptions")
}

/// ONE delivery of ONE state change (outbox row) to ONE subscriber. The
/// publisher fans an outbox row out into a delivery per matching subscription and
/// tracks each independently, because subscribers can have different results.
///
/// The (outboxId, subscriptionId) unique is the idempotency + single-claim
/// boundary: at most one delivery row exists per (change, subscriber), it is
/// claimed atomically (PENDING/FAILED → PROCESSING via a conditional update), and
/// re-running the publisher — even concurrently — never double-dispatches.
model StateChangeDelivery {
  id             String         @id @default(cuid())
  organizationId String
  outboxId       String
  subscriptionId String
  subscriberKey  String
  // Stable key derived from (revision, subscription); NOT a timestamp.
  idempotencyKey String
  // Denormalized from the subscription so the parent can be reconciled without a
  // per-delivery join.
  required       Boolean        @default(false)
  status         DeliveryStatus @default(PENDING)
  attemptCount   Int            @default(0)
  availableAt    DateTime       @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  lastError      String?
  resultSummary  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([outboxId, subscriptionId])
  @@index([organizationId, status, availableAt])
  @@index([organizationId, outboxId])
  @@map("state_change_deliveries")
}

/// A pattern/risk/opportunity that APPEARS to exist but is not yet accepted
/// organizational truth. AI-generated hypotheses NEVER auto-accept.
model IntelligenceHypothesis {
  id                    String                @id @default(cuid())
  organizationId        String
  hypothesisType        String
  subjectIdentityId     String?
  title                 String
  summary               String?
  status                HypothesisStatus      @default(PROPOSED)
  confidence            Float?
  evidenceCount         Int                   @default(0)
  supportingWindowStart DateTime?
  supportingWindowEnd   DateTime?
  scope                 DataScope             @default(INDIVIDUAL)
  sensitivity           DataSensitivity       @default(INTERNAL)
  permittedPurposes     DataPurpose[]         @default([])
  generatedBy           HypothesisGeneratedBy
  ruleVersion           String?
  acceptedAt            DateTime?
  acceptedBy            String?
  rejectedAt            DateTime?
  rejectedBy            String?
  supersededById        String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  // The operational threads opened against this belief. A hypothesis is what Loop
  // THINKS is happening; a priority is what the organization is DOING about it.
  // Two axes, deliberately not collapsed: a belief can be accepted as true and
  // still be unassigned, and a priority can be resolved while the belief stands.
  operationalPriorities OperationalPriority[]

  @@index([organizationId, status])
  @@index([organizationId, subjectIdentityId, status])
  @@map("intelligence_hypotheses")
}

/// A decision made from state, policy, and evidence. Records the decision;
/// it does NOT execute external sends in this foundation.
model CognitiveDecision {
  id                 String          @id @default(cuid())
  organizationId     String
  decisionType       String
  subjectIdentityId  String?
  requestedPurpose   DataPurpose?
  channel            String?
  inputStateSnapshot Json            @default("{}")
  policyEvaluation   Json            @default("{}")
  decision           DecisionOutcome
  reason             String?
  confidence         Float?
  requiresApproval   Boolean         @default(false)
  // Stable dedup key derived from (state revision, policy id, policy version) —
  // NEVER a timestamp. Nullable so pre-Increment-3 / manually-recorded decisions
  // carry none; NULLs are distinct in Postgres, so the unique only binds keyed
  // rows. A repeated policy evaluation over the same revision no-ops on P2002.
  idempotencyKey     String?
  approvedAt         DateTime?
  approvedBy         String?
  executedAt         DateTime?
  createdAt          DateTime        @default(now())

  operationalObservations OperationalObservation[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, decisionType])
  @@index([organizationId, subjectIdentityId])
  @@map("cognitive_decisions")
}

/// Per-stage processing attempt for the CognitiveEventProcessor (Increment 2).
/// Makes failures recoverable and dead-letters queryable. A provider request is
/// only reported successful when the accepted pipeline stages are durable; a
/// FAILED/retryable attempt is the record that keeps the work recoverable.
model CognitiveProcessingAttempt {
  id               String                  @id @default(cuid())
  organizationId   String
  memoryEventId    String?
  stage            String
  attemptNumber    Int                     @default(1)
  status           ProcessingAttemptStatus @default(PROCESSING)
  errorCode        String?
  safeErrorMessage String?
  startedAt        DateTime                @default(now())
  completedAt      DateTime?
  nextRetryAt      DateTime?
  createdAt        DateTime                @default(now())

  @@index([organizationId, status, nextRetryAt])
  @@index([organizationId, memoryEventId])
  @@map("cognitive_processing_attempts")
}

// ===========================================================================
// THE DECISION CENTER (platform primitives)
// ---------------------------------------------------------------------------
// The human execution layer of the intelligence engine. This is where a thing
// Loop noticed becomes a thing the organization is doing something about, and
// where the outcome of that work is recorded so future intelligence can be
// measured against it rather than merely asserted.
//
// NAMED FOR WHAT IT BECOMES, not for where it started. This is not "CallGrid's
// review queue" and it is not a marketplace feature: it is the one place in Loop
// where a decision is made, owned and closed, whatever noticed it. CRM,
// Accounting, Marketing, Website, Support, Compliance and Creator intelligence
// are all expected to arrive here, and each of them is a `sourceSystem` value
// rather than a schema change. The identifiers below stay deliberately plain
// (`OperationalPriority`, `OperationalObservation`) because they describe the
// shape of the row; the Decision Center is what the collection of them IS.
//
// GENERIC BY CONSTRUCTION. There is no CallGrid in this section and there must
// never be. CallGrid Intelligence is the FIRST PRODUCER of these primitives, not
// their owner; `sourceSystem` is how a producer names itself. CRM, Accounting,
// Website Intelligence and Creator Intelligence are expected to produce into the
// same two tables, which is the whole reason they are shaped this way. A
// `CallGridPriority` table would have made the second producer a migration.
//
// EVENT-SOURCED, NOT STATE-SOURCED. `OperationalObservation` is an append-only
// log and is the ONLY source of truth. Every lifecycle fact — assigned, watched,
// contacted, resolved, reopened — is an immutable row with an actor and a time.
// The projection columns on `OperationalPriority` (state, owner, reopenCount,
// resolvedAt, outcome…) are a REBUILDABLE CACHE that exists so a lane can be
// queried with an index instead of a full log replay. They are written in the
// same transaction as the observation that causes them, and
// `projectLifecycle()` in @emgloop/shared is the single implementation that
// produces them — proven by test to be reconstructable from the log alone.
// Storing only the current state would destroy the history permanently, and the
// history is the asset: recovery rates, time-to-resolution, intervention
// effectiveness and false-positive rates are all statements about the log.
//
// TENANCY. `organizationId` is a plain indexed column with NO Organization FK,
// matching the newest subsystem precedent (Work OS, vk_*, cognitive) rather than
// introducing a second tenancy pattern for two tables. Isolation is enforced in
// the repositories (resolve-within-org, fail closed to null); the missing FKs are
// existing shared debt tracked with those subsystems, not new debt. The FKs that
// ARE declared here are intra-subsystem integrity: an observation cannot outlive
// the priority it describes.
//
// Additive only. No existing table is renamed, altered, or dropped.
// ===========================================================================

/// The operator's lane. Deliberately the same five states as `QUEUE_STATES` in
/// @emgloop/shared, so the database and the queue UI cannot drift apart.
enum OperationalPriorityState {
  NEEDS_REVIEW
  ASSIGNED
  WATCHING
  RESOLVED
  DISMISSED
}

/// Who caused an observation. There is no AI actor because there is no LLM in
/// this codebase — adding one here would imply a capability that does not exist.
enum OperationalActorType {
  HUMAN
  SYSTEM
}

/// The lifecycle vocabulary.
///
/// Every member is a fact that something in THIS branch can actually produce:
/// either the intelligence engine observed it, or an operator recorded it by
/// hand. Types that only a future integration could emit (EMAIL_SENT,
/// MEETING_BOOKED, WORK_ITEM_CREATED) are deliberately absent — a vocabulary
/// that describes capabilities the product does not have is the same failure as
/// a button that does nothing, just harder to notice.
enum OperationalObservationType {
  // --- Produced by the intelligence engine ---
  /// First time this recurrence key was ever seen.
  SITUATION_DETECTED
  /// Seen again in a later analysis run while still open.
  SITUATION_RESIGHTED
  /// Previously resolved or dismissed, and now detected again.
  REOPENED

  // --- Recorded by an operator ---
  REVIEWED
  /// Execution. Who is doing the work right now; expected to change often.
  ASSIGNED
  REASSIGNED
  UNASSIGNED
  /// Accountability. Who answers for the outcome; expected to change rarely.
  /// Never overloaded with assignment — they answer different questions.
  OWNER_CHANGED
  PRIORITY_CHANGED
  SEVERITY_CHANGED
  EVIDENCE_ADDED
  WATCH_STARTED
  WATCH_STOPPED
  NOTE_ADDED
  CONTACT_ATTEMPTED
  CONTACT_COMPLETED
  AWAITING_RESPONSE
  RESPONSE_RECEIVED
  ESCALATED
  OUTCOME_RECORDED
  RESOLVED
  DISMISSED
}

/// How a priority ended, and — where it can be measured — whether Loop's read of
/// it was any good. This is the learning signal: false-positive rate, recovery
/// rate and time-to-resolution are all derived from these values across the log.
/// UNKNOWN is a first-class answer; an operator who closes something without
/// knowing the outcome must not be forced to invent one.
enum OperationalOutcome {
  RECOVERED
  PARTIALLY_RECOVERED
  NOT_RECOVERED
  NO_ACTION_NEEDED
  FALSE_POSITIVE
  ACCEPTED_RISK
  NOT_ACTIONABLE
  /// The same finding as another decision. Kept distinct from FALSE_POSITIVE:
  /// a duplicate was RIGHT, it was just already known.
  DUPLICATE
  /// Folded into another decision that now carries the work.
  MERGED
  /// Real, and deliberately silenced for a period.
  SUPPRESSED
  /// Closed by time rather than by anyone deciding. Distinguishing this from a
  /// real resolution is what stops the resolution rate flattering itself.
  EXPIRED
  /// Became durable work in another operational system. Deliberately NOT named
  /// after Work OS: the destination is recorded on the observation
  /// (destinationSystem / destinationType / destinationId), because the outcome
  /// answers "what happened" and metadata answers "where did it go".
  CONVERTED_TO_WORK
  UNKNOWN
}

/// A durable thing the organization is working on, opened by an intelligence
/// producer and closed by a human.
///
/// Identity is `(organizationId, sourceSystem, recurrenceKey)`. The recurrence
/// key is derived by the producer from its rule and the entity the finding is
/// about — never from a timestamp — which is precisely what lets the same
/// situation tomorrow land on the same row, and what makes "this is the third
/// time this month" a fact rather than an impression.
model OperationalPriority {
  id             String @id @default(cuid())
  organizationId String

  /// The producer that opened this. 'CALLGRID' today; a plain string so the
  /// second producer is a value, not a migration.
  sourceSystem  String
  /// Stable across analysis runs for the same underlying event.
  recurrenceKey String

  /// What Loop believed when it opened this, if the producer recorded a belief.
  hypothesisId String?

  title   String
  summary String?

  // --- Detection facts, owned by the producer -----------------------------
  firstDetectedAt DateTime
  lastDetectedAt  DateTime
  /// How many analysis runs have seen it. Distinct from reopenCount.
  detectionCount  Int      @default(1)

  /// The canonical platform vocabulary (DECISION_SEVERITIES). Kept as a string so
  /// a new producer is never blocked by a migration; producers map their own
  /// scale in at the boundary, where the mapping is visible.
  severity        String
  /// Operator-settable urgency, independent of producer severity. A CRITICAL
  /// finding somebody has decided to handle next month is both critical and low
  /// priority, and collapsing the two loses that.
  priority        String?
  /// The producer's own confidence in the finding, 0-1. Null when it does not
  /// express one — never defaulted, because a defaulted confidence is a claim.
  confidence      Float?
  impactCents     Int?
  impactLabel     String?
  /// The producer's own handle for the thing this is about, opaque to the
  /// platform: an invoice id, a campaign id, a page path. Never parsed here.
  sourceReference String?
  /// Which build of the producer opened this, so history stays interpretable
  /// after the producer's logic changes.
  producerVersion String?

  // --- Projection of the observation log (CACHE — never edited directly) ---
  // Every column below is reproducible by replaying `observations` through
  // projectLifecycle(). Written only in the same transaction as the observation
  // that causes it. If these ever disagree with the log, the log is right.
  state               OperationalPriorityState @default(NEEDS_REVIEW)
  /// ACCOUNTABILITY. Who answers for this reaching an outcome. Changes rarely.
  ownerUserId         String?
  /// EXECUTION. Who is actively working it, or null. Changes often.
  /// Deliberately separate from ownerUserId: "who owns this problem" and "who is
  /// working it today" are different questions and neither may be derived from
  /// the other, nor from the lane.
  assigneeUserId      String?
  stateChangedAt      DateTime?
  reopenCount         Int                      @default(0)
  resolvedAt          DateTime?
  outcome             OperationalOutcome?
  measuredEffectCents Int?
  observationCount    Int                      @default(0)
  lastObservationAt   DateTime?
  /// Version of the projection implementation that wrote these columns, so a
  /// changed reducer can be detected and the cache rebuilt.
  projectionVersion   String                   @default("v1")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  observations     OperationalObservation[]
  hypothesis       IntelligenceHypothesis?  @relation(fields: [hypothesisId], references: [id])
  DecisionEvidence DecisionEvidence[]

  @@unique([organizationId, sourceSystem, recurrenceKey])
  @@index([organizationId, state])
  @@index([organizationId, ownerUserId, state])
  @@index([organizationId, assigneeUserId, state])
  @@index([organizationId, sourceSystem, lastDetectedAt])
  @@index([hypothesisId])
  @@map("operational_priorities")
}

/// One immutable fact in the life of a priority.
///
/// There is no `updatedAt` and the repository exposes no update path: a row that
/// can be edited is not a log, and every statistic Loop will later derive about
/// its own usefulness depends on this log being trustworthy.
model OperationalObservation {
  id             String  @id @default(cuid())
  organizationId String
  priorityId     String
  /// Set when this observation records a decision that was evaluated through the
  /// cognitive decision layer, so the two views of a decision never fork.
  decisionId     String?

  observationType OperationalObservationType

  /// Identity of the analysis period that produced a DETECTED / RESIGHTED /
  /// REOPENED row, e.g. "yesterday:2026-07-29". Null on everything an operator
  /// records by hand.
  ///
  /// This is what stops the log filling with noise: the Overview is a
  /// server-rendered page that re-runs the engine on every request, so without a
  /// per-period key a refresh would append a sighting, and an operator leaving
  /// the tab open would manufacture hundreds of them. The unique below binds only
  /// rows that carry a key (NULLs are distinct in Postgres), so a duplicate
  /// sighting fails with P2002 and is swallowed as "already recorded this
  /// period" — race-safe without a lock. Same device as
  /// `cognitive_decisions.idempotencyKey`.
  detectionKey String?

  /// When it happened in the world.
  occurredAt DateTime
  /// When Loop learned about it. Equal to occurredAt for anything recorded live;
  /// different whenever an operator records something after the fact.
  recordedAt DateTime @default(now())
  /// Monotonic per priority. Gives the log a deterministic order independent of
  /// timestamp collisions, and the unique below makes concurrent appends fail
  /// loudly (P2002 → retry) instead of silently interleaving.
  sequence   Int

  actorType   OperationalActorType
  actorUserId String?
  /// What produced it: 'callgrid-intelligence', 'operator', …
  source      String

  note     String?
  evidence Json    @default("{}")

  /// Present on ASSIGNED / REASSIGNED / OWNER_CHANGED.
  assignedToUserId    String?
  /// The lane before and after, when this observation moved it. Stored rather
  /// than re-derived so the timeline can answer "what changed" without replaying
  /// the log up to that point.
  previousState       OperationalPriorityState?
  newState            OperationalPriorityState?
  /// Why, in the actor's words. Distinct from `note`: the reason belongs to the
  /// transition, the note belongs to the moment.
  reason              String?
  /// The evidence this observation was recorded against, when it cites some.
  evidenceId          String?
  /// Where a CONVERTED_TO_WORK outcome went. Generic on purpose: the Decision
  /// Engine records that work was created somewhere, never which product.
  destinationSystem   String?
  destinationType     String?
  destinationId       String?
  /// Present on OUTCOME_RECORDED / RESOLVED / DISMISSED.
  outcome             OperationalOutcome?
  /// The measured business effect, when one was actually measured. Never a
  /// forecast and never a recovery estimate — an operator types what happened.
  measuredEffectCents Int?
  measuredEffectBasis String?

  createdAt DateTime @default(now())

  priority      OperationalPriority @relation(fields: [priorityId], references: [id], onDelete: Cascade)
  decision      CognitiveDecision?  @relation(fields: [decisionId], references: [id])
  citedEvidence DecisionEvidence?   @relation(fields: [evidenceId], references: [id])

  @@unique([priorityId, sequence])
  @@unique([priorityId, detectionKey])
  @@index([organizationId, priorityId, sequence])
  @@index([organizationId, observationType, occurredAt])
  @@index([organizationId, actorUserId])
  @@index([decisionId])
  @@index([evidenceId])
  @@map("operational_observations")
}

/// One immutable piece of evidence behind a decision.
///
/// Append-only, like observations: evidence is never edited, replaced or deleted,
/// and `addEvidence` means APPEND. There is no `updatedAt` and no repository
/// method that could change one.
///
/// Why a table rather than a JSON blob on the opening observation (which is what
/// #153 shipped): evidence accumulates. A decision that is re-sighted under a new
/// rule version, or that an operator adds a measurement to, gains evidence over
/// time — and a blob written once cannot express that without being rewritten,
/// which append-only forbids. The blob remains valid for what it was: the opening
/// snapshot.
model DecisionEvidence {
  id             String @id @default(cuid())
  organizationId String
  priorityId     String

  /// Where the value came from: a provider report, a canonical service, a person.
  source    String
  /// What it measures, in the producer's contract vocabulary.
  metricKey String
  /// Which period it describes, in operator language.
  window    String?

  /// What the producer's rule was, and at which version. The key to interpreting
  /// this evidence after the rule has changed.
  ruleId             String?
  ruleVersion        String?
  formulaVersion     String?
  /// The version of the calculation that produced `derivedValue`.
  calculationVersion String?
  /// Which build of the producer emitted it.
  producerVersion    String?

  /// 0-1. Null when the producer does not express one.
  confidence Float?

  /// As the provider expressed it, after normalization, and after our formula.
  /// All three are kept: an argument about a number is almost always an argument
  /// about which of these three somebody was looking at.
  rawValue        Float?
  normalizedValue Float?
  derivedValue    Float?
  /// Fraction of the population that reported the value, when partial.
  completeness    Float?

  entityType String?
  entityId   String?
  entityName String?

  /// What this evidence CANNOT support, carried alongside it forever. Evidence
  /// that keeps its value and loses its caveats is how a hedged claim becomes a
  /// confident one.
  limitations String[] @default([])
  unknowns    String[] @default([])

  /// Producer-specific extras. Opaque to the platform, never parsed here.
  payload Json @default("{}")

  /// When the evidence describes the world.
  observedAt DateTime
  /// When Loop recorded it. No updatedAt: this row is immutable.
  createdAt  DateTime @default(now())

  priority     OperationalPriority      @relation(fields: [priorityId], references: [id], onDelete: Cascade)
  observations OperationalObservation[]

  @@index([organizationId, priorityId, observedAt])
  @@index([organizationId, metricKey])
  @@map("decision_evidence")
}

// ===========================================================================
// COMMERCIAL INTELLIGENCE — STAGE 1: PERFORMANCE OBJECTIVES
// ---------------------------------------------------------------------------
// HUMAN-AUTHORED INTENT. What an organization or a person is trying to
// accomplish. Nothing here observes, scores, ranks, measures or concludes
// anything: this table answers "what matters to this organization or user?"
// and stops there.
//
// WHY IT EXISTS AT ALL. Commercial Intelligence defines a CI Signal as a data
// point tied to a performance objective. Loop had no such concept anywhere —
// not a model, not a type, not a field — so "relevant" had nothing to be
// relevant TO. This is that missing referent, and it is deliberately the only
// new CI concept in Stage 1.
//
// NOT A PERFORMANCE-MANAGEMENT PRODUCT. There is no metric, no target, no unit,
// no baseline, no attainment, no progress and no achievement state, and their
// absence is the design rather than an omission. A `targetValue` column would
// silently commit the platform to a measurement semantics nobody has approved,
// and every later surface would render a number Loop cannot actually compute.
// Knowing WHAT MATTERS precedes calculating whether a number was hit.
//
// SCOPE IS ORGANIZATION OR USER, AND NOTHING ELSE. Team and Division are not
// canonical concepts in Loop — there is no Team model, no Division model and no
// reporting relationship anywhere in this schema. A `TEAM` scope member, or a
// free-text `teamName`, would be a fabricated referent pointing at nothing. The
// enum therefore has exactly two members, and gains a third only when Loop has
// a real entity for it to point at.
//
// SCOPE IS NOT VISIBILITY. `scopeUserId` says whose objective this IS, never
// who may READ it. Access is decided entirely by the existing deny-by-default
// RBAC matrix on the `commercialIntelligence` resource. In particular, the
// MANAGER role is an AUTHORIZATION LEVEL and NOT an organizational fact: it does
// not mean a user manages anyone, has reports, or owns a team, because Loop has
// no relationship that could establish that. No query in this subsystem may
// infer one.
//
// TENANCY. Real foreign keys with defined delete behaviour, deliberately unlike
// the scalar-organizationId-no-FK precedent of Work OS, vk_*, the cognitive
// layer and operational_*. Those carry known orphan-on-delete debt; this table
// is new, so there is no migration cost to being correct from the first row.
// Objectives are tenant data and die with the tenant.
//
// Additive only. No existing table is renamed, altered or dropped.
// ===========================================================================

/// Whose intent this is. Exactly two members, deliberately — see the note above
/// about Team and Division having no canonical referent in Loop today.
enum PerformanceObjectiveScope {
  ORGANIZATION
  USER
}

/// The smallest lifecycle that separates current intent from historical intent.
///
/// There is no ACHIEVED, MISSED, ON_TRACK, AT_RISK or OFF_TRACK member, and
/// there must not be: every one of them is a claim about measured performance,
/// which is exactly the machinery this stage does not build. An objective is
/// either being pursued or it is history.
enum PerformanceObjectiveStatus {
  ACTIVE
  ARCHIVED
}

model PerformanceObjective {
  id             String @id @default(cuid())
  organizationId String

  /// What the organization or person is trying to accomplish, in their words.
  title       String
  description String?

  scope PerformanceObjectiveScope

  /// REQUIRED when scope is USER, and NULL when scope is ORGANIZATION. The
  /// repository enforces both directions and validates same-tenant membership;
  /// the column is nullable because ORGANIZATION-scoped rows genuinely have no
  /// user, and fabricating one to satisfy a NOT NULL would put a false fact in
  /// the table.
  scopeUserId String?

  status PerformanceObjectiveStatus @default(ACTIVE)

  /// The period the intent applies to. `effectiveTo` is NULL for open-ended
  /// intent — distinct from ARCHIVED, which is somebody deciding to stop
  /// pursuing it. One is a date; the other is a decision.
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  /// Authorship. SetNull rather than Cascade: who wrote an objective is
  /// attribution, and it should survive the author leaving the organization —
  /// the same reasoning audit_logs.userId already follows.
  createdByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scopeUser    User?        @relation("PerformanceObjectiveScopedUser", fields: [scopeUserId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("PerformanceObjectiveAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)

  commercialSignals CommercialSignal[]
  measureBindings   ObjectiveMeasureBinding[]
  headlines         Headline[]

  @@index([organizationId, status])
  @@index([organizationId, scope, status])
  @@index([organizationId, scopeUserId])
  @@map("performance_objectives")
}

// ===========================================================================
// COMMERCIAL INTELLIGENCE -- STAGE 2: COMMERCIAL SIGNALS
// ===========================================================================
//
// A fact Loop observed, evaluated RELATIVE TO a Performance Objective, together
// with the reason it may be relevant. That is the whole of the concept and it
// stops there.
//
// THIS IS NOT THE `Signal` MODEL ABOVE. `Signal` (see the CRM section) is
// BEHAVIOURAL enrichment attached to a customer or a conversation -- churn risk,
// intent, journey stage -- written by services/signal-registry.ts and read by
// four repositories. It knows nothing about objectives, and its `confidence`
// answers a different question. The two share an English word and nothing else.
// `Signal` is not renamed, altered, extended, wrapped, aliased or read by
// anything in this section, and this migration emits no DDL against it.
//
// SIGNALS ARE MACHINE-FACING. This table is what Loop noticed, not what a human
// is being asked to look at. Deciding what deserves a person's attention is a
// later stage with its own vocabulary; nothing here ranks, prioritizes, routes,
// notifies or escalates, and no column exists that a feed could sort by.
//
// FACT AND INFERENCE ARE SEPARATED BY COLUMN GROUP, not by convention. Everything
// under "the observed fact" belongs to the producing domain and is restated here
// only so a determination can explain itself; everything under "CI's inference"
// is Loop's own conclusion. The distinction survives in the read contract, which
// nests them (see packages/shared/src/commercial-signal.ts).
//
// CI DOES NOT OWN THE SOURCE RECORD, AND HAS NO FOREIGN KEY TO IT.
// `sourceSystem` + `sourceKey` are opaque handles, never parsed here -- the same
// shape `OperationalPriority.sourceSystem` / `recurrenceKey` uses. A real FK to
// `marketplace_calls` was considered and rejected: that table carries a scalar
// organizationId with no FK and a GLOBALLY unique (provider, externalId), and a
// reference would inherit both defects. The source stays authoritative; CI holds
// a pointer and its own correct tenancy.
//
// POSITIVE DETERMINATIONS ONLY. A row exists because an evaluator concluded an
// observation may matter to an objective. Evaluations that concluded nothing
// write nothing, so the ABSENCE of a row means only that no positive
// determination was recorded -- never that something was examined and dismissed.
// Stage 2 keeps no negative-evaluation history and no query may imply one.
//
// NO SCORE AND NO CONFIDENCE COLUMN. Loop has no approved relevance model, and a
// float here would be a fabricated certainty that every later surface would
// render. The extension point is `relevanceBasis` / `evaluatorId` /
// `evaluatorVersion`.
//
// TENANCY. Real foreign keys with defined delete behaviour, following the
// performance_objectives precedent directly above rather than the
// scalar-organizationId-no-FK debt of Work OS, vk_* and operational_*. Signals
// are tenant data and die with the tenant; they also die with the objective they
// were defined against, because a signal relative to nothing is not a signal.
//
// Additive only. No existing table is renamed, altered or dropped.
// ===========================================================================

model CommercialSignal {
  id                     String @id @default(cuid())
  organizationId         String
  /// The objective this observation was evaluated against. REQUIRED: relevance
  /// is a relation, not a property, and a signal with no referent is a data
  /// point Loop simply noticed.
  performanceObjectiveId String

  // --- The observed fact. Owned by its producing domain. -------------------
  /// The producer that owns this fact ('CALLGRID' today). A plain string so the
  /// second producer is a value rather than a migration.
  sourceSystem       String
  /// Stable identity of the observation WITHIN sourceSystem. Re-observing the
  /// same fact must produce the same key, or idempotency binds to nothing.
  sourceKey          String
  /// The producer's own handle for the subject -- a call id, an invoice number.
  /// Opaque here and NEVER parsed.
  sourceReference    String?
  /// When the fact occurred AT THE SOURCE. Distinct from firstEvaluatedAt (when
  /// CI looked) and createdAt (when the row was written). Three instants, and
  /// collapsing any two of them makes the history unreadable.
  observedAt         DateTime
  /// The fact in one line, in the source's terms. A restatement for explanation,
  /// never a substitute for reading the source.
  observationSummary String

  // --- CI's inference. Never the source's statement. -----------------------
  /// How relevance was established. Held as a string, not an enum, so a new
  /// evaluator is a contract change rather than production DDL -- the same
  /// reasoning OperationalPriority.severity gives.
  relevanceBasis     String
  /// Why this may matter to this objective, in a sentence a human can check.
  relevanceRationale String
  /// WHICH evaluator concluded this and WHICH build of it, so a determination
  /// stays interpretable after the evaluator's logic changes.
  evaluatorId        String
  evaluatorVersion   String

  /// The determination is established once and never rewritten. Re-evaluation
  /// moves the two counters below and touches nothing else -- the same shape
  /// OperationalPriority.firstDetectedAt / lastDetectedAt / detectionCount uses.
  /// A record of what CI believed is worthless if a later run can overwrite it.
  firstEvaluatedAt DateTime @default(now())
  lastEvaluatedAt  DateTime @default(now())
  evaluationCount  Int      @default(1)

  createdAt DateTime @default(now())

  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  performanceObjective PerformanceObjective @relation(fields: [performanceObjectiveId], references: [id], onDelete: Cascade)

  /// Idempotency, scoped to the tenant. Re-running an evaluation over the same
  /// window must not accumulate duplicates. `evaluatorId` is part of the key so
  /// a future evaluator reaching the same observation records its OWN
  /// determination instead of silently overwriting another evaluator's.
  /// `map:` is explicit on both composite indexes because Prisma's generated
  /// names exceed Postgres's 63-character identifier limit and would be
  /// truncated. A truncated name is still deterministic, but it is not READABLE
  /// in a migration file, and this repository hand-writes its migrations.
  @@unique([organizationId, performanceObjectiveId, sourceSystem, sourceKey, evaluatorId], map: "commercial_signals_org_objective_source_evaluator_key")
  @@index([organizationId, observedAt])
  @@index([organizationId, performanceObjectiveId, observedAt], map: "commercial_signals_org_objective_observedAt_idx")
  @@map("commercial_signals")
}

// ===========================================================================
// COMMERCIAL INTELLIGENCE -- STAGE 3 v1: BINDINGS AND HEADLINES
// ---------------------------------------------------------------------------
// Two tables. The first says what an objective means in measurable terms; the
// second records that something measurable about it changed.
//
// A HEADLINE IS NOT A DECISION, AND THIS SECTION MUST NEVER MAKE IT ONE.
// `headlines` carries no ownerUserId, no assigneeUserId, no lane, no state
// machine, no OperationalOutcome, no reopen counter and no observation log. A
// Decision means the organization has judged a matter and is acting; that lives
// in `operational_priorities` and already works. If a future change proposes any
// of those columns here, the thing being modelled is a Decision and the answer is
// to promote into the Decision Center instead. Promotion is Stage 3 v1.1 and no
// column for it exists yet -- naming a field is free, adding a column is a claim.
//
// WHY A SEPARATE BINDING TABLE RATHER THAN COLUMNS ON THE OBJECTIVE. Objective
// text is editable. A binding stored on the objective would be editable with it,
// and every Headline ever produced would silently change meaning -- the same
// reasoning that made Stage 2 reject a projection. Bindings are therefore
// immutable after confirmation and supersede-only, and every Headline records the
// exact binding version it was produced under. One objective may hold many
// bindings; Stage 3 v1 authors one at a time, and multiplicity costs no migration
// because it is already a separate row.
//
// THE POPULATION IS SELECTED, NEVER INFERRED. Members are stored as arrays of the
// provider's own EXTERNAL IDS, per dimension. There is no `vertical` column and
// there must not be: Loop has no vertical concept anywhere, and deriving one by
// parsing provider label text would put industry-specific data in a shared layer
// on top of unnormalized strings. There is no geography model either --
// `callerStates` is an OPTIONAL ADDITIONAL restriction that is empty by default,
// because where a caller physically was and which business motion a campaign
// belongs to are different facts and only a human can say which one an objective
// means.
//
// LABELS ARE DISPLAY, NEVER IDENTITY. `memberLabels` is a display-only map from
// external id to the label as it read at confirmation. Nothing may resolve a
// member through it, and no query may parse it.
//
// NO FOREIGN KEY TO THE SOURCE DOMAIN. `marketplace_calls` carries a scalar
// organizationId with no FK and a GLOBALLY unique (provider, externalId); a
// reference would inherit both defects. External ids are opaque handles here,
// exactly as `CommercialSignal.sourceKey` treats them.
//
// TENANCY. Real foreign keys with defined delete behaviour, following the
// performance_objectives and commercial_signals precedent rather than the
// scalar-organizationId-no-FK debt of Work OS, vk_* and operational_*.
//
// Additive only. No existing table is renamed, altered or dropped.
// ===========================================================================

model ObjectiveMeasureBinding {
  id                     String @id @default(cuid())
  organizationId         String
  performanceObjectiveId String

  /// 1-based, monotonic per objective. Part of the unique below, so two
  /// concurrent confirmations collide loudly rather than interleaving.
  version Int

  /// A member of MEASURE_METRICS. Held as a string, not an enum, so a sixth
  /// measure is a contract change rather than production DDL -- the same
  /// reasoning CommercialSignal.relevanceBasis gives. Validated on the way in
  /// AND on the way out; an unrecognised value fails closed.
  metric String
  /// HIGHER_IS_BETTER | LOWER_IS_BETTER. Human intent about which way is good,
  /// which is the same kind of statement the objective's title already is. This
  /// is NOT a target: no number is being aimed at and none is stored.
  direction String

  /// The confirmed population, as the provider's own external ids. A member the
  /// provider gave a label but no id is NOT selectable -- a population keyed on a
  /// label changes shape the day somebody renames a campaign upstream.
  campaignExternalIds String[] @default([])
  sourceExternalIds   String[] @default([])
  buyerExternalIds    String[] @default([])
  vendorExternalIds   String[] @default([])

  /// OPTIONAL ADDITIONAL RESTRICTION on where the caller physically was. EMPTY
  /// MEANS NO RESTRICTION -- never "unknown", and never a filter matching nothing.
  callerStates String[] @default([])

  /// externalId -> label as it read at confirmation. DISPLAY ONLY. Never parsed,
  /// never used to resolve a member, never an input to anything.
  memberLabels Json @default("{}")

  /// Whose confirmation this is. SetNull rather than Cascade: a binding outlives
  /// the person who confirmed it, the reasoning audit_logs.userId already follows.
  confirmedByUserId String?
  confirmedAt       DateTime @default(now())

  /// The ONLY two fields writable after confirmation, and only once. Everything
  /// else is immutable, and the repository exposes no method that could change it.
  supersededAt          DateTime?
  supersededByBindingId String?   @unique

  createdAt DateTime @default(now())

  organization         Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  performanceObjective PerformanceObjective     @relation(fields: [performanceObjectiveId], references: [id], onDelete: Cascade)
  confirmedBy          User?                    @relation("ObjectiveMeasureBindingConfirmer", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  supersededBy         ObjectiveMeasureBinding? @relation("BindingSupersession", fields: [supersededByBindingId], references: [id], onDelete: SetNull)
  supersedes           ObjectiveMeasureBinding? @relation("BindingSupersession")

  headlines Headline[]

  @@unique([performanceObjectiveId, version], map: "objective_measure_bindings_objective_version_key")
  @@index([organizationId, performanceObjectiveId, supersededAt], map: "objective_measure_bindings_org_objective_active_idx")
  @@map("objective_measure_bindings")
}

/// A measured development in one objective's world.
///
/// Established once and never rewritten. Re-detecting the same development in a
/// later period moves `lastDetectedAt`, `detectionCount` and `lastDetectionKey`
/// and touches nothing else -- the same discipline CommercialSignal keeps, and
/// for the same reason: a record of what Loop measured is worthless if a later
/// run can quietly revise it.
///
/// There is no `updatedAt`, deliberately. The only mutations this row admits are
/// the three sighting counters and the three dismissal fields, each written once
/// per event, and a general modification stamp would imply the rest is editable.
model Headline {
  id                     String @id @default(cuid())
  organizationId         String
  performanceObjectiveId String
  /// The EXACT binding version this was produced under, never the latest one.
  /// Restrict on delete: a Headline whose definition has been deleted cannot be
  /// interpreted, so the binding may not disappear beneath it.
  measureBindingId       String

  /// Identity, and it contains no timestamp. Derived from the binding version,
  /// the metric, the rule and the DIRECTION of the move, so the same development
  /// next period lands on this row rather than creating a second one, and so an
  /// oscillating measure keeps "rose" and "fell" as the two different statements
  /// about the world that they are.
  recurrenceKey String

  ruleId          String
  ruleVersion     String
  producerVersion String

  metric   String
  /// INCREASE | DECREASE.
  movement String
  /// True when the move runs against the objective's stated direction. A fact
  /// about arithmetic and a human's own declared intent -- never a judgement
  /// about whether the business is doing well.
  againstObjective Boolean

  /// The measured development in one line. DISPLAY ONLY, and NO EVALUATOR, RULE
  /// OR FUTURE MEASUREMENT MAY READ IT. It contains Loop's own words as well as
  /// the source's, and Stage 2 shipped a real defect by letting CI-authored text
  /// become the evidence for CI's own conclusion.
  statement String

  // --- The measurement. Every field traces to rows in the source domain. ----
  /// In the metric's own unit: cents for REVENUE, a count for CALL_VOLUME, a
  /// 0-1 fraction for a rate. The unit is derived from `metric` rather than
  /// stored, so a value and its unit can never disagree.
  currentValue       Float?
  priorValue         Float?
  absoluteChange     Float?
  /// A fraction, not a percentage. Null when there was no non-zero baseline.
  percentageChange   Float?
  /// What each value was computed OVER. Stated so a reader can judge the sample
  /// rather than trust the number.
  currentDenominator Int
  priorDenominator   Int
  /// 0-1. Null where the metric has no coverage concept.
  currentCoverage    Float?
  priorCoverage      Float?

  comparisonBasis    String
  currentWindowStart DateTime
  currentWindowEnd   DateTime
  priorWindowStart   DateTime
  priorWindowEnd     DateTime

  /// What this measurement cannot support, and what it leaves open. Carried
  /// alongside the numbers forever: evidence that keeps its value and loses its
  /// caveats is how a hedged claim becomes a confident one.
  limitations String[] @default([])
  unknowns    String[] @default([])

  // --- Observation provenance ----------------------------------------------
  /// WHICH completeness rule governed this row. Stored rather than assumed
  /// because the rule is versioned and will change: without this, a Headline
  /// written under one definition of "observed" is indistinguishable from one
  /// written under another, and neither can be re-audited.
  ///
  /// The default is the literal string "none", which means THIS ROW PREDATES THE
  /// GUARD. It is deliberately not a version number: rows written before
  /// observation was proven were not certified, we cannot know what was observed
  /// when they were made, and backfilling a version onto them would manufacture
  /// exactly the certainty this whole mechanism exists to refuse.
  observationRuleVersion String @default("none")
  /// How many business dates across BOTH windows the rule verified. 0 alongside
  /// "none" says plainly that nothing was verified.
  observedDayCount       Int    @default(0)

  // --- Recurrence. The only counters that move. -----------------------------
  firstDetectedAt DateTime @default(now())
  lastDetectedAt  DateTime @default(now())
  detectionCount  Int      @default(1)
  /// Identity of the completed comparison period most recently recorded. A run
  /// over a period already recorded changes nothing, which is what makes a
  /// server-rendered surface safe to refresh -- the device
  /// `OperationalObservation.detectionKey` already proved.
  lastDetectionKey String

  // --- Attention feedback. NOT an outcome, and NOT a lifecycle. -------------
  /// Dismissal records that a human did not need this. It never reopens, never
  /// suppresses recurrence, and carries no claim about what the organization will
  /// do -- that is Decision semantics and lives in operational_priorities.
  dismissedAt      DateTime?
  dismissedByUserId String?
  /// WRONG (retune detection) | IMMATERIAL (retune attention). Deliberately NOT
  /// OperationalOutcome: that vocabulary answers "did acting work", which nobody
  /// has been asked here.
  dismissalBasis   String?

  createdAt DateTime @default(now())

  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  performanceObjective PerformanceObjective    @relation(fields: [performanceObjectiveId], references: [id], onDelete: Cascade)
  measureBinding       ObjectiveMeasureBinding @relation(fields: [measureBindingId], references: [id], onDelete: Restrict)
  dismissedBy          User?                   @relation("HeadlineDismisser", fields: [dismissedByUserId], references: [id], onDelete: SetNull)

  /// Idempotency, scoped to the tenant. Two runs over the same period, and two
  /// concurrent runs, converge on one row.
  @@unique([organizationId, performanceObjectiveId, recurrenceKey], map: "headlines_org_objective_recurrence_key")
  @@index([organizationId, lastDetectedAt], map: "headlines_org_lastDetectedAt_idx")
  @@index([organizationId, performanceObjectiveId, dismissedAt], map: "headlines_org_objective_dismissed_idx")
  @@map("headlines")
}

// ---------------------------------------------------------------------------
// Provider observation — Commercial Intelligence Stage 3 correctness
// ---------------------------------------------------------------------------

/// One business date, one data stream, and whether Loop actually looked at it.
///
/// WHY THIS TABLE EXISTS. Every other row in this schema is evidence of
/// PRESENCE. An Interaction proves a call arrived; a MarketplaceCall proves one
/// was projected; an integration_event proves a delivery was persisted. None of
/// them is evidence of ABSENCE, so a day with no rows was indistinguishable from
/// a day nobody queried — and in August 2026 a three-day ingestion gap sat inside
/// a Stage 3 comparison window where it would have measured as a commercial
/// collapse. Completeness cannot be derived from what was stored; it has to be
/// asserted by a bounded read against the provider, and that assertion is this
/// row.
///
/// IT NEVER IMPLIES INGESTION. Certifying a day writes exactly one of these and
/// nothing else — no Interaction, no MarketplaceCall, no projection. Observing
/// and recovering are different operations with different authorizations, and
/// folding them together would make it impossible to prove a day was empty
/// without also writing to it.
model ProviderObservationDay {
  id             String @id @default(cuid())
  organizationId String

  /// The sensor that was read, e.g. "callgrid".
  provider String
  /// WHICH STREAM from that provider. Observation is per stream, not per
  /// provider: the calls endpoint being complete says nothing about the auction
  /// reports, and one row covering both would certify what it never read.
  stream   String

  /// The calendar day in `timezone` that this row certifies.
  businessDate DateTime @db.Date
  /// Named, never assumed. A row that does not state its zone cannot be checked
  /// against the window a measurement actually used.
  timezone     String
  /// The UTC interval actually queried. Stored so the row is self-describing and
  /// a reader never has to re-derive a DST boundary to audit it.
  windowStart  DateTime
  windowEnd    DateTime

  /// The outcome, reusing the enum the auction-report ledger already defines.
  /// A second enum meaning the same six things would be the parallel-system
  /// failure mode CLAUDE.md names first. SUCCESS and EMPTY certify; everything
  /// else does not, and the absence of a row certifies nothing at all.
  status     MarketplaceReportRunStatus
  observedAt DateTime
  /// How the assertion was established. "provider-query" is the only value this
  /// version accepts — no human attestation, no inference from adjacent days.
  source     String

  /// What the provider returned. `providerStatedTotal` is the stronger evidence
  /// when the provider offers one, and stays null rather than echoing our count.
  recordsObserved     Int
  providerStatedTotal Int?
  pagesFetched        Int
  pageCap             Int
  /// True when Loop stopped at its own page budget while the provider still had
  /// pages. A truncated read is a lower bound and MUST NOT certify the day.
  truncated           Boolean @default(false)

  /// Why the day did not certify, in plain language. Never a credential, never a
  /// phone number, never a raw payload.
  reason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Tenant-first identity. `integration_events` is uniquely keyed
  /// (provider, externalId) GLOBALLY and cannot be fixed in callers; this table
  /// does not repeat that mistake, so one organization's certification can never
  /// satisfy another's measurement gate.
  @@unique([organizationId, provider, stream, businessDate], name: "observation_day_identity")
  @@index([organizationId, provider, stream, businessDate])
  @@map("provider_observation_days")
}

// ---------------------------------------------------------------------------
// Provider member expectation — Commercial Intelligence Stage 3 correctness
// ---------------------------------------------------------------------------

/// What a human declared about one provider population member, in force over a
/// range of business dates.
///
/// WHY THIS TABLE EXISTS. `provider_observation_days` proves Loop LOOKED at a
/// day, and reconciliation proves what ARRIVED. Neither can say whether a record
/// that never arrived was supposed to. On 2026-08-05 CallGrid held 974 call
/// identities and Loop held 867; 9 of the 107 absences came from campaigns whose
/// webhook was never attached and could not have arrived, and the rest came from
/// campaigns that do deliver. From inside Loop both look identical — a row that
/// is not there. This table is where a person says which is which.
///
/// EFFECTIVE-DATED, BECAUSE THE ALTERNATIVE REWRITES HISTORY. A current-state
/// flag saying "this campaign is connected" would retroactively convert every day
/// before the webhook was attached into a delivery failure nobody could have
/// prevented. A declaration states what was true FROM a date, and a later
/// declaration ends it rather than overwriting it. `effectiveFrom` is INCLUSIVE
/// and `effectiveTo` is EXCLUSIVE, the half-open convention `EffectiveDateRange`
/// already carries in @emgloop/shared; NULL means still in force.
///
/// UNKNOWN IS NOT STORABLE. Three states are declarable — EXPECTED,
/// NOT_CONFIGURED, EXCLUDED. "Nobody has said" is the ABSENCE of a row covering
/// the date, exactly as the absence of an observation row certifies nothing, and
/// it fails closed at the measurement gate. There is no column here that could
/// hold UNKNOWN and no way to write one.
///
/// NEVER INFERRED FROM TRAFFIC. Nothing writes this table because calls appeared,
/// a webhook was configured, or a reconciliation found records. A campaign that
/// broke would silently un-expect itself the moment it stopped delivering, and
/// the alarm would disarm exactly when it was needed. Observed traffic that
/// contradicts a declaration is reported as CAMPAIGN_EXPECTATION_CONTRADICTED and
/// waits for a person.
///
/// AT MOST ONE DECLARATION IS IN FORCE PER MEMBER PER DATE, and that is enforced
/// by the database rather than by callers: a Postgres EXCLUDE constraint over the
/// member key and the half-open date range, added in the migration because Prisma
/// cannot express it. Two declarations covering one date would mean the
/// organization has said two things, and there is no tie-break that would not be
/// invented.
model ProviderMemberExpectation {
  id             String @id @default(cuid())
  organizationId String

  /// The sensor the member belongs to, e.g. "callgrid".
  provider String
  /// WHICH STREAM, following `provider_observation_days`. A campaign attached to
  /// the calls webhook says nothing about the auction report feed, and one row
  /// covering both would declare something nobody checked.
  stream   String

  /// A member of EXPECTATION_DIMENSIONS — 'CAMPAIGN' in v1. Held as a string, not
  /// an enum, so widening the declarable dimensions is a contract change rather
  /// than production DDL, the same reasoning `ObjectiveMeasureBinding.metric`
  /// gives. Validated on the way in AND on the way out; an unrecognised value
  /// fails closed to UNKNOWN.
  memberDimension  String
  /// The provider's own id for the member. IDENTITY IS THE ID, never the label:
  /// a declaration keyed on a label changes meaning the day somebody renames a
  /// campaign upstream.
  memberExternalId String

  /// EXPECTED | NOT_CONFIGURED | EXCLUDED. Held as a string for the same reason
  /// as `memberDimension`, and validated against MEMBER_EXPECTATION_STATES in
  /// both directions. UNKNOWN is not a member of that list and cannot be stored.
  state           String
  /// A member of MEMBER_EXCLUSION_REASONS. REQUIRED when state is EXCLUDED and
  /// NULL otherwise — an exclusion nobody has to justify is a place to hide a
  /// delivery failure.
  exclusionReason String?
  /// A member of MEMBER_EXPECTATION_BASES: how the declaration was arrived at.
  /// PROVIDER_CONFIG_VERIFIED means somebody read the provider's own
  /// configuration; OPERATOR_DECLARED means somebody stated it from knowledge of
  /// the business. Stored so a conclusion drawn from a weaker basis carries that
  /// weakness with it.
  basis           String
  /// Why, in plain language, for the person reading this in six months. Never a
  /// credential, never a phone number, never a raw payload.
  reason          String

  /// INCLUSIVE. The first business date this declaration speaks for.
  effectiveFrom DateTime  @db.Date
  /// EXCLUSIVE, and NULL means open-ended. Written exactly once, by the
  /// declaration that succeeds this one; the state, basis and reason of a closed
  /// row are never touched, so what was true then stays readable.
  effectiveTo   DateTime? @db.Date

  /// Who said it. NULL when no human actor was resolvable — a script, or a
  /// backfill — and never a fabricated identity. SetNull rather than Cascade: a
  /// declaration outlives the person who made it, the reasoning audit_logs.userId
  /// already follows.
  declaredByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  declaredBy   User?        @relation("ProviderMemberExpectationDeclarer", fields: [declaredByUserId], references: [id], onDelete: SetNull)

  /// Resolution reads one member's declarations in effective order. Tenant-first,
  /// like every key in this stage: one organization's declaration must never
  /// resolve another organization's member.
  @@index([organizationId, provider, stream, memberDimension, memberExternalId, effectiveFrom], map: "provider_member_expectations_member_effective_idx")
  @@map("provider_member_expectations")
}
