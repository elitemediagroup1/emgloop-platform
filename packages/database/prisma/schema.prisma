// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id             String    @id @default(cuid())
  organizationId String
  userId         String?
  actorType      ActorType @default(SYSTEM)
  action         String // e.g. "customer.updated", "booking.canceled"
  entityType     String?
  entityId       String?
  before         Json?
  after          Json?
  ip             String?
  userAgent      String?
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  /// One entity's governance history inside one tenant, newest first (slice A2).
  /// PERFORMANCE ONLY, and the organization prefix `(entityType, entityId)` lacks:
  /// the query already filters by organizationId, so the result set is unchanged.
  @@index([organizationId, entityType, entityId, createdAt])
  @@map("audit_logs")
}

// ===========================================================================
// SPRINT 2 — Identity & Operating-System Core
//
// The platform must understand Organizations, Locations, Users, Roles,
// Permissions, Capabilities, AI Employees, and Provider Connections BEFORE it
// understands customers. Additive to the Sprint 1 core; nothing removed/forked.
// Architecture foundation only: no production auth flows, no live integrations.
// ===========================================================================

enum SystemRole {
  OWNER
  ADMIN
  MANAGER
  EMPLOYEE
  AI_EMPLOYEE
  READ_ONLY
  /// Creator Hub (2026-09-22): an external MANAGED CREATOR who signs in to their own seat. Holds
  /// nothing in the capability matrix; the creator route tree and the creator domain services
  /// authorize by the CreatorProfile bound to the login, never by this role's grants.
  CREATOR
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum AuthProviderType {
  PASSWORD
  GOOGLE_OAUTH
  MICROSOFT_OAUTH
  SAML_SSO
  OIDC_SSO
  MAGIC_LINK
}

enum CapabilityStatus {
  AVAILABLE
  ENABLED
  CONFIGURED
  PAUSED
  DISABLED
}

enum PermissionEffect {
  ALLOW
  DENY
}

model OrganizationSettings {
  id             String   @id @default(cuid())
  organizationId String   @unique
  // DEPRECATED (Sprint 2.5): capability enablement is governed solely by
  // OrganizationCapability rows. Retained only for backward-compat migration;
  // MUST NOT be treated as the source of truth. Do not add new reads/writes here.
  modules        Json     @default("{}")
  limits         Json     @default("{}")
  featureFlags   Json     @default("{}")
  defaults       Json     @default("{}")
  metadata       Json     @default("{}")
