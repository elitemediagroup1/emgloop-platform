  BOOKING_COMPLETED
  WORK_CREATED
  WORK_STEP_COMPLETED
  CAMPAIGN_STATUS_CHANGED
  CONSENT_CHANGED
  IDENTITY_LINKED
  IDENTITY_UNLINKED
  OTHER
}

enum MemoryProcessingStatus {
  RECEIVED
  NORMALIZED
  IDENTITY_RESOLVED
  MEMORY_PERSISTED
  STATE_UPDATED
  PUBLISHED
  FAILED
  DEAD_LETTERED
}

/// The epistemic class of an assertion. Declared/observed facts are NOT the
/// same as inferred/predicted beliefs, and must never be collapsed.
enum AssertionClass {
  DECLARED
  OBSERVED
  INFERRED
  PREDICTED
  ORGANIZATIONAL
}

enum AssertionStatus {
  PROPOSED
