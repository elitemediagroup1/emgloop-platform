  updatedAt      DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  aiEmployee AIEmployee? @relation(fields: [aiEmployeeId], references: [id], onDelete: SetNull)

  @@index([organizationId, resource, action])
  @@map("permissions")
}

model Capability {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  description  String?
  category     String?
  dependencies String[] @default([])
  configSchema Json     @default("{}")
  isCore       Boolean  @default(false)
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizations OrganizationCapability[]

  @@map("capabilities")
}

model OrganizationCapability {
  id             String           @id @default(cuid())
  organizationId String
  capabilityId   String
  capabilityKey  String
  status         CapabilityStatus @default(AVAILABLE)
  config         Json             @default("{}")
  enabledAt      DateTime?
  metadata       Json             @default("{}")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  capability   Capability   @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([organizationId, capabilityId])
  @@index([organizationId, status])
  @@map("organization_capabilities")
}

// ---- Sprint 2.5 additions ----

// Canonical interaction taxonomy (the customer-timeline "kind" spine).
// Channel = transport (PHONE/SMS/...). Kind = semantic event type.
enum InteractionKind {
  PHONE_CALL
  SMS
  EMAIL
  CHAT
  RESERVATION
  APPOINTMENT
  ORDER
  FORM_SUBMISSION
  REVIEW
  PAYMENT
  NOTE
  OTHER
}

enum AIEmployeeStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

// Who/what a Permission rule applies to. Deny-by-default still governs the
// resolver; subjectType only narrows which rules are in scope for a subject.
enum PermissionSubjectType {
  HUMAN_USER
  AI_EMPLOYEE
  SYSTEM_PROCESS
}

// ---------------------------------------------------------------------------
// Sprint 4: Real Data Layer — internal domain event log
// ---------------------------------------------------------------------------

// Append-only INTERNAL fact log (e.g. "customer.created", "booking.confirmed").
// This is the platform's own event spine and the seed of the future event bus
// (see docs/EVENT_BUS.md). It is deliberately DISTINCT from IntegrationEvent,
// which records EXTERNAL provider webhooks. Domain events are immutable.
model DomainEvent {
  id             String   @id @default(cuid())
  organizationId String
  name           String // dotted event name, e.g. "booking.confirmed"
  aggregateType  String? // e.g. "customer", "booking"
  aggregateId    String? // id of the aggregate the event concerns
  payload        Json     @default("{}")
  metadata       Json     @default("{}")
  occurredAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, occurredAt])
  @@index([organizationId, name])
  @@index([aggregateType, aggregateId])
  @@map("domain_events")
}

// ===========================================================================
// PR #75 — Work OS Blueprint Runtime v1
// ---------------------------------------------------------------------------
// The first concrete execution runtime for Loop Work OS.
//
// Blueprint      = reusable process template
// BlueprintStage = one step in the template
// WorkInstance   = a real execution of a Blueprint
// WorkStage      = one step of a real execution (copied from BlueprintStage)
// WorkAssignment = ownership record for a stage (audit of who owned what)
// WorkNotification = tells the next owner it is their turn (in-app only)
// WorkComment    = discussion on a work instance / stage
//
// v1 NOTES:
//  - Status / type fields are String scalars (not Prisma enums) to match the
//    exact lowercase vocabulary in the PR #75 spec
//    (active|archived, pending|ready|in_progress|completed|skipped, etc.).
//  - organizationId / userId links are intentional SCALAR ids for v1 (no
//    @relation back-references) to keep this migration purely additive and
//    avoid editing the shared Organization / User core models. Reconciling
//    these into full relations is future work.
// ===========================================================================

model Blueprint {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  description     String?
  status          String   @default("active") // active | archived
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  metadata        Json     @default("{}")

  stages BlueprintStage[]

  @@index([organizationId, status])
  @@map("blueprints")
}

model BlueprintStage {
  id                 String   @id @default(cuid())
  blueprintId        String
  name               String
  description        String?
  position           Int
  defaultOwnerUserId String?
  requiresApproval   Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  metadata           Json     @default("{}")

  blueprint Blueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@index([blueprintId, position])
  @@map("blueprint_stages")
}

model WorkInstance {
  id              String    @id @default(cuid())
  organizationId  String
  blueprintId     String?
  title           String
  description     String?
  status          String    @default("active") // active | completed | cancelled
  currentStageId  String?
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  completedAt     DateTime?
  metadata        Json      @default("{}")

  /// Creator Hub (2026-09-22): two DIFFERENT dated facts. What the requester asked for, and what
  /// the organization committed to. A request is never silently an EMG commitment; the second is
  /// set by an authorized person and every change to it is a fact with an actor and a time.
  requestedReturnAt         DateTime?
  expectedReturnAt          DateTime?
  expectedReturnSetByUserId String?
  expectedReturnSetAt       DateTime?

  stages        WorkStage[]
  notifications WorkNotification[]
  comments      WorkComment[]
  instructions  WorkInstruction[]

  @@index([organizationId, status])
  @@map("work_instances")
}

model WorkStage {
  id                String    @id @default(cuid())
  workInstanceId    String
  blueprintStageId  String?
  name              String
  description       String?
  position          Int
  /// THE EXISTING COLUMN, WITH THREE MORE VALUES. Stage 4 needed to tell active
  /// execution from legitimate waiting from being blocked, all three of which
  /// previously had to be recorded as `in_progress`. The vocabulary is
  /// WORK_EXECUTION_STATES in `@emgloop/shared`; a parallel `executionState`
  /// column beside this one would have been a second status for one thing.
  /// pending | ready | in_progress | waiting_internal | waiting_external |
  /// blocked | completed | skipped
  status            String    @default("pending")
  ownerUserId       String?
  startedAt         DateTime?
  completedAt       DateTime?
  completedByUserId String?

  /// When this obligation first became something its owner could act on.
  /// EXECUTION TRUTH, NOT POLICY: the 12h/24h thresholds are evaluated against
  /// the event log, never stored. Null on every stage created before the
  /// execution foundation existed, and null means unknown -- see the UNKNOWN
  /// member of SLA_STATES, which is why those are not reported as compliant.
  actionableAt DateTime?
  /// When somebody said this should be done by. NULLABLE AND NEVER DEFAULTED: a
  /// defaulted due time is an obligation nobody agreed to, and it would make
  /// every historical row retroactively late.
  dueAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  metadata  Json     @default("{}")

  workInstance WorkInstance     @relation(fields: [workInstanceId], references: [id], onDelete: Cascade)
  events       WorkStageEvent[]
  dependencies WorkDependency[] @relation("DependentStage")

  @@index([ownerUserId, status])
  @@index([workInstanceId, position])
  /// The queue read: everything actionable in one organization, oldest first.
  @@index([status, dueAt])
  @@map("work_stages")
}

/// APPEND-ONLY. What happened to one execution obligation, in order.
///
/// WHY WORK OS NEEDED A LOG. Stage 4 has to answer how long something has been
/// actionable, how long it waited internally versus externally, and how many
/// times its expected time was moved. Every one of those is a duration, and a
/// duration cannot be recovered from a current-state column -- `status` knows
/// where a stage is, never where it has been. The alternative was counter
/// columns, which drift the first time an event is written without them; this
/// repository has made that mistake under other names and the Decision Center
/// already chose the log instead.
///
/// NOTHING HERE IS EVER UPDATED OR DELETED. There is no `updatedAt`, on purpose.
/// A projection is rebuilt from these rows; these rows are not corrected.
///
/// NOT A DELIVERY RECORD. "A reminder fired" is a fact about a notification and
/// belongs to whatever sends one. Reminder and escalation eligibility are
/// derived from these rows on every read, so they cannot go stale and cannot be
/// faked by writing a flag.
model WorkStageEvent {
  id             String @id @default(cuid())
  organizationId String
  workInstanceId String
  workStageId    String

  /// STATE_CHANGED | DUE_SET | DUE_EXTENDED | DEPENDENCY_ADDED |
  /// DEPENDENCY_RESOLVED | NOTE_ADDED -- WORK_EVENT_TYPES in `@emgloop/shared`.
  eventType String

  /// Monotonic per stage. Gives the log a deterministic order independent of
  /// timestamp collisions, and the unique below makes concurrent appends fail
  /// loudly rather than silently interleave. Same device as
  /// `operational_observations.sequence`.
  sequence   Int
  occurredAt DateTime @default(now())

  /// Present on STATE_CHANGED. Both ends are stored rather than re-derived so a
  /// reader can answer "what changed" without replaying the log up to that row.
  fromStatus String?
  toStatus   String?

  /// Present when the change was into a waiting state. A CODE, not prose:
  /// whether the accountability clock pauses must not be decided by wording.
  waitReason           String?
  /// What is being waited on, in the caller's terms. Opaque -- never parsed.
  waitSubject          String?
  /// When it is expected to resolve, IF anybody said. Null is "we do not know",
  /// and it stays null rather than becoming a guess.
  expectedResolutionAt DateTime?

  /// The due time as of this event, on DUE_SET and DUE_EXTENDED. Every move
  /// stays visible: an obligation extended four times is a different fact from
  /// one extended once, and only this log knows.
  dueAt DateTime?

  /// Set on DEPENDENCY_ADDED / DEPENDENCY_RESOLVED.
  dependencyId String?

  /// HUMAN | SYSTEM.
  actorType   String  @default("HUMAN")
  actorUserId String?
  /// What produced it: 'operator', 'work-os', a producer key.
  source      String  @default("work-os")
  note        String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workStage    WorkStage    @relation(fields: [workStageId], references: [id], onDelete: Cascade)

  @@unique([workStageId, sequence])
  @@index([organizationId, workStageId, sequence])
  @@index([organizationId, eventType, occurredAt])
  @@index([dependencyId])
  @@map("work_stage_events")
}

/// One execution obligation cannot proceed until something else resolves.
///
/// NOT STAGE-TO-STAGE WITHIN ONE WORK ITEM. `work_stages.position` already
/// sequences the steps of a work item and `completeWorkStep` already readies the
/// next one. A dependency row restating that would be a second, contradictable
/// representation of a fact the position column owns, and the two would disagree
/// the first time somebody skipped a step.
///
/// COMMERCIAL INTELLIGENCE MAY NOT WRITE THESE. A Case can observe that work is
/// blocked; it cannot declare or resolve a block, because that is a statement
/// about execution and execution is owned here. Resolution comes from an
/// authoritative Work transition or an attributed person, never from an
/// inference elsewhere in the platform.
model WorkDependency {
  id             String @id @default(cuid())
  organizationId String
  /// The obligation that is waiting.
  workStageId    String

  /// WORK_INSTANCE | EXTERNAL_CONDITION -- DEPENDENCY_KINDS in `@emgloop/shared`.
  kind String

  /// Set when `kind` is WORK_INSTANCE. Tenant-checked before it is written: a
  /// dependency can never point at another organization's work.
  dependsOnWorkInstanceId String?
  /// What the condition is, when it is external. In the caller's terms, never
  /// parsed here.
  conditionSubject        String?
  /// The sentence a person reads. Carries no policy meaning.
  description             String

  /// When it is expected to clear, if anybody said. Null is unknown.
  expectedResolutionAt DateTime?

  /// NULL WHILE IT BLOCKS. A resolved dependency keeps its row: deleting it
  /// would erase the reason a piece of work was stalled for a week, which is
  /// exactly the history somebody will want afterwards.
  resolvedAt       DateTime?
  /// DEPENDED_WORK_COMPLETED | CONFIRMED_BY_PERSON | ABANDONED. Never null on a
  /// resolved row: "it stopped blocking" without saying how is not inspectable.
  resolution       String?
  resolvedByUserId String?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workStage    WorkStage    @relation("DependentStage", fields: [workStageId], references: [id], onDelete: Cascade)

  /// The same stage cannot declare the same work dependency twice. NULLs are
  /// distinct in Postgres, so external conditions are not constrained by this --
  /// two different external waits on one stage are legitimate.
  @@unique([workStageId, dependsOnWorkInstanceId], map: "work_dependencies_stage_depends_on_key")
  @@index([organizationId, workStageId, resolvedAt])
  @@index([organizationId, dependsOnWorkInstanceId, resolvedAt], map: "work_dependencies_organizationId_dependsOn_resolvedAt_idx")
  @@map("work_dependencies")
}

model WorkAssignment {
  id               String    @id @default(cuid())
  workInstanceId   String
  workStageId      String
  userId           String
  assignedByUserId String?
  assignedAt       DateTime  @default(now())
  unassignedAt     DateTime?
  metadata         Json      @default("{}")

  @@index([userId])
  @@index([workStageId])
  @@map("work_assignments")
}

model WorkNotification {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  workInstanceId String
  workStageId    String?
  type           String // next_action_ready | assigned | completed | approval_needed
  title          String
  body           String
  readAt         DateTime?
  createdAt      DateTime  @default(now())
  metadata       Json      @default("{}")

  workInstance WorkInstance @relation(fields: [workInstanceId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("work_notifications")
}

model WorkComment {
  id             String   @id @default(cuid())
  workInstanceId String
  workStageId    String?
  userId         String
  body           String
  /// Creator Hub (2026-09-22): `internal` (the default -- EMG only) or `creator_visible`. An
  /// external participant on the work sees only comments written for them, never by inheritance.
  visibility     String   @default("internal")
  createdAt      DateTime @default(now())

  workInstance WorkInstance @relation(fields: [workInstanceId], references: [id], onDelete: Cascade)

  @@index([workInstanceId])
  @@map("work_comments")
}

// ---------------------------------------------------------------------------
// Loop Event Gateway (PR #80)
// Immutable inbound event store for InMyCity producer sites. Additive only:
// no relations to existing core tables, no changes to existing models.
// ---------------------------------------------------------------------------
model LoopEvent {
  id                String   @id @default(cuid())
  eventId           String   @unique // producer-supplied idempotency key, e.g. "evt_..."
  platform          String // producer platform slug, e.g. "artistsinmycity"
  site              String? // originating site, e.g. "artistsinmycity.com"
  eventType         String // dotted event name, e.g. "artist.claimed_profile"
  occurredAt        DateTime // when the event happened on the producer
  receivedAt        DateTime @default(now()) // when Loop received it
  anonymousId       String?
  userId            String?
  sessionId         String?
  pageUrl           String?
  referrer          String?
  payload           Json     @default("{}")
  metadata          Json     @default("{}")
  processed         Boolean  @default(false)
  processingVersion String?
  createdAt         DateTime @default(now())

  @@index([platform, eventType])
  @@index([platform, occurredAt])
  @@index([processed, receivedAt])
  @@index([anonymousId])
  @@index([userId])
  @@map("loop_events")
}

// ===========================================================================
// Verified Knowledge domain (kg.v1)  —  feature/verified-knowledge-service
// ===========================================================================
// A DISTINCT verified fact graph produced/consumed by PetsInMyCity (and future
// EMG properties). This is NOT an embedding / RAG document store: it stores
// verified entities, claims, relationships, sources, provenance and lifecycle
// history with full versioning. Loop persists and returns these objects; the
// producer's Knowledge Delivery Platform (KDP) remains the delivery authority.
//
// Tenancy follows the loop_events precedent: additive tables with plain scalar
// scope columns (platform / property / organizationId) and NO foreign keys to
// existing production tables, so the migration stays purely additive and does
// not require a provisioned Organization row. Scope isolation is enforced at the
// query level by the repository. Stable producer ids are unique WITHIN a scope,
// so the composite uniqueness keys always include (platform, property, ...).

model VerifiedKnowledgeSource {
  id             String    @id @default(cuid())
  // scope
  platform       String
  property       String
  organizationId String?
  // stable producer-supplied id (unique within scope)
  sourceKey      String
  tier           Int?
  kind           String?
  title          String?
  publisher      String?
  url            String?
  accessed       DateTime?
  publishedAt    DateTime?
  quote          String?
  capturedBy     String?
  authorityScope String?
  limitations    String?
  reviewCadence  String?
  attributes     Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  provenance VerifiedKnowledgeProvenance[]

  @@unique([platform, property, sourceKey])
  @@index([platform, property, organizationId])
  @@map("vk_sources")
}

model VerifiedKnowledgeEntity {
  id             String   @id @default(cuid())
  platform       String
  property       String
  organizationId String?
  entityKey      String // stable producer-supplied id
  type           String
  name           String?
  aliases        String[] @default([])
  status         String?
  confidence     String?
  verification   String?
  safetyCritical Boolean  @default(false)
  attributes     Json     @default("{}")
  currentVersion Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  versions VerifiedKnowledgeEntityVersion[]

  @@unique([platform, property, entityKey])
  @@index([platform, property, organizationId])
  @@index([platform, property, type])
  @@map("vk_entities")
}

model VerifiedKnowledgeEntityVersion {
  id             String   @id @default(cuid())
  entityId       String
  version        Int
  type           String
  name           String?
  aliases        String[] @default([])
  status         String?
  confidence     String?
  verification   String?
  safetyCritical Boolean  @default(false)
  attributes     Json     @default("{}")
  importBatchId  String?
  createdAt      DateTime @default(now())

  entity VerifiedKnowledgeEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, version])
  @@index([entityId])
  @@map("vk_entity_versions")
}

model VerifiedKnowledgeClaim {
  id             String    @id @default(cuid())
  platform       String
  property       String
  organizationId String?
  claimKey       String // stable producer-supplied id
  subject        String
  predicate      String
  value          Json      @default("{}")
  confidence     String?
  verification   String?
  safetyCritical Boolean   @default(false)
  validFrom      DateTime?
  validUntil     DateTime?
  expires        DateTime?
  reviewBy       DateTime?
  note           String?
  currentVersion Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  versions VerifiedKnowledgeClaimVersion[]

  @@unique([platform, property, claimKey])
  @@index([platform, property, organizationId, subject])
  @@index([platform, property, subject, predicate])
  @@map("vk_claims")
}

model VerifiedKnowledgeClaimVersion {
  id             String    @id @default(cuid())
  claimId        String
  version        Int
  subject        String
  predicate      String
  value          Json      @default("{}")
  confidence     String?
  verification   String?
  safetyCritical Boolean   @default(false)
  validFrom      DateTime?
  validUntil     DateTime?
  expires        DateTime?
  reviewBy       DateTime?
  note           String?
  importBatchId  String?
  createdAt      DateTime  @default(now())

  claim VerifiedKnowledgeClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@unique([claimId, version])
  @@index([claimId])
  @@map("vk_claim_versions")
}

model VerifiedKnowledgeRelationship {
  id             String   @id @default(cuid())
  platform       String
  property       String
  organizationId String?
  edgeKey        String // stable producer-supplied id
  edge           String // predicate / relation type
  fromKey        String // subject entity key
  toKey          String // object entity key
  confidence     String?
  verification   String?
  attributes     Json     @default("{}")
  currentVersion Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([platform, property, edgeKey])
  @@index([platform, property, organizationId])
  @@index([platform, property, fromKey, edge])
  @@index([platform, property, toKey, edge])
  @@map("vk_relationships")
}

model VerifiedKnowledgeProvenance {
  id             String    @id @default(cuid())
  platform       String
  property       String
  organizationId String?
  sourceId       String
  targetType     String // 'entity' | 'claim' | 'relationship'
  targetKey      String // stable key of the target within scope
  supports       String? // supported field / claim note
  verifiedAt     DateTime?
  verifier       String?
  createdAt      DateTime  @default(now())

  source VerifiedKnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetType, targetKey])
  @@index([platform, property, targetType, targetKey])
  @@map("vk_provenance")
}

model VerifiedKnowledgeLifecycleEvent {
  id             String   @id @default(cuid())
  platform       String
  property       String
  organizationId String?
  objectType     String // 'entity' | 'claim' | 'relationship'
  objectKey      String
  previousStatus String?
  newStatus      String?
  transitionAt   DateTime @default(now())
  actor          String?
  reason         String?
  supportingRef  String?
  importBatchId  String?
  createdAt      DateTime @default(now())

  @@index([platform, property, objectType, objectKey])
  @@map("vk_lifecycle_events")
}

model VerifiedKnowledgeImportBatch {
  id              String   @id @default(cuid())
  platform        String
  property        String
  organizationId  String?
  idempotencyKey  String
  contractVersion String
  payloadHash     String // hash of the batch; same key + different payload => conflict
  status          String   @default("completed") // 'started' | 'completed' | 'failed'
  inserted        Int      @default(0)
  updated         Int      @default(0)
  skipped         Int      @default(0)
  failed          Int      @default(0)
  traceId         String?
  error           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([platform, property, idempotencyKey])
  @@index([platform, property, organizationId])
  @@map("vk_import_batches")
}

// ---------------------------------------------------------------------------
// MarketplaceCall — the canonical, sensor-neutral operational projection of a
// call. This is NOT a CallGrid table: `provider` records which sensor produced
// the row (CallGrid today; Ringba/Invoca/an internal auction tomorrow project
// into the SAME shape). The raw Interaction + Interaction.metadata remain the
// audit record and are never stopped or deleted; this row is the normalized,
// queryable projection the Intelligence layer reads instead of parsing JSON.
//
// Invariants (see docs/CALLGRID_INTELLIGENCE_FOUNDATION.md §Persistence):
//   • Idempotent: unique on (provider, externalId) — re-projecting is an upsert.
//   • Traceable: interactionId + provider + externalId point back to the source.
//   • Money is integer CENTS. Unknown values are null, NEVER defaulted to 0.
//   • Attribution is nullable EXTERNAL-reference ids only — no Buyer/Vendor/
//     Source/Campaign tables are introduced here; canonical entities come later
//     and can be linked without rewriting rows.
//   • sourceOccurredAt (when the call happened) is separate from createdAt/
//     updatedAt (when Loop wrote/updated the projection).
// ---------------------------------------------------------------------------
model MarketplaceCall {
  id             String @id @default(cuid())
  organizationId String

  // Provenance: `provider` is the sensor id (e.g. 'callgrid'). Sensor-neutral.
  provider      String
  externalId    String
  // Traceability back to the raw source event (Interaction.id). Kept as a plain
  // reference (not a formal relation) so the raw Interaction model is untouched.
  interactionId String?

  // When the call actually occurred at the source.
  sourceOccurredAt DateTime

  // Status / disposition. `status` is the canonical event type; `rawStatus` is
  // the provider-native string (preserves BUSY/FAILED/REJECTED distinctions the
  // coarse taxonomy collapses).
  status                   String?
  rawStatus                String?
  endedBy                  String?
  // CONNECTED duration: elapsed time AFTER the call connects, per CallGrid's
  // CallDuration. Renamed from `durationSeconds` (Sprint 37) because that name
  // read as total elapsed time and invited comparison against total-duration
  // figures that measure something else. Billable duration is a THIRD quantity
  // and must never populate this field.
  //
  // @map keeps the physical column so no migration is required.
  connectedDurationSeconds Int?    @map("durationSeconds")

  // Attribution — nullable external-reference ids + best-known labels.
  buyerExternalId       String?
  buyerLabel            String?
  vendorExternalId      String?
  vendorLabel           String?
  sourceExternalId      String?
  sourceLabel           String?
  campaignExternalId    String?
  campaignLabel         String?
  destinationExternalId String?

  // Geo (nullable — only the webhook path supplies these today).
  callerState String?
  callerZip   String?

  // Economics — integer CENTS, null when unmeasured (never 0-defaulted).
  revenueCents Int?
  payoutCents  Int?
  costCents    Int?
  rateCents    Int?

  // Outcome flags — null when the sensor did not say.
  // RENAMED from `qualified` (Sprint 36). CallGrid sends no qualified field of
  // any kind — this is DERIVED by Loop as billable OR converted OR paid, and
  // sat here beside genuine provider flags where it was indistinguishable from
  // one. It means "the call produced a positive commercial outcome", NOT "the
  // call met a qualification standard", and an executive reading a
  // qualification RATE reads it as call quality.
  //
  // @map keeps the physical column `qualified` so this rename needs NO
  // migration: migrations here are manually dispatched, and a code/schema skew
  // would take production down. Rename the column itself in a dedicated
  // migration when one is being deployed anyway.
  monetized Boolean? @map("qualified")
  billable  Boolean?
  converted Boolean?
  paid      Boolean?
  completed Boolean?
  noRoute   Boolean?
  duplicate Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, externalId])
  @@index([organizationId, sourceOccurredAt])
  @@index([organizationId, buyerExternalId])
  @@index([organizationId, vendorExternalId])
  @@index([organizationId, sourceExternalId])
  @@index([organizationId, campaignExternalId])
  @@index([organizationId, status])
  @@index([organizationId, monetized])
  @@index([organizationId, billable])
  @@index([organizationId, converted])
  @@map("marketplace_calls")
}

// ---------------------------------------------------------------------------
// Auction reporting — verified aggregate snapshots
// ---------------------------------------------------------------------------
//
// These three models store CallGrid's AGGREGATE report output. They are not
// event tables. CallGrid exposes no event-level bid or ping record, so a
// `MarketplaceBid` row would be a fabrication with a plausible schema — the
// most expensive kind.
//
// TWO GRAINS, DELIBERATELY UNJOINED
//   MarketplaceBidSourceSnapshot       one row per SOURCE per report window
//   MarketplacePingDestinationSnapshot one row per DESTINATION per report window
//
// Source and destination are opposite sides of the marketplace. There is no
// foreign key between them and no shared identifier, because the provider
// asserts no relationship between them. Nothing may join them by name.
//
// UNITS
//   *Cents    integer cents. Converted once, at the ingestion boundary, by the
//             same `Math.round(dollars * 100)` rule MarketplaceCall uses. The
//             dollars premise is EVIDENCE-GATED per run — see
//             MarketplaceReportRun.moneyUnitEvidence. It is not assumed here.
//   *Percent  percentage POINTS as the provider reported them: 14.473684 means
//             14.473684%. Provider rates are stored verbatim and never
//             recomputed over them; Loop-derived rates are computed at read
//             time from counts, where the denominator is explicit.
//
// NULL vs ZERO
//   Every metric is nullable. Null means the provider did not report the field.
//   Zero means the provider reported zero. Ingestion never coerces one into the
//   other.

/// Aggregate bid statistics for one source over one report window.
/// Combines GET /api/reports/bidStats with GET /api/reports/bidStats/rejections,
/// which share the source grain and are joined on sourceId within one window.
model MarketplaceBidSourceSnapshot {
  id             String @id @default(cuid())
  organizationId String

  /// Sensor id, e.g. 'callgrid'. Sensor-neutral by design.
  provider String

  /// Inclusive window as REQUESTED, in UTC. See reportTimezone.
  reportWindowStart DateTime
  reportWindowEnd   DateTime

  /// The timezone Loop requested the window in. NOT a claim about the timezone
  /// CallGrid buckets in: the three GET report endpoints accept no
  /// reportTimeZone parameter, so provider-side bucketing is UNVERIFIED.
  reportTimezone String

  /// Provider-native source id. The only legitimate join key.
  sourceExternalId String
  sourceName       String?

  // Provenance
  sourceEndpoint      String
  sourcePage          Int?
  sourceTotalPages    Int?
  providerPayloadHash String
  fetchedAt           DateTime

  // Observed bidStats metrics — null means not reported.
  total    Int?
  bids     Int?
  rated    Int?
  won      Int?
  rejected Int?

  totalBidAmountCents Int?
  totalWonAmountCents Int?
  avgBidCents         Int?
  avgWinningBidCents  Int?

  /// Provider-reported rates, in percentage points, stored verbatim.
  winRatePercent    Float?
  bidRatePercent    Float?
  rejectRatePercent Float?

  // Observed bidStats/rejections metrics. Null means the rejections report
  // returned no row for this source — which is NOT the same as zero rejections.
  rejectedDetail   Int?
  callerIdRejected Int?
  closed           Int?
  paused           Int?
  /// Provider `duplicate`. Distinct from duplicateBids; never summed together.
  duplicateCaller  Int?
  duplicateBids    Int?
  failedAcceptance Int?
  failedTagRules   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, provider, reportWindowStart, reportWindowEnd, sourceExternalId], name: "bid_source_snapshot_identity")
  @@index([organizationId, reportWindowStart])
  @@index([organizationId, provider, sourceExternalId])
  @@map("marketplace_bid_source_snapshots")
}

/// Aggregate ping statistics for one destination over one report window.
/// Source: GET /api/reports/pingStats.
model MarketplacePingDestinationSnapshot {
  id             String @id @default(cuid())
  organizationId String

  provider String

  reportWindowStart DateTime
  reportWindowEnd   DateTime
  reportTimezone    String

  destinationExternalId String
  destinationName       String?

  /// The provider's own row date. pingStats buckets rows per day, so a
  /// multi-day window returns one row per destination PER DAY. Ingestion is
  /// single-day; this field is what lets it prove that rather than assume it.
  providerRowDate DateTime?

  // Provenance
  sourceEndpoint      String
  sourcePage          Int?
  sourceTotalPages    Int?
  providerPayloadHash String
  fetchedAt           DateTime

  // Observed metrics — null means not reported.
  accepted         Int?
  agents           Int?
  failedAcceptance Int?
  failedTagRules   Int?
  minRevenue       Int?
  missingAmount    Int?
  invalidNumber    Int?
  durationElapsed  Int?
  pingTimeout      Int?
  apiFailed        Int?
  rateLimited      Int?
  suppressed       Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, provider, reportWindowStart, reportWindowEnd, destinationExternalId], name: "ping_destination_snapshot_identity")
  @@index([organizationId, reportWindowStart])
  @@index([organizationId, provider, destinationExternalId])
  @@map("marketplace_ping_destination_snapshots")
}

/// One ingestion attempt against one report endpoint for one window.
///
/// This exists so that "no rows" can be told apart from "we could not read the
/// report". Without it, a 500 and an empty day are the same absence of data,
/// and the platform would render a provider outage as zero marketplace activity.
model MarketplaceReportRun {
  id             String @id @default(cuid())
  organizationId String

  provider       String
  /// 'bidStats' | 'bidRejections' | 'pingStats'. Not an enum: the set is defined
  /// by what the provider verifiably exposes, and widening it must be a code
  /// change with evidence, not a migration.
  endpoint       String
  /// The HTTP path actually called.
  sourceEndpoint String

  reportWindowStart DateTime
  reportWindowEnd   DateTime
  reportTimezone    String

  status MarketplaceReportRunStatus

  /// Set only for non-success statuses. Never contains the credential.
  errorClassification String?
  errorDetail         String?

  fetchedAt        DateTime
  pagesFetched     Int?
  sourceTotalPages Int?
  rowCount         Int?
  /// True when pagination hit its cap. A truncated report is never reconciled
  /// or aggregated as if it were complete.
  truncated        Boolean  @default(false)

  inserted Int @default(0)
  updated  Int @default(0)
  skipped  Int @default(0)
  failed   Int @default(0)

  /// Provider footerTotals, verbatim. Kept SEPARATE from recomputedTotals so a
  /// provider/Loop disagreement stays visible instead of being averaged away.
  providerFooterTotals Json?
  /// Totals Loop recomputed by summing the rows it stored.
  recomputedTotals     Json?

  /// Whether the dollars premise behind every *Cents column was PROVEN for this
  /// run (a money field carried fractional decimals) or merely consistent with
  /// the data (all integers). Money-based findings are gated on 'proven-dollars'.
  moneyUnitEvidence String?

  /// Row keys actually returned, for drift detection against the observed contract.
  observedRowKeys Json?

  providerPayloadHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, provider, endpoint, reportWindowStart, reportWindowEnd], name: "report_run_identity")
  @@index([organizationId, provider, endpoint, fetchedAt])
  @@map("marketplace_report_runs")
}

enum MarketplaceReportRunStatus {
  /// Every declared page read, rows stored.
  SUCCESS
  /// Read cleanly, provider returned no rows. A real, reportable fact.
  EMPTY
  /// Non-2xx or network failure.
  ENDPOINT_FAILURE
  /// 2xx whose body was not JSON.
  MALFORMED_RESPONSE
  /// 2xx JSON whose shape we could not read. NEVER treated as empty.
  UNKNOWN_ENVELOPE
  /// Some pages read, page budget exhausted before totalPages.
  PARTIAL_PAGINATION
}

// ===========================================================================
// LOOP COGNITIVE ARCHITECTURE FOUNDATION (Increment 1 — canonical domain)
// ---------------------------------------------------------------------------
// The canonical cognitive layer: identity, durable memory, governed knowledge,
// explainable active state, governance policy, transactional outbox,
// subscriptions, intelligence hypotheses, and decision records.
//
// CONSOLIDATION (see docs/architecture/loop-cognitive-architecture.md):
//   - This is NOT a parallel event system. MemoryEvent is the org-scoped
//     canonical durable log; the existing `LoopEvent` gateway is REUSED as the
//     inbound ingress (its idle `processed` flag becomes the consumer seam in
//     Increment 2). `DomainEvent` (Executive Brain fact log) and `Customer`
//     (CRM identity aggregate) COEXIST and reference CognitiveIdentity later.
//   - Tenancy follows the newest subsystem precedent (Work OS, vk_*): a plain
//     indexed `organizationId` with NO Organization FK. Integrity and org
//     scoping are enforced in the repositories (resolve-within-org, fail to
//     null), which is the platform's mandated tenancy discipline. Cross-model
//     references are plain id columns validated at the repository layer; adding
//     FKs is shared future debt tracked with the other no-FK subsystems.
//   - Additive only. No existing table is renamed, altered, or dropped.
// ===========================================================================

// ---- Cognitive enums ------------------------------------------------------

/// What kind of thing an identity is. Extensible without touching the engine.
enum CognitiveEntityType {
  PERSON
  COMPANY
  HOUSEHOLD
  EMPLOYEE
  CREATOR
  BUYER
  VENDOR
  SOURCE
  CAMPAIGN
  PRODUCT
  SERVICE
  PROPERTY
  LOCATION
  OPPORTUNITY
  DOCUMENT
  CALL
  EMAIL
  MEETING
  WORK_ITEM
  OTHER
}

enum CognitiveIdentityStatus {
  ANONYMOUS
  KNOWN
  ACTIVE
  INACTIVE
  ARCHIVED
}

/// The capacity in which an identity currently participates. An identity is
/// stable and may hold multiple overlapping roles over time.
enum IdentityRoleType {
  ANONYMOUS_VISITOR
  KNOWN_VISITOR
  CONSUMER
  LEAD
  CRM_CONTACT
  BUSINESS_CONTACT
  CREATOR
  EMPLOYEE
  BUYER_CONTACT
  VENDOR_CONTACT
  PARTNER
  CLIENT
  HOUSEHOLD_MEMBER
  OTHER
}

enum IdentityRoleStatus {
  ACTIVE
  INACTIVE
}

enum IdentityEvidenceType {
  AUTHENTICATED_ACCOUNT
  EMAIL
  PHONE
  FIRST_PARTY_COOKIE
  SESSION_ID
  DEVICE_ID
  CALLER_ID
  FORM_SUBMISSION
  EXPLICIT_LINK
  HOUSEHOLD_LINK
  OTHER
}

/// How an identity resolution was reached. Mirrors the processor's resolution
/// precedence (authenticated > confirmed link > verified contact > session).
enum IdentityResolutionMethod {
  AUTHENTICATED
  EXPLICIT_LINK
  VERIFIED_EMAIL
  VERIFIED_PHONE
  SESSION_CONTINUITY
  PSEUDONYMOUS
  HOUSEHOLD
