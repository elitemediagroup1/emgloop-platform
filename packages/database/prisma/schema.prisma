}

/// Lifecycle of ONE delivery of a state change to ONE subscriber (Increment 3).
/// Distinct from OutboxStatus: an outbox row fans out to many deliveries, each of
/// which can succeed, retry, or dead-letter independently. SUCCEEDED (not
/// PUBLISHED) is the terminal success — publication is a parent-level conclusion.
enum DeliveryStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  DEAD_LETTERED
}

enum SubscriberType {
  INTERNAL_HANDLER
  BRAIN
  CRM
  WORK_OS
  WEBSITE
  SMS
  EMAIL
  CALLGRID_INTELLIGENCE
  CREATOR_HUB
  DASHBOARD
  OTHER
}

enum SubscriptionDeliveryMode {
  INTERNAL_SYNC
  INTERNAL_ASYNC
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
}

enum HypothesisStatus {
  PROPOSED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  EXPIRED
  SUPERSEDED
}

enum HypothesisGeneratedBy {
  DETERMINISTIC_RULE
  STATISTICAL_MODEL
  AI_MODEL
  HUMAN
}

enum DecisionOutcome {
  SEND
  QUEUE
  SUPPRESS
  ESCALATE
  RECOMMEND
  CREATE_WORK
  NO_ACTION
}

/// Lifecycle of one attempt at one processing stage (Increment 2).
enum ProcessingAttemptStatus {
  PROCESSING
  SUCCEEDED
  FAILED
  DEAD_LETTERED
}

// ---- Cognitive models -----------------------------------------------------

/// WHO or WHAT this is. The stable canonical entity. NOT the CRM Contact —
/// CRM/Customer rows reference this; this never depends on them.
///
/// CRM P0.2d: a PERSON or COMPANY row is a Party record, and the `established*`
/// columns are the provenance that makes one canonical identity. They are written
/// only by `PartyService.establish`, only under `identityResolution:approve`, and
/// they are NULL on every row that existed before -- none of which is established.
model CognitiveIdentity {
  id             String                  @id @default(cuid())
  organizationId String
  entityType     CognitiveEntityType
  displayName    String?
  canonicalKey   String
  status         CognitiveIdentityStatus @default(ANONYMOUS)
  metadata       Json                    @default("{}")
  archivedAt     DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  /// When a governed basis established this Party as canonical identity.
  establishedAt       DateTime?
  /// The User who established it, acting under identityResolution:approve.
  establishedByUserId String?
  /// The basis it was established on. Only governed methods are ever written.
  establishmentBasis  IdentityResolutionMethod?

  /// Supersession: this record was found to be the same Party as another, which
  /// is now canonical. Superseded records stay addressable -- references to them
  /// resolve forward, and nothing that points here is rewritten. NOTHING WRITES
  /// THESE YET; same-Party confirmation is a later, separately governed operation.
  /// A scalar id, like every other identity reference in this schema.
  supersededByIdentityId String?
  supersededAt           DateTime?
  supersededByUserId     String?

  establishedBy User? @relation("CognitiveIdentityEstablisher", fields: [establishedByUserId], references: [id], onDelete: SetNull)
  supersededBy  User? @relation("CognitiveIdentitySuperseder", fields: [supersededByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, entityType, canonicalKey])
  @@index([organizationId, entityType])
  @@index([organizationId, status])
  @@map("cognitive_identities")
}

/// The CAPACITY in which an identity participates. Multiple roles may overlap;
/// assigning a role never overwrites the identity's entity type.
model IdentityRole {
  id             String             @id @default(cuid())
  organizationId String
  identityId     String
  roleType       IdentityRoleType
  status         IdentityRoleStatus @default(ACTIVE)
  effectiveFrom  DateTime           @default(now())
  effectiveTo    DateTime?
  sourceEventId  String?
  metadata       Json               @default("{}")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId, identityId])
  @@index([organizationId, roleType, status])
  @@map("identity_roles")
}

/// Evidence that supports an identity's existence/resolution. Raw identifiers
/// are NEVER stored — only a keyed hash (normalizedValueHash).
model IdentityEvidence {
  id                  String               @id @default(cuid())
  organizationId      String
  identityId          String
  evidenceType        IdentityEvidenceType
  normalizedValueHash String
  source              String?
  confidence          Float?
  consentBasis        ConsentBasis         @default(NONE)
  permittedPurposes   DataPurpose[]        @default([])
  observedAt          DateTime             @default(now())
  expiresAt           DateTime?
  revokedAt           DateTime?
  metadata            Json                 @default("{}")
  createdAt           DateTime             @default(now())

  @@index([organizationId, identityId])
  @@index([organizationId, evidenceType, normalizedValueHash])
  @@map("identity_evidence")
}

/// A reversible link asserting two identities are the same/related. Confirmed
/// links are never hard-deleted; reversal is recorded.
model IdentityResolutionLink {
  id                String                   @id @default(cuid())
  organizationId    String
  sourceIdentityId  String
  targetIdentityId  String
  method            IdentityResolutionMethod
  confidence        Float?
  status            IdentityResolutionStatus @default(PROPOSED)
  evidenceSummary   Json                     @default("{}")
  consentBasis      ConsentBasis             @default(NONE)
  permittedPurposes DataPurpose[]            @default([])
  establishedAt     DateTime                 @default(now())
  establishedBy     String?
  reversedAt        DateTime?
  reversedBy        String?
  reversalReason    String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([organizationId, sourceIdentityId])
  @@index([organizationId, targetIdentityId])
  @@index([organizationId, status])
  @@map("identity_resolution_links")
}

/// WHAT HAPPENED. Immutable historical fact. Payload is never overwritten;
/// a derived conclusion belongs in knowledge/state, not here.
model MemoryEvent {
  id                     String                 @id @default(cuid())
  organizationId         String
  eventType              MemoryEventType
  occurredAt             DateTime
  receivedAt             DateTime               @default(now())
  sourceSystem           String
  sourceEventId          String
  actorIdentityId        String?
  subjectIdentityId      String?
  objectIdentityId       String?
  channel                String?
  context                Json                   @default("{}")
  payload                Json                   @default("{}")
  sensitivity            DataSensitivity        @default(INTERNAL)
  consentBasis           ConsentBasis           @default(NONE)
  permittedPurposes      DataPurpose[]          @default([])
  retentionPolicy        String?
  // Aggregate eligibility is stored SEPARATELY from individual-use purposes.
  aggregationEligibility Boolean                @default(false)
  processingStatus       MemoryProcessingStatus @default(RECEIVED)
  createdAt              DateTime               @default(now())

  @@unique([organizationId, sourceSystem, sourceEventId])
  @@index([organizationId, subjectIdentityId, occurredAt])
  @@index([organizationId, eventType, occurredAt])
  @@index([organizationId, processingStatus])
  @@map("memory_events")
}

/// WHAT WE KNOW OR BELIEVE, and why. Declared/observed/inferred/predicted are
/// distinct classes and must not be flattened into "facts".
model KnowledgeAssertion {
  id                String             @id @default(cuid())
  organizationId    String
  subjectIdentityId String
  predicate         String
  valueType         CognitiveValueType @default(STRING)
  value             Json               @default("{}")
  assertionClass    AssertionClass
  status            AssertionStatus    @default(PROPOSED)
  sourceEventId     String?
  sourceIdentityId  String?
  confidence        Float?
  sensitivity       DataSensitivity    @default(INTERNAL)
  scope             DataScope          @default(INDIVIDUAL)
  permittedPurposes DataPurpose[]      @default([])
  consentBasis      ConsentBasis       @default(NONE)
  effectiveFrom     DateTime           @default(now())
  effectiveTo       DateTime?
  lastVerifiedAt    DateTime?
  expiresAt         DateTime?
  supersededById    String?
  ownerIdentityId   String?
  ruleVersion       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([organizationId, subjectIdentityId, predicate, status])
  @@index([organizationId, status, expiresAt])
  @@map("knowledge_assertions")
}

/// HOW two identities are connected. Direction is explicit (from → to); meaning
/// lives in the typed relationshipType, never only in free-text metadata.
model IdentityRelationship {
  id                String                   @id @default(cuid())
  organizationId    String
  fromIdentityId    String
  toIdentityId      String
  relationshipType  IdentityRelationshipType
  status            RelationshipStatus       @default(ACTIVE)
  confidence        Float?
  sourceEventId     String?
  effectiveFrom     DateTime                 @default(now())
  effectiveTo       DateTime?
  permittedPurposes DataPurpose[]            @default([])
  metadata          Json                     @default("{}")
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([organizationId, fromIdentityId, relationshipType])
  @@index([organizationId, toIdentityId, relationshipType])
  @@map("identity_relationships")
}

/// FOR WHAT PURPOSE data may be retained, accessed, aggregated, reasoned over,
/// or disclosed. Evaluation is deny-by-default (see GovernanceEvaluator).
model DataGovernancePolicy {
  id                          String                 @id @default(cuid())
  organizationId              String
  name                        String
  description                 String?
  appliesToEntityType         CognitiveEntityType?
  appliesToEventType          MemoryEventType?
  appliesToAssertionPredicate String?
  sensitivity                 DataSensitivity?
  allowedPurposes             DataPurpose[]          @default([])
  deniedPurposes              DataPurpose[]          @default([])
  allowedChannels             String[]               @default([])
  aggregationAllowed          Boolean                @default(false)
  aiReasoningAllowed          Boolean                @default(false)
  externalDisclosureAllowed   Boolean                @default(false)
  retentionDays               Int?
  requiresConsent             Boolean                @default(false)
  requiresHumanApproval       Boolean                @default(false)
  status                      GovernancePolicyStatus @default(DRAFT)
  version                     Int                    @default(1)
  effectiveFrom               DateTime               @default(now())
  effectiveTo                 DateTime?
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, appliesToEntityType])
  @@index([organizationId, appliesToEventType])
  @@map("data_governance_policies")
}

/// WHAT IS CURRENTLY TRUE — a derived, domain-scoped projection. One row per
/// (org, identity, domain, stateKey). Never a giant per-identity blob.
model ActiveStateRecord {
  id                   String             @id @default(cuid())
  organizationId       String
  identityId           String
  domain               ActiveStateDomain
  stateKey             String
  valueType            CognitiveValueType @default(STRING)
  value                Json               @default("{}")
  confidence           Float?
  status               ActiveStateStatus  @default(ACTIVE)
  sourceEventId        String?
  lastChangedByEventId String?
  calculationRule      String?
  ruleVersion          String?
  effectiveAt          DateTime           @default(now())
  lastEvaluatedAt      DateTime           @default(now())
  expiresAt            DateTime?
  decayModel           DecayModel         @default(NONE)
  scope                DataScope          @default(INDIVIDUAL)
  sensitivity          DataSensitivity    @default(INTERNAL)
  permittedPurposes    DataPurpose[]      @default([])
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([organizationId, identityId, domain, stateKey])
  @@index([organizationId, identityId, domain])
  @@index([organizationId, domain, stateKey, status])
  @@index([organizationId, expiresAt])
  @@map("active_state_records")
}

/// WHY a state holds its value. Every non-static state must have inspectable
/// evidence citing a memory event, knowledge assertion, or relationship.
model ActiveStateEvidence {
  id                   String   @id @default(cuid())
  organizationId       String
  activeStateRecordId  String
  memoryEventId        String?
  knowledgeAssertionId String?
  relationshipId       String?
  weight               Float?
  contribution         Float?
  observedAt           DateTime @default(now())
  createdAt            DateTime @default(now())

  @@index([organizationId, activeStateRecordId])
  @@map("active_state_evidence")
}

/// The audit trail of state changes. Every change to an ActiveStateRecord
/// creates exactly one revision.
model ActiveStateRevision {
  id                  String   @id @default(cuid())
  organizationId      String
  activeStateRecordId String
  previousValue       Json?
  newValue            Json?
  previousConfidence  Float?
  newConfidence       Float?
  changeReason        String?
  sourceEventId       String?
  ruleVersion         String?
  changedAt           DateTime @default(now())
  createdAt           DateTime @default(now())

  @@index([organizationId, activeStateRecordId, changedAt])
  @@map("active_state_revisions")
}

/// Transactional outbox: the state write and its outbox row commit together.
/// Nothing publishes before the transaction commits.
/// What kind of thing an outbox row is about.
///
/// Loop has ONE event bus, not one per subsystem. Active state was the first
/// subject; decisions are the second; work items, memory, knowledge and identity
/// are named here so the next subsystem is a value rather than a second outbox.
/// This is the SUBJECT, never the event — what happened is `eventType`.
enum OutboxSubjectType {
  ACTIVE_STATE
  DECISION
  WORK_ITEM
  MEMORY
  KNOWLEDGE
  IDENTITY
  /// CRM Relationship and its Participants (slice R2). Subscribers can then filter
  /// commercial-relationship changes without reading every state change.
  RELATIONSHIP
}

model StateChangeOutbox {
  id                    String            @id @default(cuid())
  organizationId        String
  /// What changed. Subscribers switch on this.
  subjectType           OutboxSubjectType @default(ACTIVE_STATE)
  /// The id of the thing that changed, within `subjectType`.
  subjectId             String?
  /// What happened to it, e.g. 'ActiveStateChanged', 'DecisionAssigned'.
  /// Distinct from `subjectType`: one subject emits many event types.
  eventType             String            @default("ActiveStateChanged")
  /// NULLABLE, deliberately. Many decisions describe the BUSINESS rather than a
  /// person — "revenue concentration increased", "profit volatility rose" — and
  /// have no CognitiveIdentity. Fabricating one to satisfy a column would put
  /// non-entities into the identity graph and force every identity query to
  /// filter them out. Populated only when the subject genuinely has an identity.
  identityId            String?
  domain                ActiveStateDomain
  stateKey              String
  changeType            String
  activeStateRecordId   String?
  activeStateRevisionId String?
  payload               Json              @default("{}")
  status                OutboxStatus      @default(PENDING)
  attemptCount          Int               @default(0)
  availableAt           DateTime          @default(now())
  publishedAt           DateTime?
  lastError             String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([organizationId, status, availableAt])
  @@index([organizationId, subjectType, subjectId])
  @@map("state_change_outbox")
}

/// Which internal product/service should react to which state changes.
/// Increment 1 supports INTERNAL_HANDLER delivery only.
model StateChangeSubscription {
  id                String                   @id @default(cuid())
  organizationId    String
  subscriberType    SubscriberType
  subscriberKey     String
  domain            ActiveStateDomain?
  stateKeyPattern   String?
  eventTypes        String[]                 @default([])
  requiredPurposes  DataPurpose[]            @default([])
  minimumConfidence Float?
  deliveryMode      SubscriptionDeliveryMode @default(INTERNAL_SYNC)
  endpointOrHandler String
  // Whether the parent state-change publication must WAIT for this subscriber to
  // succeed. Optional (default) subscribers retry and dead-letter on their own
  // and never block the parent; a required subscriber's dead-letter fails it.
  required          Boolean                  @default(false)
  status            SubscriptionStatus       @default(ACTIVE)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, domain, status])
  @@map("state_change_subscriptions")
}

/// ONE delivery of ONE state change (outbox row) to ONE subscriber. The
/// publisher fans an outbox row out into a delivery per matching subscription and
/// tracks each independently, because subscribers can have different results.
///
/// The (outboxId, subscriptionId) unique is the idempotency + single-claim
/// boundary: at most one delivery row exists per (change, subscriber), it is
/// claimed atomically (PENDING/FAILED → PROCESSING via a conditional update), and
/// re-running the publisher — even concurrently — never double-dispatches.
model StateChangeDelivery {
  id             String         @id @default(cuid())
  organizationId String
  outboxId       String
  subscriptionId String
  subscriberKey  String
  // Stable key derived from (revision, subscription); NOT a timestamp.
  idempotencyKey String
  // Denormalized from the subscription so the parent can be reconciled without a
  // per-delivery join.
  required       Boolean        @default(false)
  status         DeliveryStatus @default(PENDING)
  attemptCount   Int            @default(0)
  availableAt    DateTime       @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  lastError      String?
  resultSummary  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([outboxId, subscriptionId])
  @@index([organizationId, status, availableAt])
  @@index([organizationId, outboxId])
  @@map("state_change_deliveries")
}

/// A pattern/risk/opportunity that APPEARS to exist but is not yet accepted
/// organizational truth. AI-generated hypotheses NEVER auto-accept.
model IntelligenceHypothesis {
  id                    String                @id @default(cuid())
  organizationId        String
  hypothesisType        String
  subjectIdentityId     String?
  title                 String
  summary               String?
  status                HypothesisStatus      @default(PROPOSED)
  confidence            Float?
  evidenceCount         Int                   @default(0)
  supportingWindowStart DateTime?
  supportingWindowEnd   DateTime?
  scope                 DataScope             @default(INDIVIDUAL)
  sensitivity           DataSensitivity       @default(INTERNAL)
  permittedPurposes     DataPurpose[]         @default([])
  generatedBy           HypothesisGeneratedBy
  ruleVersion           String?
  acceptedAt            DateTime?
  acceptedBy            String?
  rejectedAt            DateTime?
  rejectedBy            String?
  supersededById        String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  /// IDENTITY MATCH SUGGESTIONS (D1, approved 2026-09-19). A machine suggestion lives here, on
  /// the one belief authority: created PROPOSED, decided only by an attributed person.
  /// `privateToUserId` is set when the suggestion rests on ONE person's private evidence (their
  /// own mail): only they read or decide it, and it is erased with their work state. NULL is
  /// organization scope, which nothing produces yet.
  privateToUserId     String?
  /// What is suggested, as a stable key: scope, the subject's one-way key and the candidate Party.
  /// A rejection is remembered under it.
  matchKey            String?
  /// One-way fingerprint of the exact evidence records the suggestion rests on. The same evidence
  /// is the same row, so a rejected match is never proposed again from it; new evidence is a new
  /// fingerprint.
  evidenceFingerprint String?
  /// References to that evidence (record ids and one-way keys, never a contact value), with the
  /// method, reason, source and time. The evidence itself stays with the authority that owns it.
  evidenceRefs        Json?
  /// The deciding person's reason. Required to reject (identity record §13).
  decisionReason      String?

  privateTo OrganizationMembership? @relation("IntelligenceHypothesisPrivateTo", fields: [privateToUserId, organizationId], references: [userId, organizationId], onDelete: Cascade)

  // The operational threads opened against this belief. A hypothesis is what Loop
  // THINKS is happening; a priority is what the organization is DOING about it.
  // Two axes, deliberately not collapsed: a belief can be accepted as true and
  // still be unassigned, and a priority can be resolved while the belief stands.
  operationalPriorities OperationalPriority[]

  @@unique([organizationId, matchKey, evidenceFingerprint])
  @@index([organizationId, status])
  @@index([organizationId, subjectIdentityId, status])
  @@index([organizationId, privateToUserId, hypothesisType, status])
  @@map("intelligence_hypotheses")
}

/// A decision made from state, policy, and evidence. Records the decision;
/// it does NOT execute external sends in this foundation.
model CognitiveDecision {
  id                 String          @id @default(cuid())
  organizationId     String
  decisionType       String
  subjectIdentityId  String?
  requestedPurpose   DataPurpose?
  channel            String?
  inputStateSnapshot Json            @default("{}")
  policyEvaluation   Json            @default("{}")
  decision           DecisionOutcome
  reason             String?
  confidence         Float?
  requiresApproval   Boolean         @default(false)
  // Stable dedup key derived from (state revision, policy id, policy version) —
  // NEVER a timestamp. Nullable so pre-Increment-3 / manually-recorded decisions
  // carry none; NULLs are distinct in Postgres, so the unique only binds keyed
  // rows. A repeated policy evaluation over the same revision no-ops on P2002.
  idempotencyKey     String?
  approvedAt         DateTime?
  approvedBy         String?
  executedAt         DateTime?
  createdAt          DateTime        @default(now())

  operationalObservations OperationalObservation[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, decisionType])
  @@index([organizationId, subjectIdentityId])
  @@map("cognitive_decisions")
}

/// Per-stage processing attempt for the CognitiveEventProcessor (Increment 2).
/// Makes failures recoverable and dead-letters queryable. A provider request is
/// only reported successful when the accepted pipeline stages are durable; a
/// FAILED/retryable attempt is the record that keeps the work recoverable.
model CognitiveProcessingAttempt {
  id               String                  @id @default(cuid())
  organizationId   String
  memoryEventId    String?
  stage            String
  attemptNumber    Int                     @default(1)
  status           ProcessingAttemptStatus @default(PROCESSING)
  errorCode        String?
  safeErrorMessage String?
  startedAt        DateTime                @default(now())
  completedAt      DateTime?
  nextRetryAt      DateTime?
  createdAt        DateTime                @default(now())

  @@index([organizationId, status, nextRetryAt])
  @@index([organizationId, memoryEventId])
  @@map("cognitive_processing_attempts")
}

// ===========================================================================
// THE DECISION CENTER (platform primitives)
// ---------------------------------------------------------------------------
// The human execution layer of the intelligence engine. This is where a thing
// Loop noticed becomes a thing the organization is doing something about, and
// where the outcome of that work is recorded so future intelligence can be
// measured against it rather than merely asserted.
//
// NAMED FOR WHAT IT BECOMES, not for where it started. This is not "CallGrid's
// review queue" and it is not a marketplace feature: it is the one place in Loop
// where a decision is made, owned and closed, whatever noticed it. CRM,
// Accounting, Marketing, Website, Support, Compliance and Creator intelligence
// are all expected to arrive here, and each of them is a `sourceSystem` value
// rather than a schema change. The identifiers below stay deliberately plain
// (`OperationalPriority`, `OperationalObservation`) because they describe the
// shape of the row; the Decision Center is what the collection of them IS.
//
// GENERIC BY CONSTRUCTION. There is no CallGrid in this section and there must
// never be. CallGrid Intelligence is the FIRST PRODUCER of these primitives, not
// their owner; `sourceSystem` is how a producer names itself. CRM, Accounting,
// Website Intelligence and Creator Intelligence are expected to produce into the
// same two tables, which is the whole reason they are shaped this way. A
// `CallGridPriority` table would have made the second producer a migration.
//
// EVENT-SOURCED, NOT STATE-SOURCED. `OperationalObservation` is an append-only
// log and is the ONLY source of truth. Every lifecycle fact — assigned, watched,
// contacted, resolved, reopened — is an immutable row with an actor and a time.
// The projection columns on `OperationalPriority` (state, owner, reopenCount,
// resolvedAt, outcome…) are a REBUILDABLE CACHE that exists so a lane can be
// queried with an index instead of a full log replay. They are written in the
// same transaction as the observation that causes them, and
// `projectLifecycle()` in @emgloop/shared is the single implementation that
// produces them — proven by test to be reconstructable from the log alone.
// Storing only the current state would destroy the history permanently, and the
// history is the asset: recovery rates, time-to-resolution, intervention
// effectiveness and false-positive rates are all statements about the log.
//
// TENANCY. `organizationId` is a plain indexed column with NO Organization FK,
// matching the newest subsystem precedent (Work OS, vk_*, cognitive) rather than
// introducing a second tenancy pattern for two tables. Isolation is enforced in
// the repositories (resolve-within-org, fail closed to null); the missing FKs are
// existing shared debt tracked with those subsystems, not new debt. The FKs that
// ARE declared here are intra-subsystem integrity: an observation cannot outlive
// the priority it describes.
//
// Additive only. No existing table is renamed, altered, or dropped.
// ===========================================================================

/// The operator's lane. Deliberately the same five states as `QUEUE_STATES` in
/// @emgloop/shared, so the database and the queue UI cannot drift apart.
enum OperationalPriorityState {
  NEEDS_REVIEW
  ASSIGNED
  WATCHING
  RESOLVED
  DISMISSED
}

/// Who caused an observation. There is no AI actor because there is no LLM in
/// this codebase — adding one here would imply a capability that does not exist.
enum OperationalActorType {
  HUMAN
  SYSTEM
}

/// The lifecycle vocabulary.
///
/// Every member is a fact that something in THIS branch can actually produce:
/// either the intelligence engine observed it, or an operator recorded it by
/// hand. Types that only a future integration could emit (EMAIL_SENT,
/// MEETING_BOOKED, WORK_ITEM_CREATED) are deliberately absent — a vocabulary
/// that describes capabilities the product does not have is the same failure as
/// a button that does nothing, just harder to notice.
enum OperationalObservationType {
  // --- Produced by the intelligence engine ---
  /// First time this recurrence key was ever seen.
  SITUATION_DETECTED
  /// Seen again in a later analysis run while still open.
  SITUATION_RESIGHTED
  /// Previously resolved or dismissed, and now detected again.
  REOPENED

  // --- Recorded by an operator ---
  REVIEWED
  /// Execution. Who is doing the work right now; expected to change often.
  ASSIGNED
  REASSIGNED
  UNASSIGNED
  /// Accountability. Who answers for the outcome; expected to change rarely.
  /// Never overloaded with assignment — they answer different questions.
  OWNER_CHANGED
  PRIORITY_CHANGED
  SEVERITY_CHANGED
  EVIDENCE_ADDED
  WATCH_STARTED
  WATCH_STOPPED
  NOTE_ADDED
  CONTACT_ATTEMPTED
  CONTACT_COMPLETED
  AWAITING_RESPONSE
  RESPONSE_RECEIVED
  ESCALATED
  OUTCOME_RECORDED
  RESOLVED
  DISMISSED

  // --- Stage 4 investigation vocabulary ---
  // Ten meanings Stage 4 recorded on NOTE_ADDED and REVIEWED, separated only by
  // an exact English sentence in `reason`. Behaviour that depends on prose stops
  // working the day somebody fixes a typo, and no test notices. Appended, never
  // interleaved: a Postgres enum value cannot be reordered without recreating
  // the type, and nothing here sorts by it.
  //
  // `packages/shared/src/case-observation.ts` owns the vocabulary, the
  // human-readable line each one writes, and the compatibility with rows that
  // predate these members. Pre-migration history is NOT rewritten.
  /// A person authorized a Headline for organizational investigation.
  INVESTIGATION_AUTHORIZED
  /// Loop attached an analytical claim to the investigation.
  FINDING_RECORDED
  /// A newer claim replaced the previous one. The previous one is kept in full.
  FINDING_SUPERSEDED
  /// Loop recorded the options that could be taken. Options, not decisions.
  RECOMMENDATION_RECORDED
  /// A person chose to pursue one option. Distinct from approving it, which is
  /// `cognitive_decisions.approvedAt`, and distinct from having done it.
  RECOMMENDATION_SELECTED
  /// A person set an option aside. What Loop proposed is kept unchanged.
  RECOMMENDATION_DISMISSED
  /// A person proposed their own revision of an option. The machine's version
  /// is kept alongside it, never overwritten.
  RECOMMENDATION_REVISED
  /// Somebody was asked to contribute. NOT an assignment and NOT work.
  PARTICIPANT_ADDED
  /// What somebody is being asked for changed. The previous ask is kept.
  PARTICIPANT_CHANGED
  /// Somebody was released from the investigation.
  PARTICIPANT_RELEASED

  // --- Stage 4 monitoring ---
  // MONITORING_STARTED enters the WATCHING lane that already exists. Two types
  // entering one lane is not a parallel lifecycle: ASSIGNED and REASSIGNED both
  // set an assignee today.
  /// Loop is watching whether something held. The plan -- condition, baseline,
  /// success and failure criteria, window, evidence requirement -- is on the
  /// row's `evidence` payload, declared BEFORE the answer is known.
  MONITORING_STARTED
  /// The plan was corrected. The previous plan stays on the log in full.
  MONITORING_REVISED
  /// A verdict was reached. Does NOT close the Case: a verdict is what was
  /// observed, and deciding the investigation is finished is a separate act.
  MONITORING_CONCLUDED

  // --- Stage 5 evidence context ---
  /// What LATER evidence says about EARLIER evidence: corroborated, contradicted,
  /// clarified, corrected, or no longer applicable.
  ///
  /// ADDITIVE, NEVER AN EDIT. Evidence is immutable, so the relation is a fact
  /// about two rows rather than a change to either: the original sentence or
  /// number stays exactly as recorded, and a reader sees both plus the order they
  /// were learned in. The relation is on `evidenceRelation`, the evidence being
  /// given context is `evidenceId`, and the evidence doing it is
  /// `relatedEvidenceId`.
  EVIDENCE_CONTEXT_RECORDED
}

/// How a priority ended, and — where it can be measured — whether Loop's read of
/// it was any good. This is the learning signal: false-positive rate, recovery
/// rate and time-to-resolution are all derived from these values across the log.
/// UNKNOWN is a first-class answer; an operator who closes something without
/// knowing the outcome must not be forced to invent one.
enum OperationalOutcome {
  RECOVERED
  PARTIALLY_RECOVERED
  NOT_RECOVERED
  NO_ACTION_NEEDED
  FALSE_POSITIVE
  ACCEPTED_RISK
  NOT_ACTIONABLE
  /// The same finding as another decision. Kept distinct from FALSE_POSITIVE:
  /// a duplicate was RIGHT, it was just already known.
  DUPLICATE
  /// Folded into another decision that now carries the work.
  MERGED
  /// Real, and deliberately silenced for a period.
  SUPPRESSED
  /// Closed by time rather than by anyone deciding. Distinguishing this from a
  /// real resolution is what stops the resolution rate flattering itself.
  EXPIRED
  /// Became durable work in another operational system. Deliberately NOT named
  /// after Work OS: the destination is recorded on the observation
  /// (destinationSystem / destinationType / destinationId), because the outcome
  /// answers "what happened" and metadata answers "where did it go".
  CONVERTED_TO_WORK
  UNKNOWN
}

/// A durable thing the organization is working on, opened by an intelligence
/// producer and closed by a human.
///
/// Identity is `(organizationId, sourceSystem, recurrenceKey)`. The recurrence
/// key is derived by the producer from its rule and the entity the finding is
/// about — never from a timestamp — which is precisely what lets the same
/// situation tomorrow land on the same row, and what makes "this is the third
/// time this month" a fact rather than an impression.
model OperationalPriority {
  id             String @id @default(cuid())
  organizationId String

  /// The producer that opened this. 'CALLGRID' today; a plain string so the
  /// second producer is a value, not a migration.
  sourceSystem  String
  /// Stable across analysis runs for the same underlying event.
  recurrenceKey String

  /// What Loop believed when it opened this, if the producer recorded a belief.
  hypothesisId String?

  title   String
  summary String?

  // --- Detection facts, owned by the producer -----------------------------
  firstDetectedAt DateTime
  lastDetectedAt  DateTime
  /// How many analysis runs have seen it. Distinct from reopenCount.
  detectionCount  Int      @default(1)

  /// The canonical platform vocabulary (DECISION_SEVERITIES). Kept as a string so
  /// a new producer is never blocked by a migration; producers map their own
  /// scale in at the boundary, where the mapping is visible.
  severity        String
  /// Operator-settable urgency, independent of producer severity. A CRITICAL
  /// finding somebody has decided to handle next month is both critical and low
  /// priority, and collapsing the two loses that.
  priority        String?
  /// The producer's own confidence in the finding, 0-1. Null when it does not
  /// express one — never defaulted, because a defaulted confidence is a claim.
  confidence      Float?
  impactCents     Int?
  impactLabel     String?
  /// The producer's own handle for the thing this is about, opaque to the
  /// platform: an invoice id, a campaign id, a page path. Never parsed here.
  sourceReference String?
  /// Which build of the producer opened this, so history stays interpretable
  /// after the producer's logic changes.
  producerVersion String?

  // --- Projection of the observation log (CACHE — never edited directly) ---
  // Every column below is reproducible by replaying `observations` through
  // projectLifecycle(). Written only in the same transaction as the observation
  // that causes it. If these ever disagree with the log, the log is right.
  state               OperationalPriorityState @default(NEEDS_REVIEW)
  /// ACCOUNTABILITY. Who answers for this reaching an outcome. Changes rarely.
  ownerUserId         String?
  /// EXECUTION. Who is actively working it, or null. Changes often.
  /// Deliberately separate from ownerUserId: "who owns this problem" and "who is
  /// working it today" are different questions and neither may be derived from
  /// the other, nor from the lane.
  assigneeUserId      String?
  stateChangedAt      DateTime?
  reopenCount         Int                      @default(0)
  resolvedAt          DateTime?
  outcome             OperationalOutcome?
  measuredEffectCents Int?
  observationCount    Int                      @default(0)
  lastObservationAt   DateTime?
  /// Version of the projection implementation that wrote these columns, so a
  /// changed reducer can be detected and the cache rebuilt.
  projectionVersion   String                   @default("v1")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  observations     OperationalObservation[]
  hypothesis       IntelligenceHypothesis?  @relation(fields: [hypothesisId], references: [id])
  DecisionEvidence DecisionEvidence[]
  /// Who is involved and what each of them is being asked for. Distinct from
  /// ownerUserId and assigneeUserId, which answer accountability and execution;
  /// a real investigation routinely needs a third person for a third reason.
  participants     CaseParticipant[]

  @@unique([organizationId, sourceSystem, recurrenceKey])
  @@index([organizationId, state])
  @@index([organizationId, ownerUserId, state])
  @@index([organizationId, assigneeUserId, state])
  @@index([organizationId, sourceSystem, lastDetectedAt])
  @@index([hypothesisId])
  @@map("operational_priorities")
}

/// One person's involvement in one investigation, and what is being asked of them.
///
/// WHY THIS TABLE EXISTS. `operational_priorities` already carries `ownerUserId`
/// (accountability) and `assigneeUserId` (execution) and was right to keep those
/// apart. But an investigation routinely needs three people for three different
/// reasons -- one to decide, one to change something technical, one to handle the
/// counterparty -- and two columns cannot hold that. Rotating `assigneeUserId`
/// between them would destroy the only answer to "who is working this".
///
/// IT IS NOT A TASK, AND THE ABSENCES ARE THE CONTRACT. No due date. No
/// dependency. No SLA. No blocked state. No completion. Every one of those is an
/// execution obligation, and Work OS owns execution: a Case that carried its own
/// task status beside a Work status would be a second answer to "is it done", and
/// the copy is always the one that goes stale. Where an investigation does become
/// work, the Case REFERENCES it through the destination columns
/// `operational_observations` already carries on a CONVERTED_TO_WORK outcome.
///
/// NO STATUS COLUMN EITHER. Presence and release, following `work_assignments`'
/// own `assignedAt` / `unassignedAt` convention rather than inventing an enum
/// beside it -- a participant is active exactly when `releasedAt` is null, which
/// cannot disagree with itself the way a status maintained beside a timestamp can.
///
/// ONE ROW PER PERSON PER CONTRIBUTION PER CASE. The unique makes re-adding
/// somebody idempotent rather than accumulating duplicates, and lets one person
/// hold two genuinely different roles on one investigation. The HISTORY of being
/// added, changed and released lives on the Case's append-only observation log,
/// which is where every other lifecycle fact in the Decision Center already lives.
model CaseParticipant {
  id             String @id @default(cuid())
  organizationId String
  /// The investigation. Named `priorityId` to match the column every other
  /// Decision Center table uses for it -- the product word is Case, the
  /// architecture's word is OperationalPriority, and renaming it here would give
  /// one producer's vocabulary to producer-neutral machinery.
  priorityId     String
  userId         String

  /// What this person is being asked to contribute. One of CASE_CONTRIBUTIONS,
  /// kept as a String so a new kind of contribution is a value rather than a
  /// migration -- the same stance `operational_priorities.severity` takes.
  contribution String
  /// WHY this person, in the words of whoever asked. Required: a participant with
  /// no stated request is a name on a list, and the next person to open the case
  /// has to guess what was wanted.
  request      String

  /// Attribution. SetNull rather than Cascade, following audit_logs and
  /// performance_objectives: who asked is attribution and should survive them
  /// leaving the organization.
  addedByUserId    String?
  addedAt          DateTime  @default(now())
  releasedAt       DateTime?
  releasedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  priority     OperationalPriority @relation(fields: [priorityId], references: [id], onDelete: Cascade)
  user         User                @relation("CaseParticipantUser", fields: [userId], references: [id], onDelete: Cascade)
  addedBy      User?               @relation("CaseParticipantAdder", fields: [addedByUserId], references: [id], onDelete: SetNull)
  releasedBy   User?               @relation("CaseParticipantReleaser", fields: [releasedByUserId], references: [id], onDelete: SetNull)

  @@unique([priorityId, userId, contribution], map: "case_participants_priority_user_contribution_key")
  @@index([organizationId, priorityId], map: "case_participants_org_priority_idx")
  @@index([organizationId, userId, releasedAt], map: "case_participants_org_user_released_idx")
  @@map("case_participants")
}

/// One immutable fact in the life of a priority.
///
/// There is no `updatedAt` and the repository exposes no update path: a row that
/// can be edited is not a log, and every statistic Loop will later derive about
/// its own usefulness depends on this log being trustworthy.
model OperationalObservation {
  id             String  @id @default(cuid())
  organizationId String
  priorityId     String
  /// Set when this observation records a decision that was evaluated through the
  /// cognitive decision layer, so the two views of a decision never fork.
  decisionId     String?

  observationType OperationalObservationType

  /// Identity of the analysis period that produced a DETECTED / RESIGHTED /
  /// REOPENED row, e.g. "yesterday:2026-07-29". Null on everything an operator
  /// records by hand.
  ///
  /// This is what stops the log filling with noise: the Overview is a
  /// server-rendered page that re-runs the engine on every request, so without a
  /// per-period key a refresh would append a sighting, and an operator leaving
  /// the tab open would manufacture hundreds of them. The unique below binds only
  /// rows that carry a key (NULLs are distinct in Postgres), so a duplicate
  /// sighting fails with P2002 and is swallowed as "already recorded this
  /// period" — race-safe without a lock. Same device as
  /// `cognitive_decisions.idempotencyKey`.
  detectionKey String?

  /// When it happened in the world.
  occurredAt DateTime
  /// When Loop learned about it. Equal to occurredAt for anything recorded live;
  /// different whenever an operator records something after the fact.
  recordedAt DateTime @default(now())
  /// Monotonic per priority. Gives the log a deterministic order independent of
  /// timestamp collisions, and the unique below makes concurrent appends fail
  /// loudly (P2002 → retry) instead of silently interleaving.
  sequence   Int

  actorType   OperationalActorType
  actorUserId String?
  /// What produced it: 'callgrid-intelligence', 'operator', …
  source      String

  note     String?
  evidence Json    @default("{}")

  /// Present on ASSIGNED / REASSIGNED / OWNER_CHANGED.
  assignedToUserId    String?
  /// The lane before and after, when this observation moved it. Stored rather
  /// than re-derived so the timeline can answer "what changed" without replaying
  /// the log up to that point.
  previousState       OperationalPriorityState?
  newState            OperationalPriorityState?
  /// Why, in the actor's words. Distinct from `note`: the reason belongs to the
  /// transition, the note belongs to the moment.
  reason              String?
  /// The evidence this observation was recorded against, when it cites some.
  /// On EVIDENCE_CONTEXT_RECORDED this is the evidence BEING GIVEN CONTEXT.
  evidenceId          String?
  /// The evidence DOING it, on EVIDENCE_CONTEXT_RECORDED. Null on every other
  /// type, and null on a relation that names a change in the world rather than a
  /// second record (NO_LONGER_APPLICABLE).
  relatedEvidenceId   String?
  /// Which governed relation, one of EVIDENCE_RELATIONS in @emgloop/shared.
  ///
  /// A STRING, NOT AN ENUM, following `severity` and `evidenceClass`: the set is
  /// deliberately small today and the reasoning for each member lives in the
  /// shared contract, where a reader can see what it does and does not establish.
  /// An ungoverned value is skipped by the projection rather than rendered.
  evidenceRelation    String?
  /// Where a CONVERTED_TO_WORK outcome went. Generic on purpose: the Decision
  /// Engine records that work was created somewhere, never which product.
  destinationSystem   String?
  destinationType     String?
  destinationId       String?
  /// Present on OUTCOME_RECORDED / RESOLVED / DISMISSED.
  outcome             OperationalOutcome?
  /// The measured business effect, when one was actually measured. Never a
  /// forecast and never a recovery estimate — an operator types what happened.
  measuredEffectCents Int?
  measuredEffectBasis String?

  createdAt DateTime @default(now())

  priority        OperationalPriority @relation(fields: [priorityId], references: [id], onDelete: Cascade)
  decision        CognitiveDecision?  @relation(fields: [decisionId], references: [id])
  citedEvidence   DecisionEvidence?   @relation(fields: [evidenceId], references: [id])
  contextEvidence DecisionEvidence?   @relation("ObservationContextEvidence", fields: [relatedEvidenceId], references: [id])

  @@unique([priorityId, sequence])
  @@unique([priorityId, detectionKey])
  @@index([organizationId, priorityId, sequence])
  @@index([organizationId, observationType, occurredAt])
  @@index([organizationId, actorUserId])
  @@index([decisionId])
  @@index([evidenceId])
  @@index([relatedEvidenceId])
  @@map("operational_observations")
}

/// One immutable piece of evidence behind a decision.
///
/// Append-only, like observations: evidence is never edited, replaced or deleted,
/// and `addEvidence` means APPEND. There is no `updatedAt` and no repository
/// method that could change one.
///
/// Why a table rather than a JSON blob on the opening observation (which is what
/// #153 shipped): evidence accumulates. A decision that is re-sighted under a new
/// rule version, or that an operator adds a measurement to, gains evidence over
/// time — and a blob written once cannot express that without being rewritten,
/// which append-only forbids. The blob remains valid for what it was: the opening
/// snapshot.
model DecisionEvidence {
  id             String @id @default(cuid())
  organizationId String
  priorityId     String

  /// Where the value came from: a provider report, a canonical service, a person.
  source String

  /// HOW THIS EVIDENCE ENTERED LOOP. One of EVIDENCE_CLASSES in @emgloop/shared:
  /// MEASURED (a producer measured it) or HUMAN_REPORTED (a person wrote it down).
  ///
  /// IT RANKS NOTHING. The class carries no trust, authority, reliability or
  /// confidence -- those belong to a claim plus its evidence, differ by claim
  /// type, and are decided by standards that do not exist yet. What it decides
  /// here is which columns below mean anything, and whether the Stage 3
  /// measurement gate may read the row at all.
  ///
  /// A STRING, NOT AN ENUM, following `severity` and `case_participants.contribution`:
  /// the vocabulary is deliberately narrow today and will gain members (a
  /// deterministic diagnostic, a document, an outcome), and each one should be a
  /// value rather than a migration.
  ///
  /// THE DEFAULT IS A STATEMENT OF FACT, NOT A GUESS. Until people could report
  /// evidence there was exactly one way for a row to arrive, so every existing
  /// row IS measured and nothing had to be backfilled to make that true.
  evidenceClass String @default("MEASURED")

  /// What a person reported, in their own words, exactly as they wrote it.
  ///
  /// NEVER NORMALIZED AND NEVER REWRITTEN. A surface may shorten it on screen;
  /// this column keeps what was actually said, because on a human report that
  /// sentence IS the evidence. Null on anything a producer measured.
  statement String?

  /// Who reported it. Null for measured evidence.
  ///
  /// SET FROM THE SESSION ACTOR BY THE ENGINE, never from a caller's field, so
  /// there is no path through which one person can file a report under another's
  /// name. SetNull rather than Cascade, following `case_participants.addedByUserId`:
  /// who said something is attribution, and it should survive them leaving.
  reportedByUserId String?

  /// What it measures, in the producer's contract vocabulary.
  ///
  /// NULLABLE SINCE STAGE 5 PR 1's SUCCESSOR: a human report is not necessarily
  /// about a metric. There is deliberately no sentinel -- a `HUMAN_REPORT` or
  /// `MANUAL` metric key would be a measured referent nothing measures, and every
  /// grouping by metric would carry a fake member for ever.
  metricKey String?
  /// Which period it describes, in operator language.
  window    String?

  /// What the producer's rule was, and at which version. The key to interpreting
  /// this evidence after the rule has changed.
  ruleId             String?
  ruleVersion        String?
  formulaVersion     String?
  /// The version of the calculation that produced `derivedValue`.
  calculationVersion String?
  /// Which build of the producer emitted it.
  producerVersion    String?

  /// 0-1. Null when the producer does not express one.
  confidence Float?

  /// As the provider expressed it, after normalization, and after our formula.
  /// All three are kept: an argument about a number is almost always an argument
  /// about which of these three somebody was looking at.
  rawValue        Float?
  normalizedValue Float?
  derivedValue    Float?
  /// Fraction of the population that reported the value, when partial.
  completeness    Float?

  entityType String?
  entityId   String?
  entityName String?

  /// What this evidence CANNOT support, carried alongside it forever. Evidence
  /// that keeps its value and loses its caveats is how a hedged claim becomes a
  /// confident one.
  limitations String[] @default([])
  unknowns    String[] @default([])

  /// Producer-specific extras. Opaque to the platform, never parsed here.
  payload Json @default("{}")

  /// When the evidence describes the world.
  observedAt DateTime
  /// When Loop recorded it. No updatedAt: this row is immutable.
  createdAt  DateTime @default(now())

  priority     OperationalPriority      @relation(fields: [priorityId], references: [id], onDelete: Cascade)
  reportedBy   User?                    @relation("DecisionEvidenceReporter", fields: [reportedByUserId], references: [id], onDelete: SetNull)
  observations OperationalObservation[]
  /// Observations in which THIS row is the evidence giving context to another.
  contextFor   OperationalObservation[] @relation("ObservationContextEvidence")

  @@index([organizationId, priorityId, observedAt])
  @@index([organizationId, metricKey])
  @@index([organizationId, reportedByUserId])
  @@map("decision_evidence")
}

// ===========================================================================
// COMMERCIAL INTELLIGENCE — STAGE 1: PERFORMANCE OBJECTIVES
// ---------------------------------------------------------------------------
// HUMAN-AUTHORED INTENT. What an organization or a person is trying to
// accomplish. Nothing here observes, scores, ranks, measures or concludes
// anything: this table answers "what matters to this organization or user?"
// and stops there.
//
// WHY IT EXISTS AT ALL. Commercial Intelligence defines a CI Signal as a data
// point tied to a performance objective. Loop had no such concept anywhere —
// not a model, not a type, not a field — so "relevant" had nothing to be
// relevant TO. This is that missing referent, and it is deliberately the only
// new CI concept in Stage 1.
//
// NOT A PERFORMANCE-MANAGEMENT PRODUCT. There is no metric, no target, no unit,
// no baseline, no attainment, no progress and no achievement state, and their
// absence is the design rather than an omission. A `targetValue` column would
// silently commit the platform to a measurement semantics nobody has approved,
// and every later surface would render a number Loop cannot actually compute.
// Knowing WHAT MATTERS precedes calculating whether a number was hit.
//
// SCOPE IS ORGANIZATION OR USER, AND NOTHING ELSE. Team and Division are not
// canonical concepts in Loop — there is no Team model, no Division model and no
// reporting relationship anywhere in this schema. A `TEAM` scope member, or a
// free-text `teamName`, would be a fabricated referent pointing at nothing. The
// enum therefore has exactly two members, and gains a third only when Loop has
// a real entity for it to point at.
//
// SCOPE IS NOT VISIBILITY. `scopeUserId` says whose objective this IS, never
// who may READ it. Access is decided entirely by the existing deny-by-default
// RBAC matrix on the `commercialIntelligence` resource. In particular, the
// MANAGER role is an AUTHORIZATION LEVEL and NOT an organizational fact: it does
// not mean a user manages anyone, has reports, or owns a team, because Loop has
// no relationship that could establish that. No query in this subsystem may
// infer one.
//
// TENANCY. Real foreign keys with defined delete behaviour, deliberately unlike
// the scalar-organizationId-no-FK precedent of Work OS, vk_*, the cognitive
// layer and operational_*. Those carry known orphan-on-delete debt; this table
// is new, so there is no migration cost to being correct from the first row.
// Objectives are tenant data and die with the tenant.
//
// Additive only. No existing table is renamed, altered or dropped.
// ===========================================================================

/// Whose intent this is. Exactly two members, deliberately — see the note above
/// about Team and Division having no canonical referent in Loop today.
enum PerformanceObjectiveScope {
  ORGANIZATION
  USER
}

/// The smallest lifecycle that separates current intent from historical intent.
///
/// There is no ACHIEVED, MISSED, ON_TRACK, AT_RISK or OFF_TRACK member, and
/// there must not be: every one of them is a claim about measured performance,
/// which is exactly the machinery this stage does not build. An objective is
/// either being pursued or it is history.
enum PerformanceObjectiveStatus {
  ACTIVE
  ARCHIVED
}

model PerformanceObjective {
  id             String @id @default(cuid())
  organizationId String

  /// What the organization or person is trying to accomplish, in their words.
  title       String
  description String?

  scope PerformanceObjectiveScope

  /// REQUIRED when scope is USER, and NULL when scope is ORGANIZATION. The
  /// repository enforces both directions and validates same-tenant membership;
  /// the column is nullable because ORGANIZATION-scoped rows genuinely have no
  /// user, and fabricating one to satisfy a NOT NULL would put a false fact in
  /// the table.
  scopeUserId String?

  status PerformanceObjectiveStatus @default(ACTIVE)

  /// The period the intent applies to. `effectiveTo` is NULL for open-ended
  /// intent — distinct from ARCHIVED, which is somebody deciding to stop
  /// pursuing it. One is a date; the other is a decision.
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  /// Authorship. SetNull rather than Cascade: who wrote an objective is
  /// attribution, and it should survive the author leaving the organization —
  /// the same reasoning audit_logs.userId already follows.
  createdByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scopeUser    User?        @relation("PerformanceObjectiveScopedUser", fields: [scopeUserId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("PerformanceObjectiveAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)

  commercialSignals CommercialSignal[]
  measureBindings   ObjectiveMeasureBinding[]
  headlines         Headline[]

  @@index([organizationId, status])
  @@index([organizationId, scope, status])
  @@index([organizationId, scopeUserId])
  @@map("performance_objectives")
}

// ===========================================================================
// COMMERCIAL INTELLIGENCE -- STAGE 2: COMMERCIAL SIGNALS
// ===========================================================================
//
// A fact Loop observed, evaluated RELATIVE TO a Performance Objective, together
// with the reason it may be relevant. That is the whole of the concept and it
// stops there.
//
// THIS IS NOT THE `Signal` MODEL ABOVE. `Signal` (see the CRM section) is
// BEHAVIOURAL enrichment attached to a customer or a conversation -- churn risk,
// intent, journey stage -- written by services/signal-registry.ts and read by
// four repositories. It knows nothing about objectives, and its `confidence`
// answers a different question. The two share an English word and nothing else.
// `Signal` is not renamed, altered, extended, wrapped, aliased or read by
// anything in this section, and this migration emits no DDL against it.
//
// SIGNALS ARE MACHINE-FACING. This table is what Loop noticed, not what a human
// is being asked to look at. Deciding what deserves a person's attention is a
// later stage with its own vocabulary; nothing here ranks, prioritizes, routes,
// notifies or escalates, and no column exists that a feed could sort by.
//
// FACT AND INFERENCE ARE SEPARATED BY COLUMN GROUP, not by convention. Everything
// under "the observed fact" belongs to the producing domain and is restated here
// only so a determination can explain itself; everything under "CI's inference"
// is Loop's own conclusion. The distinction survives in the read contract, which
// nests them (see packages/shared/src/commercial-signal.ts).
//
// CI DOES NOT OWN THE SOURCE RECORD, AND HAS NO FOREIGN KEY TO IT.
// `sourceSystem` + `sourceKey` are opaque handles, never parsed here -- the same
// shape `OperationalPriority.sourceSystem` / `recurrenceKey` uses. A real FK to
// `marketplace_calls` was considered and rejected: that table carries a scalar
// organizationId with no FK and a GLOBALLY unique (provider, externalId), and a
// reference would inherit both defects. The source stays authoritative; CI holds
// a pointer and its own correct tenancy.
//
// POSITIVE DETERMINATIONS ONLY. A row exists because an evaluator concluded an
// observation may matter to an objective. Evaluations that concluded nothing
// write nothing, so the ABSENCE of a row means only that no positive
// determination was recorded -- never that something was examined and dismissed.
// Stage 2 keeps no negative-evaluation history and no query may imply one.
//
// NO SCORE AND NO CONFIDENCE COLUMN. Loop has no approved relevance model, and a
// float here would be a fabricated certainty that every later surface would
// render. The extension point is `relevanceBasis` / `evaluatorId` /
// `evaluatorVersion`.
//
// TENANCY. Real foreign keys with defined delete behaviour, following the
// performance_objectives precedent directly above rather than the
// scalar-organizationId-no-FK debt of Work OS, vk_* and operational_*. Signals
// are tenant data and die with the tenant; they also die with the objective they
// were defined against, because a signal relative to nothing is not a signal.
//
// Additive only. No existing table is renamed, altered or dropped.
// ===========================================================================

model CommercialSignal {
  id                     String @id @default(cuid())
  organizationId         String
  /// The objective this observation was evaluated against. REQUIRED: relevance
  /// is a relation, not a property, and a signal with no referent is a data
  /// point Loop simply noticed.
  performanceObjectiveId String

  // --- The observed fact. Owned by its producing domain. -------------------
  /// The producer that owns this fact ('CALLGRID' today). A plain string so the
  /// second producer is a value rather than a migration.
  sourceSystem       String
  /// Stable identity of the observation WITHIN sourceSystem. Re-observing the
  /// same fact must produce the same key, or idempotency binds to nothing.
  sourceKey          String
  /// The producer's own handle for the subject -- a call id, an invoice number.
  /// Opaque here and NEVER parsed.
  sourceReference    String?
  /// When the fact occurred AT THE SOURCE. Distinct from firstEvaluatedAt (when
  /// CI looked) and createdAt (when the row was written). Three instants, and
  /// collapsing any two of them makes the history unreadable.
  observedAt         DateTime
  /// The fact in one line, in the source's terms. A restatement for explanation,
  /// never a substitute for reading the source.
  observationSummary String

  // --- CI's inference. Never the source's statement. -----------------------
  /// How relevance was established. Held as a string, not an enum, so a new
  /// evaluator is a contract change rather than production DDL -- the same
  /// reasoning OperationalPriority.severity gives.
  relevanceBasis     String
  /// Why this may matter to this objective, in a sentence a human can check.
  relevanceRationale String
  /// WHICH evaluator concluded this and WHICH build of it, so a determination
  /// stays interpretable after the evaluator's logic changes.
  evaluatorId        String
  evaluatorVersion   String

  /// The determination is established once and never rewritten. Re-evaluation
  /// moves the two counters below and touches nothing else -- the same shape
  /// OperationalPriority.firstDetectedAt / lastDetectedAt / detectionCount uses.
  /// A record of what CI believed is worthless if a later run can overwrite it.
  firstEvaluatedAt DateTime @default(now())
  lastEvaluatedAt  DateTime @default(now())
  evaluationCount  Int      @default(1)

  createdAt DateTime @default(now())

  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  performanceObjective PerformanceObjective @relation(fields: [performanceObjectiveId], references: [id], onDelete: Cascade)

  /// Idempotency, scoped to the tenant. Re-running an evaluation over the same
  /// window must not accumulate duplicates. `evaluatorId` is part of the key so
  /// a future evaluator reaching the same observation records its OWN
  /// determination instead of silently overwriting another evaluator's.
  /// `map:` is explicit on both composite indexes because Prisma's generated
  /// names exceed Postgres's 63-character identifier limit and would be
  /// truncated. A truncated name is still deterministic, but it is not READABLE
  /// in a migration file, and this repository hand-writes its migrations.
  @@unique([organizationId, performanceObjectiveId, sourceSystem, sourceKey, evaluatorId], map: "commercial_signals_org_objective_source_evaluator_key")
  @@index([organizationId, observedAt])
  @@index([organizationId, performanceObjectiveId, observedAt], map: "commercial_signals_org_objective_observedAt_idx")
  @@map("commercial_signals")
}

// ===========================================================================
// COMMERCIAL INTELLIGENCE -- STAGE 3 v1: BINDINGS AND HEADLINES
// ---------------------------------------------------------------------------
// Two tables. The first says what an objective means in measurable terms; the
// second records that something measurable about it changed.
//
// A HEADLINE IS NOT A DECISION, AND THIS SECTION MUST NEVER MAKE IT ONE.
// `headlines` carries no ownerUserId, no assigneeUserId, no lane, no state
// machine, no OperationalOutcome, no reopen counter and no observation log. A
// Decision means the organization has judged a matter and is acting; that lives
// in `operational_priorities` and already works. If a future change proposes any
// of those columns here, the thing being modelled is a Decision and the answer is
// to promote into the Decision Center instead. Promotion is Stage 3 v1.1 and no
// column for it exists yet -- naming a field is free, adding a column is a claim.
//
// WHY A SEPARATE BINDING TABLE RATHER THAN COLUMNS ON THE OBJECTIVE. Objective
// text is editable. A binding stored on the objective would be editable with it,
// and every Headline ever produced would silently change meaning -- the same
// reasoning that made Stage 2 reject a projection. Bindings are therefore
// immutable after confirmation and supersede-only, and every Headline records the
// exact binding version it was produced under. One objective may hold many
// bindings; Stage 3 v1 authors one at a time, and multiplicity costs no migration
// because it is already a separate row.
//
// THE POPULATION IS SELECTED, NEVER INFERRED. Members are stored as arrays of the
// provider's own EXTERNAL IDS, per dimension. There is no `vertical` column and
// there must not be: Loop has no vertical concept anywhere, and deriving one by
// parsing provider label text would put industry-specific data in a shared layer
// on top of unnormalized strings. There is no geography model either --
// `callerStates` is an OPTIONAL ADDITIONAL restriction that is empty by default,
// because where a caller physically was and which business motion a campaign
// belongs to are different facts and only a human can say which one an objective
// means.
//
// LABELS ARE DISPLAY, NEVER IDENTITY. `memberLabels` is a display-only map from
// external id to the label as it read at confirmation. Nothing may resolve a
// member through it, and no query may parse it.
//
// NO FOREIGN KEY TO THE SOURCE DOMAIN. `marketplace_calls` carries a scalar
// organizationId with no FK and a GLOBALLY unique (provider, externalId); a
// reference would inherit both defects. External ids are opaque handles here,
// exactly as `CommercialSignal.sourceKey` treats them.
//
// TENANCY. Real foreign keys with defined delete behaviour, following the
// performance_objectives and commercial_signals precedent rather than the
// scalar-organizationId-no-FK debt of Work OS, vk_* and operational_*.
//
// Additive only. No existing table is renamed, altered or dropped.
// ===========================================================================

model ObjectiveMeasureBinding {
  id                     String @id @default(cuid())
  organizationId         String
  performanceObjectiveId String

  /// 1-based, monotonic per objective. Part of the unique below, so two
  /// concurrent confirmations collide loudly rather than interleaving.
  version Int

  /// A member of MEASURE_METRICS. Held as a string, not an enum, so a sixth
  /// measure is a contract change rather than production DDL -- the same
  /// reasoning CommercialSignal.relevanceBasis gives. Validated on the way in
  /// AND on the way out; an unrecognised value fails closed.
  metric    String
  /// HIGHER_IS_BETTER | LOWER_IS_BETTER. Human intent about which way is good,
  /// which is the same kind of statement the objective's title already is. This
  /// is NOT a target: no number is being aimed at and none is stored.
  direction String

  /// The confirmed population, as the provider's own external ids. A member the
  /// provider gave a label but no id is NOT selectable -- a population keyed on a
  /// label changes shape the day somebody renames a campaign upstream.
  campaignExternalIds String[] @default([])
  sourceExternalIds   String[] @default([])
  buyerExternalIds    String[] @default([])
  vendorExternalIds   String[] @default([])

  /// OPTIONAL ADDITIONAL RESTRICTION on where the caller physically was. EMPTY
  /// MEANS NO RESTRICTION -- never "unknown", and never a filter matching nothing.
  callerStates String[] @default([])

  /// externalId -> label as it read at confirmation. DISPLAY ONLY. Never parsed,
  /// never used to resolve a member, never an input to anything.
  memberLabels Json @default("{}")

  /// Whose confirmation this is. SetNull rather than Cascade: a binding outlives
  /// the person who confirmed it, the reasoning audit_logs.userId already follows.
  confirmedByUserId String?
  confirmedAt       DateTime @default(now())

  /// The ONLY two fields writable after confirmation, and only once. Everything
  /// else is immutable, and the repository exposes no method that could change it.
  supersededAt          DateTime?
  supersededByBindingId String?   @unique

  createdAt DateTime @default(now())

  organization         Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  performanceObjective PerformanceObjective     @relation(fields: [performanceObjectiveId], references: [id], onDelete: Cascade)
  confirmedBy          User?                    @relation("ObjectiveMeasureBindingConfirmer", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  supersededBy         ObjectiveMeasureBinding? @relation("BindingSupersession", fields: [supersededByBindingId], references: [id], onDelete: SetNull)
  supersedes           ObjectiveMeasureBinding? @relation("BindingSupersession")

  headlines Headline[]

  @@unique([performanceObjectiveId, version], map: "objective_measure_bindings_objective_version_key")
  @@index([organizationId, performanceObjectiveId, supersededAt], map: "objective_measure_bindings_org_objective_active_idx")
  @@map("objective_measure_bindings")
}

/// A measured development in one objective's world.
///
/// Established once and never rewritten. Re-detecting the same development in a
/// later period moves `lastDetectedAt`, `detectionCount` and `lastDetectionKey`
/// and touches nothing else -- the same discipline CommercialSignal keeps, and
/// for the same reason: a record of what Loop measured is worthless if a later
/// run can quietly revise it.
///
/// There is no `updatedAt`, deliberately. The only mutations this row admits are
/// the three sighting counters and the three dismissal fields, each written once
/// per event, and a general modification stamp would imply the rest is editable.
model Headline {
  id                     String @id @default(cuid())
  organizationId         String
  performanceObjectiveId String
  /// The EXACT binding version this was produced under, never the latest one.
  /// Restrict on delete: a Headline whose definition has been deleted cannot be
  /// interpreted, so the binding may not disappear beneath it.
  measureBindingId       String

  /// Identity, and it contains no timestamp. Derived from the binding version,
  /// the metric, the rule and the DIRECTION of the move, so the same development
  /// next period lands on this row rather than creating a second one, and so an
  /// oscillating measure keeps "rose" and "fell" as the two different statements
  /// about the world that they are.
  recurrenceKey String

  ruleId          String
  ruleVersion     String
  producerVersion String

  metric           String
  /// INCREASE | DECREASE.
  movement         String
  /// True when the move runs against the objective's stated direction. A fact
  /// about arithmetic and a human's own declared intent -- never a judgement
  /// about whether the business is doing well.
  againstObjective Boolean

  /// The measured development in one line. DISPLAY ONLY, and NO EVALUATOR, RULE
  /// OR FUTURE MEASUREMENT MAY READ IT. It contains Loop's own words as well as
  /// the source's, and Stage 2 shipped a real defect by letting CI-authored text
  /// become the evidence for CI's own conclusion.
  statement String

  // --- The measurement. Every field traces to rows in the source domain. ----
  /// In the metric's own unit: cents for REVENUE, a count for CALL_VOLUME, a
  /// 0-1 fraction for a rate. The unit is derived from `metric` rather than
  /// stored, so a value and its unit can never disagree.
  currentValue       Float?
  priorValue         Float?
  absoluteChange     Float?
  /// A fraction, not a percentage. Null when there was no non-zero baseline.
  percentageChange   Float?
  /// What each value was computed OVER. Stated so a reader can judge the sample
  /// rather than trust the number.
  currentDenominator Int
  priorDenominator   Int
  /// 0-1. Null where the metric has no coverage concept.
  currentCoverage    Float?
  priorCoverage      Float?

  comparisonBasis    String
  currentWindowStart DateTime
  currentWindowEnd   DateTime
  priorWindowStart   DateTime
  priorWindowEnd     DateTime

  /// What this measurement cannot support, and what it leaves open. Carried
  /// alongside the numbers forever: evidence that keeps its value and loses its
  /// caveats is how a hedged claim becomes a confident one.
  limitations String[] @default([])
  unknowns    String[] @default([])

  // --- Observation provenance ----------------------------------------------
  /// WHICH completeness rule governed this row. Stored rather than assumed
  /// because the rule is versioned and will change: without this, a Headline
  /// written under one definition of "observed" is indistinguishable from one
  /// written under another, and neither can be re-audited.
  ///
  /// The default is the literal string "none", which means THIS ROW PREDATES THE
  /// GUARD. It is deliberately not a version number: rows written before
  /// observation was proven were not certified, we cannot know what was observed
  /// when they were made, and backfilling a version onto them would manufacture
  /// exactly the certainty this whole mechanism exists to refuse.
  observationRuleVersion String @default("none")
  /// How many business dates across BOTH windows the rule verified. 0 alongside
  /// "none" says plainly that nothing was verified.
  observedDayCount       Int    @default(0)

  // --- Recurrence. The only counters that move. -----------------------------
  firstDetectedAt  DateTime @default(now())
  lastDetectedAt   DateTime @default(now())
  detectionCount   Int      @default(1)
  /// Identity of the completed comparison period most recently recorded. A run
  /// over a period already recorded changes nothing, which is what makes a
  /// server-rendered surface safe to refresh -- the device
  /// `OperationalObservation.detectionKey` already proved.
  lastDetectionKey String

  // --- Attention feedback. NOT an outcome, and NOT a lifecycle. -------------
  /// Dismissal records that a human did not need this. It never reopens, never
  /// suppresses recurrence, and carries no claim about what the organization will
  /// do -- that is Decision semantics and lives in operational_priorities.
  dismissedAt       DateTime?
  dismissedByUserId String?
  /// WRONG (retune detection) | IMMATERIAL (retune attention). Deliberately NOT
  /// OperationalOutcome: that vocabulary answers "did acting work", which nobody
  /// has been asked here.
  dismissalBasis    String?

  createdAt DateTime @default(now())

  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  performanceObjective PerformanceObjective    @relation(fields: [performanceObjectiveId], references: [id], onDelete: Cascade)
  measureBinding       ObjectiveMeasureBinding @relation(fields: [measureBindingId], references: [id], onDelete: Restrict)
  dismissedBy          User?                   @relation("HeadlineDismisser", fields: [dismissedByUserId], references: [id], onDelete: SetNull)

  /// Idempotency, scoped to the tenant. Two runs over the same period, and two
  /// concurrent runs, converge on one row.
  @@unique([organizationId, performanceObjectiveId, recurrenceKey], map: "headlines_org_objective_recurrence_key")
  @@index([organizationId, lastDetectedAt], map: "headlines_org_lastDetectedAt_idx")
  @@index([organizationId, performanceObjectiveId, dismissedAt], map: "headlines_org_objective_dismissed_idx")
  @@map("headlines")
}

// ---------------------------------------------------------------------------
// Provider observation — Commercial Intelligence Stage 3 correctness
// ---------------------------------------------------------------------------

/// One business date, one data stream, and whether Loop actually looked at it.
///
/// WHY THIS TABLE EXISTS. Every other row in this schema is evidence of
/// PRESENCE. An Interaction proves a call arrived; a MarketplaceCall proves one
/// was projected; an integration_event proves a delivery was persisted. None of
/// them is evidence of ABSENCE, so a day with no rows was indistinguishable from
/// a day nobody queried — and in August 2026 a three-day ingestion gap sat inside
/// a Stage 3 comparison window where it would have measured as a commercial
/// collapse. Completeness cannot be derived from what was stored; it has to be
/// asserted by a bounded read against the provider, and that assertion is this
/// row.
///
/// IT NEVER IMPLIES INGESTION. Certifying a day writes exactly one of these and
/// nothing else — no Interaction, no MarketplaceCall, no projection. Observing
/// and recovering are different operations with different authorizations, and
/// folding them together would make it impossible to prove a day was empty
/// without also writing to it.
model ProviderObservationDay {
  id             String @id @default(cuid())
  organizationId String

  /// The sensor that was read, e.g. "callgrid".
  provider String
  /// WHICH STREAM from that provider. Observation is per stream, not per
  /// provider: the calls endpoint being complete says nothing about the auction
  /// reports, and one row covering both would certify what it never read.
  stream   String

  /// The calendar day in `timezone` that this row certifies.
  businessDate DateTime @db.Date
  /// Named, never assumed. A row that does not state its zone cannot be checked
  /// against the window a measurement actually used.
  timezone     String
  /// The UTC interval actually queried. Stored so the row is self-describing and
  /// a reader never has to re-derive a DST boundary to audit it.
  windowStart  DateTime
  windowEnd    DateTime

  /// The outcome, reusing the enum the auction-report ledger already defines.
  /// A second enum meaning the same six things would be the parallel-system
  /// failure mode CLAUDE.md names first. SUCCESS and EMPTY certify; everything
  /// else does not, and the absence of a row certifies nothing at all.
  status     MarketplaceReportRunStatus
  observedAt DateTime
  /// How the assertion was established. "provider-query" is the only value this
  /// version accepts — no human attestation, no inference from adjacent days.
  source     String

  /// What the provider returned. `providerStatedTotal` is the stronger evidence
  /// when the provider offers one, and stays null rather than echoing our count.
  recordsObserved     Int
  providerStatedTotal Int?
  pagesFetched        Int
  pageCap             Int
  /// True when Loop stopped at its own page budget while the provider still had
  /// pages. A truncated read is a lower bound and MUST NOT certify the day.
  truncated           Boolean @default(false)

  /// Why the day did not certify, in plain language. Never a credential, never a
  /// phone number, never a raw payload.
  reason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Tenant-first identity. `integration_events` is uniquely keyed
  /// (provider, externalId) GLOBALLY and cannot be fixed in callers; this table
  /// does not repeat that mistake, so one organization's certification can never
  /// satisfy another's measurement gate.
  @@unique([organizationId, provider, stream, businessDate], name: "observation_day_identity", map: "observation_day_identity")
  @@index([organizationId, provider, stream, businessDate])
  @@map("provider_observation_days")
}

// ---------------------------------------------------------------------------
// Provider member expectation — Commercial Intelligence Stage 3 correctness
// ---------------------------------------------------------------------------

/// What a human declared about one provider population member, in force over a
/// range of business dates.
///
/// WHY THIS TABLE EXISTS. `provider_observation_days` proves Loop LOOKED at a
/// day, and reconciliation proves what ARRIVED. Neither can say whether a record
/// that never arrived was supposed to. On 2026-08-05 CallGrid held 974 call
/// identities and Loop held 867; 9 of the 107 absences came from campaigns whose
/// webhook was never attached and could not have arrived, and the rest came from
/// campaigns that do deliver. From inside Loop both look identical — a row that
/// is not there. This table is where a person says which is which.
///
/// EFFECTIVE-DATED, BECAUSE THE ALTERNATIVE REWRITES HISTORY. A current-state
/// flag saying "this campaign is connected" would retroactively convert every day
/// before the webhook was attached into a delivery failure nobody could have
/// prevented. A declaration states what was true FROM a date, and a later
/// declaration ends it rather than overwriting it. `effectiveFrom` is INCLUSIVE
/// and `effectiveTo` is EXCLUSIVE, the half-open convention `EffectiveDateRange`
/// already carries in @emgloop/shared; NULL means still in force.
///
/// UNKNOWN IS NOT STORABLE. Three states are declarable — EXPECTED,
/// NOT_CONFIGURED, EXCLUDED. "Nobody has said" is the ABSENCE of a row covering
/// the date, exactly as the absence of an observation row certifies nothing, and
/// it fails closed at the measurement gate. There is no column here that could
/// hold UNKNOWN and no way to write one.
///
/// NEVER INFERRED FROM TRAFFIC. Nothing writes this table because calls appeared,
/// a webhook was configured, or a reconciliation found records. A campaign that
/// broke would silently un-expect itself the moment it stopped delivering, and
/// the alarm would disarm exactly when it was needed. Observed traffic that
/// contradicts a declaration is reported as CAMPAIGN_EXPECTATION_CONTRADICTED and
/// waits for a person.
///
/// AT MOST ONE DECLARATION IS IN FORCE PER MEMBER PER DATE, and that is enforced
/// by the database rather than by callers: a Postgres EXCLUDE constraint over the
/// member key and the half-open date range, added in the migration because Prisma
/// cannot express it. Two declarations covering one date would mean the
/// organization has said two things, and there is no tie-break that would not be
/// invented.
model ProviderMemberExpectation {
  id             String @id @default(cuid())
  organizationId String

  /// The sensor the member belongs to, e.g. "callgrid".
  provider String
  /// WHICH STREAM, following `provider_observation_days`. A campaign attached to
  /// the calls webhook says nothing about the auction report feed, and one row
  /// covering both would declare something nobody checked.
  stream   String

  /// A member of EXPECTATION_DIMENSIONS — 'CAMPAIGN' in v1. Held as a string, not
  /// an enum, so widening the declarable dimensions is a contract change rather
  /// than production DDL, the same reasoning `ObjectiveMeasureBinding.metric`
  /// gives. Validated on the way in AND on the way out; an unrecognised value
  /// fails closed to UNKNOWN.
  memberDimension  String
  /// The provider's own id for the member. IDENTITY IS THE ID, never the label:
  /// a declaration keyed on a label changes meaning the day somebody renames a
  /// campaign upstream.
  memberExternalId String

  /// EXPECTED | NOT_CONFIGURED | EXCLUDED. Held as a string for the same reason
  /// as `memberDimension`, and validated against MEMBER_EXPECTATION_STATES in
  /// both directions. UNKNOWN is not a member of that list and cannot be stored.
  state           String
  /// A member of MEMBER_EXCLUSION_REASONS. REQUIRED when state is EXCLUDED and
  /// NULL otherwise — an exclusion nobody has to justify is a place to hide a
  /// delivery failure.
  exclusionReason String?
  /// A member of MEMBER_EXPECTATION_BASES: how the declaration was arrived at.
  /// PROVIDER_CONFIG_VERIFIED means somebody read the provider's own
  /// configuration; OPERATOR_DECLARED means somebody stated it from knowledge of
  /// the business. Stored so a conclusion drawn from a weaker basis carries that
  /// weakness with it.
  basis           String
  /// Why, in plain language, for the person reading this in six months. Never a
  /// credential, never a phone number, never a raw payload.
  reason          String

  /// INCLUSIVE. The first business date this declaration speaks for.
  effectiveFrom DateTime  @db.Date
  /// EXCLUSIVE, and NULL means open-ended. Written exactly once, by the
  /// declaration that succeeds this one; the state, basis and reason of a closed
  /// row are never touched, so what was true then stays readable.
  effectiveTo   DateTime? @db.Date

  /// Who said it. NULL when no human actor was resolvable — a script, or a
  /// backfill — and never a fabricated identity. SetNull rather than Cascade: a
  /// declaration outlives the person who made it, the reasoning audit_logs.userId
  /// already follows.
  declaredByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization          Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  declaredBy            User?                          @relation("ProviderMemberExpectationDeclarer", fields: [declaredByUserId], references: [id], onDelete: SetNull)
  /// Reconciliation member facts that RESOLVED to this declaration. The link is
  /// what makes a historical verdict auditable: it names the statement the
  /// comparison actually used, and that statement is itself never rewritten.
  reconciliationMembers ProviderReconciliationMember[]

  /// Resolution reads one member's declarations in effective order. Tenant-first,
  /// like every key in this stage: one organization's declaration must never
  /// resolve another organization's member.
  @@index([organizationId, provider, stream, memberDimension, memberExternalId, effectiveFrom], map: "provider_member_expectations_member_effective_idx")
  @@map("provider_member_expectations")
}

// ---------------------------------------------------------------------------
// Provider reconciliation — Commercial Intelligence Stage 3 correctness
// ---------------------------------------------------------------------------

/// Whether the provider identities observed for one business date actually
/// reached Loop.
///
/// WHY THIS TABLE EXISTS, AND WHY IT IS NOT A COLUMN ON THE OBSERVATION LEDGER.
/// `provider_observation_days` answers "did Loop exhaustively LOOK at this day".
/// On 2026-08-05 it answered yes — SUCCESS, 974 records across 11 unbroken pages
/// — while Loop held 867 of them. Both statements were true at once, because that
/// row persists a COUNT and never the identity SET. Redefining SUCCESS to mean
/// "and the data is here" would destroy the only completeness claim Loop
/// currently gets right and re-merge two questions it took three investigations
/// to separate. This is the SECOND fact, deliberately beside the first.
///
/// THE VERDICT LIVES AT THE DAY; THE DIFFERENCE LIVES IN CAMPAIGNS. Measurement
/// gates on a day, so the state is here. But 106 of those 107 absences belonged
/// to three campaigns, and a day-level verdict alone would let one broken
/// campaign block every objective in the organization including the ones that
/// never measured it. `provider_reconciliation_members` carries the per-member
/// detail a later readiness gate evaluates per binding.
///
/// IT OBSERVES AND RECORDS; IT NEVER REPAIRS. Nothing that writes this table
/// creates an IntegrationEvent, an Interaction or a MarketplaceCall, and nothing
/// here triggers recovery. Discovering that the provider holds records Loop is
/// missing is EVIDENCE for a later decision and changes nothing on its own — the
/// same stance certification takes.
///
/// EVERY COUNT IS EVIDENCE, AND THE ARITHMETIC IS CHECKED RATHER THAN TRUSTED.
/// intersection + providerOnly = providerUnique, intersection + localOnly =
/// localUnique, and the four-way provider-only split sums to providerOnly. A
/// violation means the COMPARISON is wrong rather than the data is bad, and the
/// row is written INCONCLUSIVE with its reason instead of a verdict nobody should
/// read.
model ProviderReconciliationDay {
  id             String @id @default(cuid())
  organizationId String

  /// The sensor that was compared, e.g. "callgrid".
  provider String
  /// WHICH STREAM, following `provider_observation_days`. Reconciling the calls
  /// endpoint says nothing about the auction report feed.
  stream   String

  /// The calendar day in `timezone` this row reconciles.
  businessDate DateTime @db.Date
  /// Named, never assumed — a row that does not state its zone cannot be checked
  /// against the window a measurement actually used.
  timezone     String
  /// The UTC interval a record must have OCCURRED in to belong to this day.
  windowStart  DateTime
  windowEnd    DateTime

  /// The widened interval the LOCAL delivery scan actually covered. Deliberately
  /// wider than the occurrence window: `integration_events` has no occurrence
  /// column, so rows are selected by `receivedAt` and filtered by resolved
  /// occurrence in memory. A webhook retried the next morning still belongs to
  /// the day it occurred on, and a scan bounded to the day itself would classify
  /// it as absent. Stored so the row states the bound it was produced under.
  scanStart DateTime
  scanEnd   DateTime

  /// RECONCILED | UNRECONCILED | UNKNOWN_EXPECTATION | INCONCLUSIVE. Held as a
  /// string rather than an enum, following `ProviderMemberExpectation.state`, so
  /// widening the vocabulary is a contract change rather than production DDL
  /// against a table whose migrations are human-dispatched. Validated against
  /// RECONCILIATION_STATES in both directions; an unreadable value fails closed.
  state       String
  /// Which build of the rule produced it. A verdict outlives the code that
  /// reached it, and a rule change must not silently reinterpret a stored one.
  ruleVersion String

  /// The local boundary the comparison was made at: "integration_event". It
  /// proves RECEIPT and precedes normalization and projection semantics, and
  /// August 2026 proved the chain below it identity-lossless for every record
  /// Loop received. Reconciling at MarketplaceCall would conflate a delivery
  /// failure with a projection rule.
  localStage String

  /// What the provider returned. `providerRecords` counts rows and
  /// `providerUnique` counts identities; they differ exactly when the provider
  /// repeated one, which is why both are kept.
  providerRecords      Int
  providerUnique       Int
  providerDuplicateIds Int
  /// Provider records carrying no member attribution. They cannot be resolved
  /// against a declaration, and the four-way split could only sum by inventing a
  /// member id — so a non-zero value here makes the day INCONCLUSIVE.
  providerUnattributed Int @default(0)

  /// Rows the widened delivery scan read, before any filtering. The denominator
  /// `localUnresolvedOccurrence` is otherwise unauditable.
  localRowsScanned          Int
  /// Of those, the ones whose resolved occurrence fell inside the window.
  localInWindow             Int
  localUnique               Int
  localDuplicateIds         Int
  /// Scanned rows whose occurrence could not be resolved at all. They CANNOT BE
  /// RULED OUT of this date — that is what unresolved means — so they impeach it.
  localUnresolvedOccurrence Int @default(0)
  /// In-window rows carrying no external identity. A row that cannot be named
  /// cannot be matched, and dropping it silently would make the local set look
  /// cleaner than it is.
  localMissingIdentity      Int @default(0)

  /// The comparison itself.
  intersection Int
  providerOnly Int
  /// Identities Loop holds that the provider's bounded read did not return. A
  /// non-zero value means the two populations are not describing the same thing,
  /// which IMPEACHES the comparison rather than reporting a gap in it.
  localOnly    Int

  /// How every provider-only identity is accounted for. "107 missing" is an
  /// alarm; this split is a work list.
  providerOnlyExpected      Int
  providerOnlyNotConfigured Int
  providerOnlyExcluded      Int
  providerOnlyUnknownMember Int

  /// The provider read's own bounds, mirroring the observation ledger. A
  /// truncated read is a LOWER BOUND and can never produce a verdict.
  pagesFetched Int
  pageCap      Int
  truncated    Boolean @default(false)

  /// Why the comparison is not sound, in plain language, joined from the pure
  /// integrity assessment. NULL when it is. Never a credential, never a phone
  /// number, never a raw identity.
  reason String?

  /// When the provider population was read, and when the verdict was reached.
  /// Separate because a long read and its conclusion are not the same instant.
  observedAt   DateTime
  reconciledAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      ProviderReconciliationMember[]

  /// Tenant-first identity, and the reason re-running is safe: one row per day
  /// per stream per tenant, updated in place exactly as `certifyDay` upserts its
  /// ledger row. A day may legitimately be reconciled again — a late delivery, a
  /// newly recorded declaration, a previously inconclusive run — and each run
  /// must leave ONE current answer rather than a pile a reader has to reconcile.
  /// `map:` is given EXPLICITLY alongside `name:`, and that is a lesson rather
  /// than a style. `name:` renames the constraint only in the Prisma client's
  /// `where`; the database index keeps Prisma's generated default. The
  /// observation ledger set `name:` alone, so `migrate diff` has reported a
  /// phantom index rename against production ever since. Setting both makes the
  /// client alias and the database object the same string, and there is nothing
  /// left to drift.
  @@unique([organizationId, provider, stream, businessDate], name: "reconciliation_day_identity", map: "reconciliation_day_identity")
  @@map("provider_reconciliation_days")
}

/// One day's reconciliation, explained for one provider population member.
///
/// WHY MEMBER ROWS ARE NOT OPTIONAL. A day can be UNRECONCILED because one
/// campaign is short while an objective bound to a different, fully reconciled
/// campaign remains perfectly measurable. Without this table the only available
/// gate is the day, and a day-level gate makes every objective in the
/// organization hostage to the worst campaign in it.
///
/// THE EXPECTATION IS RECORDED AS RESOLVED, NOT AS A POINTER TO BE RE-READ.
/// `expectationState` is what was in force ON THIS BUSINESS DATE at the moment
/// the comparison ran, and `expectationId` names the declaration that said so.
/// A declaration recorded later must never silently change what a historical
/// reconciliation concluded — re-running is a deliberate act that rewrites the
/// row and moves `reconciledAt`, not a side effect of somebody typing.
///
/// IDENTITY IS THE ID. `labelAtObservation` is display-only and may be null; a
/// member keyed on a label changes meaning the day somebody renames a campaign
/// upstream.
model ProviderReconciliationMember {
  id                  String @id @default(cuid())
  reconciliationDayId String
  /// Denormalised from the day so a member read is tenant-scoped in its own
  /// right rather than only through its parent. Sprint 29A's lesson was that a
  /// query which CAN be written without a tenant eventually is.
  organizationId      String

  /// A member of EXPECTATION_DIMENSIONS — 'CAMPAIGN' in v1, the only dimension
  /// proven to gate delivery and the only attribution id present on every record
  /// of the 2026-08-05 provider population.
  memberDimension  String
  /// The provider's own id for the member.
  memberExternalId String

  /// Identities the provider returned for this member on this day.
  providerCount Int
  /// Provider identities for this member with no local counterpart.
  providerOnly  Int
  /// Identities Loop holds for this member, attributed from the LOCAL payload
  /// rather than from the provider — an independent measure, so the two can be
  /// seen to disagree instead of one being derived from the other.
  localCount    Int
  /// Of those, the ones the provider's read did not return. Kept so the member
  /// row states its own arithmetic: providerCount - providerOnly is the matched
  /// set, and localCount - localOnly must equal it when both sides agree about
  /// which member a call belongs to.
  localOnly     Int

  /// EXPECTED | NOT_CONFIGURED | EXCLUDED | UNKNOWN, resolved for this business
  /// date. UNKNOWN is not storable in `provider_member_expectations` and IS
  /// storable here, because here it is a resolved answer — "nobody had said" —
  /// rather than a declaration.
  expectationState   String
  /// The declaration that produced it. NULL EXACTLY WHEN the state is UNKNOWN,
  /// which is what "nobody had said" and "two people said different things" both
  /// resolve to.
  ///
  /// The migration enforces this as a BICONDITIONAL, not an implication. A
  /// declarable state with no declaration behind it records a classification
  /// nobody can later justify — the exact situation the expectation table was
  /// built to end — and an UNKNOWN carrying an id would point at a declaration it
  /// did not use.
  ///
  /// The foreign key proves the declaration EXISTS; it does not prove it is about
  /// this member. That is enforced in
  /// `ProviderReconciliationRepository.recordDay`, which resolves every named
  /// declaration within the organization and refuses the write when its provider,
  /// stream, dimension or member id disagrees. The migration records what
  /// database-level enforcement would cost.
  expectationId      String?
  /// How many declarations matched. More than one is a configuration defect the
  /// resolver reports rather than resolves, and recording it means a later reader
  /// can tell "nobody said" from "two people disagreed".
  expectationMatches Int     @default(0)

  /// The member's provider-side label at the time of the comparison. DISPLAY
  /// ONLY, never identity, and NULL when the provider did not supply one.
  labelAtObservation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  day          ProviderReconciliationDay  @relation(fields: [reconciliationDayId], references: [id], onDelete: Cascade)
  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// SetNull rather than Cascade: the fact that a declaration WAS used outlives
  /// the declaration, the reasoning `audit_logs.userId` already follows. In
  /// practice unreachable — nothing deletes a declaration, and deleting the
  /// organization cascades this row away first — but a fact that quietly lost
  /// its subject would be worse than one that says the link is gone.
  expectation  ProviderMemberExpectation? @relation(fields: [expectationId], references: [id], onDelete: SetNull)

  /// One row per member per day. A re-run replaces the set inside the same
  /// transaction that rewrites the day, so a member can never appear twice and a
  /// member that stopped existing cannot linger from a previous run.
  @@unique([reconciliationDayId, memberDimension, memberExternalId], name: "reconciliation_member_identity", map: "reconciliation_member_identity")
  /// A DIFFERENT access path, not a duplicate of the unique above: "how has this
  /// campaign reconciled over time" reads across days, and the unique key starts
  /// with the day. The day table carries no second index for exactly the opposite
  /// reason — its unique already covers the only way it is read.
  @@index([organizationId, memberDimension, memberExternalId], map: "reconciliation_member_lookup")
  @@map("provider_reconciliation_members")
}

// ---------------------------------------------------------------------------
// Measurement source authority — Commercial Intelligence Stage 3 correctness
// ---------------------------------------------------------------------------

/// One thing this organization is willing to believe a number from.
///
/// WHY A REGISTRY AND NOT A CONSTANT. A call-tracking platform is a platform
/// fact and could have been a constant. A counterparty who settles the following
/// day and reports outcomes in a document is a BUSINESS fact, specific to one
/// organization and one commercial relationship, and hard-coding it would put a
/// line of business into a shared layer — which Stage 3 forbids everywhere else
/// and would have to forbid here too. So both are rows, and neither is special.
///
/// NOTHING IS SEEDED. A source exists because a person registered it. The
/// absence of one is not "assume the provider": it resolves
/// MEASURE_NOT_SUPPORTED_BY_SOURCE at the gate and refuses the measurement.
///
/// THE KIND IS WHAT IT IS, NOT HOW IT TRAVELS. `BUYER_REPORT` describes an
/// outcome report supplied by a counterparty after the activity it describes;
/// naming the kind after today's file format would put a vendor in the domain
/// model and need renaming the first time the same buyer sent something else.
/// The kind selects how availability is proven — a polled stream proves it by
/// being observed and reconciled, an arriving report by having arrived.
model MeasurementSource {
  id             String @id @default(cuid())
  organizationId String

  /// The stable handle an authority declaration names. Identity is this key, and
  /// it is DATA rather than a vocabulary member: a closed enum of source keys
  /// would have to gain a member for every commercial relationship, which is the
  /// line-of-business-in-a-shared-contract failure by another route.
  key String

  /// A member of MEASUREMENT_SOURCE_KINDS. Held as a string, following
  /// `ProviderMemberExpectation.state`, so widening the vocabulary is a contract
  /// change rather than production DDL against a human-dispatched migration.
  /// Validated on the way in and on the way out; an unreadable value fails closed.
  kind        String
  /// For a person reading a screen. Never identity.
  displayName String

  /// Set for PROVIDER_STREAM and NULL otherwise, enforced by CHECK. They tie the
  /// source to the exact stream whose observation and reconciliation prove its
  /// availability; a report that arrives has no stream to observe.
  provider String?
  stream   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  metrics      MeasurementSourceMetric[]
  authorities  MeasureSourceAuthority[]

  /// Tenant-first identity: one organization's source key must never resolve
  /// another organization's source.
  @@unique([organizationId, key], name: "measurement_source_identity", map: "measurement_source_identity")
  /// NOT REDUNDANT WITH THE PRIMARY KEY. It exists to be a composite foreign-key
  /// TARGET, so a child row must name a source id AND the organization it
  /// belongs to. PR 3 could not do this for its expectation link — that column is
  /// nullable, and a composite SET NULL is syntax Prisma cannot express — and had
  /// to enforce ownership in the repository instead. Here both columns are
  /// required, so the database can hold it.
  @@unique([id, organizationId], name: "measurement_source_tenant_ref", map: "measurement_source_tenant_ref")
  @@map("measurement_sources")
}

/// One measure this source may be believed about, and the definition it uses.
///
/// WHY THIS IS A TABLE AND NOT TWO COLUMNS ON THE SOURCE. The pure contract
/// carries `supportedMetrics` and `measureDefinitionIds` separately and
/// `sourceSupports()` guards the gap between them — a metric listed as supported
/// with no definition id is not usable. Persisted as one row per metric, that gap
/// cannot exist: a metric IS supported because there is a row, and the row
/// carries the definition. The contract's shape is rebuilt from these rows on
/// read, unchanged.
///
/// `measureDefinitionId` IS THE LOAD-BEARING FIELD. Two sources may only be
/// combined in one measurement when they declare the SAME definition for a
/// metric, because a provider's flag and a counterparty's own record of a
/// completed sale are not the same statement, and nothing except a declaration
/// can establish that they are.
model MeasurementSourceMetric {
  id                  String @id @default(cuid())
  measurementSourceId String
  /// Denormalised so this row is tenant-scoped in its own right AND so the
  /// composite foreign key below can prove the source belongs to the same
  /// organization rather than merely existing.
  organizationId      String

  /// A member of MEASURE_METRICS. Held as a string for the same reason as
  /// `MeasurementSource.kind`, and validated in both directions.
  metric              String
  /// What this source means by the metric. Free-form by necessity — it names a
  /// definition two parties agreed on, not a member of any vocabulary Loop owns.
  measureDefinitionId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  source       MeasurementSource @relation(fields: [measurementSourceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([measurementSourceId, metric], name: "measurement_source_metric_identity", map: "measurement_source_metric_identity")
  @@map("measurement_source_metrics")
}

/// One statement: for this member and this measure, over this period, believe
/// this source.
///
/// AUTHORITY IS DECLARED, NEVER INFERRED. Nothing writes this table because a
/// field was non-null, a webhook existed, a reconciliation succeeded, an import
/// landed, or one source reported a larger number. A source CONTAINING a value
/// does not make it authoritative for that value — on 2026-08-05 every one of the
/// 974 records the provider held carried `converted=false`, present and not
/// absent, so a conversion rate computed from them would have returned 0% at full
/// coverage, cleared every guard, and stated a business falsehood as a measured
/// fact. Loop was one confirmed binding away from publishing it.
///
/// THE GRAIN IS (member, metric, date), and it is the contract's, not a choice
/// made here. It buys the case this exists for at no extra cost: the provider for
/// call volume and a counterparty for revenue, on the SAME campaign, on the same
/// day, without either being a contradiction. Provider and stream are
/// deliberately NOT part of this key — the member is the subject and the source
/// is the answer, so keying on the provider would ask which source is
/// authoritative for one provider's version of a campaign, which is not a
/// question anyone has.
///
/// EFFECTIVE-DATED, because a program can change buyer. Re-running last month's
/// comparison must resolve the authority that was in force LAST MONTH; otherwise
/// a stored Headline silently changes meaning when a configuration changes, which
/// is the defect immutable bindings exist to prevent. `effectiveFrom` is
/// INCLUSIVE, `effectiveTo` EXCLUSIVE, NULL open-ended.
///
/// NO BASIS FIELD, DELIBERATELY. `ProviderMemberExpectation` records one because
/// "somebody read the provider's configuration" and "somebody remembered" are
/// different evidentiary strengths for a factual claim about the world. Authority
/// is not a claim about the world; it is a DECISION about which source to
/// believe, and a decision has a reason rather than a basis. Inventing a second
/// vocabulary to say that would be a vocabulary with one real member.
///
/// AT MOST ONE AUTHORITY PER MEMBER PER MEASURE PER DATE, enforced by Postgres.
/// Two would mean the organization has said two things, and the pure resolver
/// refuses to tie-break rather than inventing a precedence the organization has
/// not actually settled.
model MeasureSourceAuthority {
  id             String @id @default(cuid())
  organizationId String

  /// A member of BINDING_DIMENSIONS. CAMPAIGN in practice today; held as a string
  /// and validated, like every other Stage 3 vocabulary column.
  memberDimension  String
  /// The provider's own id for the member. IDENTITY IS THE ID, never the label.
  memberExternalId String
  /// A member of MEASURE_METRICS. Authority is per MEASURE: one campaign can take
  /// call volume from the provider and revenue from a counterparty.
  metric           String

  /// The source to believe. A composite foreign key rather than a loose key
  /// string: the declaration must name a source THIS organization registered, and
  /// the database proves it rather than a caller remembering to check.
  measurementSourceId String

  /// Why, in plain language, for the person reading this in six months. Required:
  /// an unexplained authority is a place to hide a revenue decision.
  reason String

  /// INCLUSIVE first business date this speaks for.
  effectiveFrom DateTime  @db.Date
  /// EXCLUSIVE, NULL open-ended. Written exactly once, by the declaration that
  /// succeeds this one; everything the closed row said stays readable.
  effectiveTo   DateTime? @db.Date

  /// Who decided. NULL when no human actor was resolvable — never a fabricated
  /// identity. SetNull rather than Cascade: a decision outlives the person who
  /// made it, the reasoning `audit_logs.userId` already follows.
  declaredByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source       MeasurementSource @relation(fields: [measurementSourceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  declaredBy   User?             @relation("MeasureSourceAuthorityDeclarer", fields: [declaredByUserId], references: [id], onDelete: SetNull)

  /// Resolution reads one member+metric's declarations in effective order.
  @@index([organizationId, memberDimension, memberExternalId, metric, effectiveFrom], map: "measure_source_authority_lookup")
  @@map("measure_source_authorities")
}

// ---------------------------------------------------------------------------
// Provider poll checkpoint — Commercial Intelligence Stage 3 (routine polling)
// ---------------------------------------------------------------------------

/// The provider time through which routine polling has PROVEN coverage.
///
/// WHAT THIS IS NOT, AND THE DISTINCTION IS THE WHOLE POINT.
///
/// It is NOT the newest provider record Loop has seen. A provider interval can
/// legitimately contain zero calls, and a quiet night would leave a max() with
/// nothing to return — the checkpoint would stop moving while coverage was in
/// fact complete, and the re-read window would grow without bound. Even on a
/// busy interval the newest call may sit hours behind the boundary, so the
/// newest occurrence understates what the read actually proved.
///
/// It is NOT when the poller last ran. A run that failed still ran. A run that
/// deliberately lags its upper bound behind the clock covered less than the
/// moment it executed. Recording execution time claims instants nobody read.
///
/// It IS the EXCLUSIVE UPPER BOUND of the most recent half-open interval whose
/// provider read completed AND whose records were fully applied locally. That is
/// the strongest statement the architecture supports: `readCallGridInterval`
/// returning COMPLETE proves the provider held nothing else in `[since, until)`,
/// and the poll service reports APPLIED only once every accepted record has been
/// through IngestionService.
///
/// MONOTONIC. Advancement is a conditional update guarded on
/// `completedThrough < :candidate`, so a slower concurrent run carrying an older
/// boundary matches zero rows and changes nothing. Two workers may overlap
/// harmlessly — ingestion is idempotent on (provider, externalId) — but the
/// proven boundary can only ever move forward.
///
/// SUCCESSES ONLY. There is no `lastOutcome`, no `lastAttemptAt` and no failure
/// state here, deliberately. A table whose every row means "this was proven"
/// cannot be misread; a table carrying attempt state invites a reader to treat a
/// recorded failure as a coverage fact. What a run did is reported by the run.
///
/// NO ROW MEANS NO COVERAGE HAS BEEN PROVEN. Not "since the beginning of time",
/// not zero — absent. The first poll uses a bounded bootstrap lookback, and this
/// row appears only after that poll succeeds.
///
/// INDEPENDENT OF THE WEBHOOK. Nothing about webhook delivery reaches this row.
/// The webhook is the low-latency path and the poll is the completeness path;
/// tying the second's proof to the first's success would make an outage in the
/// webhook look like covered provider time.
model ProviderPollCheckpoint {
  id             String @id @default(cuid())
  organizationId String

  /// The sensor being polled, e.g. "callgrid".
  provider String
  /// WHICH STREAM from that provider. Coverage is per stream for the same reason
  /// observation is: the calls endpoint being complete says nothing about the
  /// auction reports, and one row covering both would claim what it never read.
  stream   String

  /// The exclusive upper bound of the latest proven interval. A UTC instant.
  completedThrough DateTime

  /// The inclusive lower bound of the interval that last advanced this row.
  ///
  /// Evidence, not state: nothing reads it to make a decision. It is here so an
  /// operator looking at a checkpoint that seems wrong can see the span that set
  /// it without reconstructing it from a log.
  lastIntervalSince DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Tenant-first identity, matching provider_observation_days. One organization's
  /// proven coverage can never satisfy another organization's poll.
  @@unique([organizationId, provider, stream], name: "poll_checkpoint_identity", map: "poll_checkpoint_identity")
  @@map("provider_poll_checkpoints")
}

// ---------------------------------------------------------------------------
// CRM Relationship and Participant (slice R2)
//
// The governed commercial authority: a durable connection somebody ASSERTED, its
// append-only history, and the contextual roles established Parties hold in it.
// The architecture is docs/architecture/relationship-participant.md; the vocabulary,
// lifecycle and grants are `@emgloop/shared` crm-relationship.ts / crm-participant.ts.
//
// VOCABULARIES ARE STRINGS VALIDATED AT THE BOUNDARY, not Prisma enums. Product
// approved the starting kinds and roles as a versioned contract (PD-F-03), and adding
// one is a reviewed contract change -- it must not also be a schema migration on a
// live database. The same device as `CaseParticipant.contribution`.
//
// NOTHING HERE IS INFERRED. No machine writes these tables, no Relationship is
// created to satisfy another record, and no Party reference is ever rewritten --
// including to shorten a supersession chain.
// ---------------------------------------------------------------------------

/// A commercial connection a person asserted exists, or existed.
model CrmRelationship {
  id             String @id @default(cuid())
  organizationId String

  /// Governed kind (CRM_RELATIONSHIP_KINDS). IMMUTABLE: a different kind is a
  /// different fact, corrected by voiding and creating again.
  kind      String
  /// OWN or THIRD_PARTY, stored as written so a read never re-derives it. IMMUTABLE.
  structure String

  /// `crmRelationshipNaturalKey`: the kind and its side Party ids, ordered for a
  /// directed kind and order-free for a symmetric one. Held while ACTIVE or ENDED --
  /// an ended Relationship keeps its key, so renewing reactivates rather than
  /// duplicates -- and NULL once VOIDED, which releases it. Postgres treats NULLs as
  /// distinct, so the unique below binds exactly the non-voided rows.
  nonVoidedNaturalKey String?

  /// The projection of `events`, never an independent truth. `projectionVersion` is
  /// the reducer version that produced it, so a changed reducer is a rebuild rather
  /// than a silent disagreement.
  state             String
  projectionVersion Int    @default(1)
  /// The highest event sequence folded into `state`.
  lastSequence      Int    @default(0)

  label       String?
  description String?
  /// Accountable USER, never a Party. Accountability is a person's, not a company's.
  ownerUserId String?

  /// Business dates: calendar days, or NULL for unknown. Never defaulted to today.
  businessStartDate DateTime? @db.Date
  businessEndDate   DateTime? @db.Date

  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  endedAt         DateTime?
  voidedAt        DateTime?

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?                  @relation("CrmRelationshipOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  createdBy    User?                  @relation("CrmRelationshipCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  events       CrmRelationshipEvent[]
  participants CrmParticipant[]

  @@unique([organizationId, nonVoidedNaturalKey])
  @@index([organizationId, state, createdAt])
  @@index([organizationId, kind, state])
  @@index([organizationId, ownerUserId])
  @@map("crm_relationships")
}

/// The append-only history. Nothing is deleted; removal is END or VOID.
model CrmRelationshipEvent {
  id             String @id @default(cuid())
  organizationId String
  relationshipId String

  /// Monotonic per Relationship. The unique below makes concurrent appends fail
  /// loudly (P2002 -> re-read) instead of silently interleaving -- the same device as
  /// `operational_observations.sequence`.
  sequence Int
  /// CRM_RELATIONSHIP_EVENT_TYPES, validated in `@emgloop/shared`.
  type     String

  /// When it was true in the world, with the basis recorded (Loop Time Authority).
  occurredAt      DateTime
  occurredAtBasis String
  /// When Loop recorded it. Server clock, never the browser's.
  recordedAt      DateTime @default(now())

  /// HUMAN for every act in this authority. A machine may recommend, never perform.
  actorType   String
  actorUserId String?
  /// Required on END and VOID acts, in the actor's own words.
  reason      String?

  /// The Participant an act was about, when it was about one.
  participantId String?

  /// SAFE BEFORE AND AFTER ONLY: states, roles, sides and ids. A name or a contact
  /// value must never be written here -- history outlives the reason it was collected.
  fromState     String?
  toState       String?
  changedFields String[] @default([])

  createdAt DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  relationship CrmRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  actor        User?           @relation("CrmRelationshipEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([relationshipId, sequence])
  @@index([organizationId, relationshipId, sequence], map: "crm_relationship_events_organizationId_relationshipId_sequen_id")
  @@index([organizationId, type, occurredAt])
  @@map("crm_relationship_events")
}

/// An established Party holding a contextual role in a CRM subject, for a time.
model CrmParticipant {
  id             String @id @default(cuid())
  organizationId String

  /// EXCLUSIVE ARC. Exactly one subject, enforced by a CHECK. `opportunityId` and
  /// `campaignId` are added additively when those authorities exist, rather than
  /// forking a participation table per subject.
  relationshipId String?

  /// The Party, by id, inside this organization. Resolved through the Party
  /// Reference contract before it is written and NEVER rewritten afterwards.
  partyId   String
  /// The Party type the authority reported at write time, kept for invariant checks.
  /// It is a RECORD of what the Party authority said, never authority over it.
  partyType String

  /// A contextual commercial capacity or engagement role (CRM_PARTICIPANT_ROLES).
  /// It never determines the Party's type, and a Party type never implies a role.
  role       String
  roleFamily String

  /// Exactly one of these, enforced by a CHECK: the Participant either FILLS a side
  /// the kind declares, or ACTS FOR one.
  side        String?
  actsForSide String?

  state String

  effectiveFrom DateTime? @db.Date
  effectiveTo   DateTime? @db.Date

  /// `crmParticipantActiveKey`: subject, Party and role while ACTIVE; NULL once
  /// ENDED or VOIDED. So at most one active row per (subject, Party, role), while
  /// holding the same role again later writes a NEW row and keeps the old one.
  activeKey String?

  addedByUserId  String?
  addedAt        DateTime  @default(now())
  endedAt        DateTime?
  endedByUserId  String?
  endReason      String?
  voidedAt       DateTime?
  voidedByUserId String?
  voidReason     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  relationship CrmRelationship? @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  addedBy      User?            @relation("CrmParticipantCreator", fields: [addedByUserId], references: [id], onDelete: SetNull)
  endedBy      User?            @relation("CrmParticipantEnder", fields: [endedByUserId], references: [id], onDelete: SetNull)
  voidedBy     User?            @relation("CrmParticipantVoider", fields: [voidedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, activeKey])
  @@index([organizationId, relationshipId, state])
  @@index([organizationId, partyId, state])
  @@map("crm_participants")
}

/// The durable AI usage ledger. One row per invocation ATTEMPT -- answered, refused,
/// rejected or failed alike, because a failure that consumed input tokens cost money
/// and a refusal is a fact about the system.
///
/// WHY A TABLE AND NOT A COUNTER. The S1 gateway reads budgets through an interface
/// backed by an in-memory map. Netlify runs serverless: instances share no memory, so
/// a daily cap enforced per-instance is that cap multiplied by however many instances
/// are warm. That is the webhook replay-map mistake again, and a budget that is
/// decorative is worse than no budget, because it is a control somebody will trust.
///
/// COST STAYS REPRODUCIBLE (Product, 2026-09-16). The row keeps the provider's RAW
/// reported usage and the identifier of the price list it should be valued with. It
/// never bakes a final dollar amount in as the only record, so a corrected price
/// re-values history instead of requiring history to be rewritten.
///
/// NO PROMPT, NO RESPONSE. Storing bodies "for observability" would put customer data
/// and model output in a table whose retention and access rules differ from the
/// sources they came from -- the single change that turns a usage ledger into a
/// privacy incident. This row NAMES the evidence; the evidence is read from its own
/// authority, under its own guard.
model AiInvocation {
  id             String @id @default(cuid())
  organizationId String

  /// Loop's correlation id, STABLE ACROSS RETRIES. Unique per organization, so a
  /// retried attempt updates one row rather than being counted twice against a cap.
  invocationId String

  /// Whose authority assembled the context and triggered the task. Never a service
  /// account: an invocation always traces to a person.
  principalUserId String?

  taskId      String
  taskVersion String
  /// The capability route the task declared (B2): COMMUNICATION, TECHNICAL_ANALYSIS or
  /// GENERAL_REASONING. The column keeps the name of the vocabulary it replaced; rows written
  /// before B2 hold those retired words. Read with `aiLedgerCapabilityOf`.
  profile     String

  providerId           String
  requestedModelId     String
  /// What the provider says actually answered. Not always what was asked for.
  servedModel          String?
  routingPolicyVersion String
  providerRequestId    String?
  /// The provider tried first, when there was one.
  fellBackFrom         String?

  /// The instruction is the largest single influence on an answer, so an unversioned
  /// prompt makes a past answer unexplainable.
  templateId      String
  templateVersion String

  /// A hash of the ORDERED source refs -- never the content. Enough to prove two
  /// invocations saw the same evidence, useless for reconstructing it.
  contextManifestHash String
  contextSourceCount  Int

  /// What Loop RESERVED before dispatch, so concurrent requests cannot each read a
  /// spend-to-date of zero and all pass a cap only one of them should have. These are
  /// Loop's estimate, never a provider's report, and the two are kept apart forever:
  /// a row still carrying only an estimate is a row that never reconciled.
  estimatedInputTokens  Int?
  estimatedOutputTokens Int?

  /// As reported by the provider. NULL where it did not say -- never zero-defaulted,
  /// which would read as "free".
  inputTokens       Int?
  outputTokens      Int?
  cachedInputTokens Int?
  reasoningTokens   Int?

  /// The price list version these tokens should be valued with. The cost authority.
  unitCostBasis       String?
  /// The RESERVE estimate, in integer micros, kept so concurrent requests cannot each
  /// read a spend-to-date of zero. It is an estimate and is never the cost of record.
  estimatedCostMicros Int?

  /// ANSWERED / REFUSED_BY_MODEL / REJECTED_BY_LOOP / FAILED / CANCELLED.
  outcome        String
  /// Loop's own taxonomy, never a provider's prose.
  failureClass   String?
  /// Which contract rules the answer broke.
  rejectionCodes String[]
  attemptCount   Int      @default(1)

  /// Server clock, Loop Time Authority. Never a browser's and never a provider's.
  requestedAt DateTime  @default(now())
  completedAt DateTime?
  latencyMs   Int?

  /// The organization's own reporting day, so a "daily cap" means a day somebody
  /// recognises. It exists because a business-day budget requires it -- it is NOT a
  /// display timezone, and canonical instants above stay UTC.
  businessDate DateTime @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// B4. The Brain job and step this call served, for calls made by Brain work. Both or
  /// neither; `invocationId` is then `brainCallKey(job, step, attempt)` (checked).
  brainJobId                  String?
  brainStepKey                String?
  /// B4. The provider-specialization policy version this call's routing conformed to.
  /// NULL for calls recorded before B4 and for callers that do not report it yet.
  specializationPolicyVersion String?
  /// PR 1 (migration 20261005000000): the capacity lane the call ran in -- FORWARD, SYNTHESIS,
  /// INTERACTIVE or BACKGROUND (capacity.ts). NULL on rows written before it.
  lane                        String?
  /// PR 1: the call's cost in micro-dollars at its route's price list, from the reported usage, written
  /// at reconcile. The daily cost caps sum it; raw usage + unitCostBasis stay the cost of record. NULL
  /// while in flight or when the provider reported no usage.
  costMicros                  Int?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  principal    User?        @relation("AiInvocationPrincipal", fields: [principalUserId], references: [id], onDelete: SetNull)
  brainJob     BrainJob?    @relation(fields: [organizationId, brainJobId], references: [organizationId, id], onDelete: NoAction)

  @@unique([organizationId, invocationId])
  @@index([organizationId, businessDate])
  @@index([organizationId, taskId, requestedAt])
  @@index([organizationId, outcome, requestedAt])
  @@index([organizationId, brainJobId, brainStepKey])
  @@map("ai_invocations")
}

// ---------------------------------------------------------------------------
// Brain durable execution (B4). docs/architecture/brain-persistence.md
//
// Neon is the only authority for Brain work: a job, its history, its steps and
// checkpoints, the questions it asks, the commands that move it and the events it
// tells the rest of Loop. An executor holds a reference and nothing else.
//
// FOUR DECLARATIONS, FOUR SETS OF COLUMNS. What the work needs (capabilityRoute),
// what it produces and who holds it (resultType, resultOwnerAuthority,
// resultSubject*), and how it runs (executionClass, which only promotion changes)
// are never collapsed into one. NO PROVIDER OR MODEL IS PART OF A JOB: routing
// chooses per call, and each call records its choice on ai_invocations.
//
// VOCABULARIES ARE TEXT, validated by @emgloop/shared. Adding a result type, a
// route or an owner is a reviewed contract change, never a migration. CHECK
// constraints in the migration pin only what is structural.
// ---------------------------------------------------------------------------

/// One piece of accepted Brain work, as Loop records it. The executor sees only its
/// id and generation.
model BrainJob {
  id                    String    @id @default(cuid())
  organizationId        String
  /// The person on whose authority the work runs. Fixed at acceptance from a verified
  /// session, and bound to a membership of THIS organization by a composite key.
  principalUserId       String
  taskId                String
  taskVersion           String
  /// What the work needs: COMMUNICATION, TECHNICAL_ANALYSIS or GENERAL_REASONING.
  capabilityRoute       String
  /// What the work produces, who will hold it, and what it is about.
  resultType            String
  resultOwnerAuthority  String
  resultSubjectType     String
  resultSubjectId       String
  /// How the work runs. Only promotion changes it, once, INTERACTIVE to DURABLE.
  executionClass        String
  promotedAt            DateTime?
  state                 String
  /// Increments when the same job is handed to an executor again.
  generation            Int       @default(1)
  /// Optimistic concurrency: every write names the version it read.
  version               Int       @default(0)
  /// The sequence of the last transition written; the next one is this plus one.
  lastSequence          Int       @default(0)
  leaseHolder           String?
  leaseExpiresAt        DateTime?
  cancelRequestedAt     DateTime?
  cancelActorKind       String?
  cancelActorUserId     String?
  cancelActorPolicy     String?
  cancelReason          String?
  endReason             String?
  /// The open question, while and only while the job is WAITING_FOR_USER.
  currentWaitId         String?
  currentWaitExpiresAt  DateTime?
  /// Pointers to where the owner holds the results. Never the results.
  resultRefs            Json      @default("[]")
  /// The task parameters the submission carried: scalars only, never authority.
  input                 Json      @default("{}")
  idempotencyKey        String
  /// SHA-256 of the canonical submission, so a retried request is the same job.
  submissionFingerprint String
  /// The job whose checkpoints this one reuses, in the same organization.
  resumesJobId          String?
  acceptedAt            DateTime  @default(now())
  startedAt             DateTime?
  endedAt               DateTime?
  /// Time spent executing, excluding time spent waiting for a person.
  activeElapsedMs       Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  principalMembership OrganizationMembership @relation("BrainJobPrincipal", fields: [principalUserId, organizationId], references: [userId, organizationId], onDelete: NoAction)
  cancelActor         User?                  @relation("BrainJobCancelActor", fields: [cancelActorUserId], references: [id], onDelete: SetNull)
  resumes             BrainJob?              @relation("BrainJobResumes", fields: [organizationId, resumesJobId], references: [organizationId, id], onDelete: NoAction)
  resumedBy           BrainJob[]             @relation("BrainJobResumes")
  transitions         BrainJobTransition[]
  steps               BrainJobStep[]
  waits               BrainJobWait[]
  commands            BrainCommand[]
  events              BrainEvent[]
  aiInvocations       AiInvocation[]

  @@unique([organizationId, id])
  @@unique([organizationId, principalUserId, taskId, idempotencyKey])
  @@index([organizationId, principalUserId, state])
  @@index([organizationId, resultSubjectType, resultSubjectId, state])
  @@index([state, leaseExpiresAt])
  @@map("brain_jobs")
}

/// The ordered history of a job's state. Append-only; sequence 1 is its acceptance.
model BrainJobTransition {
  id             String   @id @default(cuid())
  organizationId String
  jobId          String
  sequence       Int
  /// ACCEPTED, or the transition event that was applied.
  kind           String
  fromState      String?
  toState        String
  /// The execution class after the transition, so a promotion is visible in history.
  executionClass String
  actorKind      String
  actorUserId    String?
  actorPolicy    String?
  reason         String?
  waitId         String?
  occurredAt     DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          BrainJob     @relation(fields: [organizationId, jobId], references: [organizationId, id], onDelete: Cascade)
  actor        User?        @relation("BrainJobTransitionActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([jobId, sequence])
  @@index([organizationId, jobId, sequence])
  @@map("brain_job_transitions")
}

/// One step of a job, and its checkpoint. A step whose checkpoint exists never runs
/// again. The payload is SEALED before it reaches this table; no plaintext, no
/// credential and no raw prompt or response is ever stored here.
model BrainJobStep {
  id                    String    @id @default(cuid())
  organizationId        String
  jobId                 String
  stepKey               String
  kind                  String
  state                 String
  /// A different input for the same step key is refused, never silently re-run.
  inputFingerprint      String
  attempts              Int       @default(0)
  paidAttempts          Int       @default(0)
  /// Loop's failure class for the last failed attempt. Never a provider's text.
  lastFailureClass      String?
  checkpointSealed      Bytes?
  checkpointKeyRef      String?
  checkpointSealVersion String?
  checkpointSizeBytes   Int?
  checkpointedAt        DateTime?
  startedAt             DateTime?
  endedAt               DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          BrainJob     @relation(fields: [organizationId, jobId], references: [organizationId, id], onDelete: Cascade)

  @@unique([jobId, stepKey])
  @@index([organizationId, jobId])
  @@map("brain_job_steps")
}

/// A question a durable job asked its principal, and the one reply it accepted.
model BrainJobWait {
  id                    String    @id @default(cuid())
  organizationId        String
  jobId                 String
  /// The only person who may answer: the job's principal.
  principalUserId       String
  /// OPEN, ANSWERED, EXPIRED or CLOSED.
  status                String
  /// The job id while OPEN and NULL otherwise, so a job has at most one open question.
  openJobKey            String?
  questionSchemaId      String
  questionSchemaVersion String
  /// The minimal structured question. Never context, evidence or a model transcript.
  question              Json
  expiresAt             DateTime
  requestedAt           DateTime
  responderUserId       String?
  /// The validated reply. Recorded once.
  reply                 Json?
  replyFingerprint      String?
  answeredAt            DateTime?
  closedAt              DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job                 BrainJob               @relation(fields: [organizationId, jobId], references: [organizationId, id], onDelete: Cascade)
  principalMembership OrganizationMembership @relation("BrainJobWaitPrincipal", fields: [principalUserId, organizationId], references: [userId, organizationId], onDelete: NoAction)
  responder           User?                  @relation("BrainJobWaitResponder", fields: [responderUserId], references: [id], onDelete: SetNull)
  commands            BrainCommand[]

  @@unique([organizationId, id])
  @@unique([organizationId, openJobKey])
  @@index([status, expiresAt])
  @@index([organizationId, jobId])
  @@map("brain_job_waits")
}

/// An instruction the Brain API stored with the change it accompanies: START, RESUME
/// or CANCEL. The only thing a doorbell ring can point at.
model BrainCommand {
  id               String    @id @default(cuid())
  organizationId   String
  jobId            String
  type             String
  generation       Int
  /// RESUME only: the wait whose recorded reply wakes the job.
  waitId           String?
  /// One command per identity (`brainCommandDedupeKey`), so storing twice stores once.
  dedupeKey        String
  issuerKind       String
  issuerUserId     String?
  issuerPolicy     String?
  issuedAt         DateTime
  /// First handed to the executor. NULL is what the sweeper looks for.
  dispatchedAt     DateTime?
  lastDispatchedAt DateTime?
  dispatchCount    Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          BrainJob      @relation(fields: [organizationId, jobId], references: [organizationId, id], onDelete: Cascade)
  wait         BrainJobWait? @relation(fields: [organizationId, waitId], references: [organizationId, id], onDelete: Cascade)
  issuer       User?         @relation("BrainCommandIssuer", fields: [issuerUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, dedupeKey])
  @@index([dispatchedAt, issuedAt])
  @@index([organizationId, jobId])
  @@map("brain_commands")
}

/// What a job told the rest of Loop: that its state changed, who caused it, and where
/// its results now live. The allowlisted fields of `BrainJobEvent` and nothing else:
/// no summary, no claim, no model text. Activity reads it; it never owns a result.
model BrainEvent {
  /// `brainEventId(jobId, sequence)`: unique, and derived from the transition it reports.
  id             String   @id
  organizationId String
  jobId          String
  sequence       Int
  name           String
  taskId         String
  resultType     String
  occurredAt     DateTime
  actorKind      String
  actorUserId    String?
  actorPolicy    String?
  resultRefs     Json     @default("[]")
  reason         String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          BrainJob     @relation(fields: [organizationId, jobId], references: [organizationId, id], onDelete: Cascade)
  actor        User?        @relation("BrainEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([jobId, sequence])
  @@index([organizationId, occurredAt, id])
  @@map("brain_events")
}

/// The append-only log of stored AI controls: recorded authority to run or stop AI
/// work. Never a copy of environment configuration. NULL organization = platform.
model AiControl {
  id             String   @id @default(cuid())
  /// `aiControlKey(target)`; the migration checks the derivation.
  controlKey     String
  version        Int
  scope          String
  organizationId String?
  value          String?
  /// ACTIVE or KILLED.
  state          String
  reason         String
  /// HUMAN (a person in an organization) or OPERATIONS (a reviewed operations run).
  actorKind      String
  actorUserId    String?
  actorReference String?
  /// G2 (migration 20261003000001): PROVIDER_POLICY only -- the highest sensitivity class the
  /// provider may receive. Required when ACTIVE, NULL on every other scope (checked).
  ceiling        String?
  /// PR 1 (migration 20261005000000): BUDGET only -- the operating budget's figures (capacity.ts),
  /// a JSON object. Required on a BUDGET row, NULL on every other scope (checked).
  settings       Json?
  recordedAt     DateTime
  createdAt      DateTime @default(now())

  organization Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?              @relation("AiControlActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  currentViews AiControlCurrent[]

  @@unique([controlKey, version])
  @@index([organizationId, recordedAt])
  @@map("ai_controls")
}

/// The current version of each control. It points at its log entry, so it can never
/// claim a state the log does not hold; it is written in the same transaction.
model AiControlCurrent {
  controlKey     String   @id
  version        Int
  scope          String
  organizationId String?
  value          String?
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entry        AiControl     @relation(fields: [controlKey, version], references: [controlKey, version], onDelete: Cascade)

  @@index([organizationId])
  @@map("ai_control_current")
}

// ===========================================================================
// GOOGLE WORKSPACE CONNECTION (Private V1)
//
// docs/architecture/google-workspace-connection.md §11. A person connects THEIR OWN
// Google account from inside a Loop session, one capability at a time (Gmail metadata,
// Calendar events read-only, Drive metadata). Connecting is not signing in, and nothing
// here is read to decide who a Loop user is.
// ===========================================================================

/// One Google connection per Loop user per organization.
///
/// BELONGS TO A MEMBERSHIP. The composite key binds the row to the person's membership in
/// THIS organization, so a connection can never be filed under another organization or
/// outlive the membership row it was made through.
///
/// REVOKE MEANS DELETE. The sealed refresh token is present only while CONNECTED. A revoked
/// or expired connection keeps its lifecycle columns and its audit trail, and no
/// credential. Google's own text is never stored: failures are classes.
///
/// THE TOKEN IS SEALED. AES-256-GCM with a key only the web tier holds (never in the
/// database), bound to organization, user, Google account and purpose, so a sealed token
/// copied to another row does not open.
///
/// SCOPES ARE PINNED IN THE DATABASE. A CHECK admits only the three approved capability
/// scopes in `grantedScopes` and `requestedScopes`; a broader grant cannot be recorded even
/// by a caller that skipped the contract.
model GoogleConnection {
  id                    String    @id @default(cuid())
  organizationId        String
  userId                String
  /// The ID token's `sub` last linked: stable and never reused, and never the email. Kept
  /// after revocation for the audit trail.
  googleSubject         String
  /// `googleSubject` while the connection is live (CONNECTED or EXPIRED), NULL once
  /// revoked. Unique per organization, so one Google account is linked to at most one Loop
  /// user there at a time; Postgres treats NULLs as distinct.
  activeGoogleSubject   String?
  /// Display only, as Google reported it at link time. Never an identifier.
  emailAtLink           String
  /// The Workspace domain, or NULL for an account outside any Workspace.
  hostedDomain          String?
  /// CONNECTED, EXPIRED or REVOKED (`GOOGLE_CONNECTION_STATUSES` in @emgloop/shared).
  status                String
  /// The capability scopes Google granted, exactly as reported.
  grantedScopes         String[]  @default([])
  /// The capability scopes the person asked for on this connection. A requested scope that
  /// was not granted is a declined capability (INSUFFICIENT_SCOPE).
  requestedScopes       String[]  @default([])
  /// The sealed refresh token, with its format and key reference. NULL unless CONNECTED.
  refreshTokenSealed    Bytes?
  sealVersion           String?
  keyRef                String?
  /// When the current grant was stored.
  connectedAt           DateTime
  lastUsedAt            DateTime?
  /// When Google refused the stored grant and Loop stopped using it.
  expiredAt             DateTime?
  /// `GOOGLE_CONNECTION_FAILURE_CLASSES`. Never Google's text.
  lastFailureClass      String?
  revokedAt             DateTime?
  revokedByUserId       String?
  /// `GOOGLE_REVOCATION_REASONS`.
  revocationReason      String?
  /// When Google confirmed the revocation. NULL on a revoked row means Loop deleted its
  /// copy but Google did not confirm (see `lastFailureClass`).
  revocationConfirmedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   OrganizationMembership @relation("GoogleConnectionMember", fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)
  revokedBy    User?                  @relation("GoogleConnectionRevoker", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@unique([organizationId, activeGoogleSubject])
  @@map("google_connections")
}

/// One attempt to connect Google: the OAuth `state`, single-use and short-lived.
///
/// BOUND TO WHO STARTED IT. Organization, user AND the browser session: the callback is
/// honoured only in the same session, within ten minutes, once. Only hashes of the state
/// and nonce are stored; the values travel through Google and back and nowhere else.
model GoogleOAuthState {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  sessionId      String
  /// SHA-256 (hex) of the state value.
  stateHash      String    @unique
  /// SHA-256 (hex) of the nonce Google must return in the ID token.
  nonceHash      String
  /// The capabilities this attempt asked for.
  capabilities   String[]
  /// ONBOARDING or CONNECTIONS: where the callback returns the person. Never read from the callback.
  returnTo       String
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   OrganizationMembership @relation("GoogleOAuthStateMember", fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)
  session      UserSession            @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, expiresAt])
  @@map("google_oauth_states")
}

/// A managed creator's OWN TikTok account, connected through Login Kit (Web) to their Creator
/// Hub profile. The TikTok sibling of GoogleConnection: same discipline, same shape, NOT a
/// second connection framework. One per member per organization; the creator seat (the
/// CreatorProfile bound to the login) authorizes every use of it.
///
/// REVOKE MEANS DELETE. The sealed tokens are present only while CONNECTED. A revoked or
/// expired connection keeps its lifecycle columns and its audit trail, and no credential.
/// TikTok's own text is never stored: failures are classes.
///
/// TWO SEALED TOKENS. TikTok issues a 24-hour access token and a 365-day refresh token that
/// ROTATES on every refresh. Both are sealed (AES-256-GCM, key LOOP_TIKTOK_TOKEN_KEY held only by
/// the web tier, never in the database), bound to organization, user, TikTok account and purpose.
///
/// SCOPES ARE PINNED IN THE DATABASE. A CHECK admits only the four registered scopes in
/// `grantedScopes` and `requestedScopes`; a broader grant cannot be recorded even by a caller
/// that skipped the contract.
model TikTokConnection {
  id                    String    @id @default(cuid())
  organizationId        String
  userId                String
  /// TikTok's `open_id` for this app: stable, app-scoped, never the username. Kept after
  /// revocation for the audit trail.
  tiktokOpenId          String
  /// `tiktokOpenId` while the connection is live (CONNECTED or EXPIRED), NULL once revoked.
  /// Unique per organization, so one TikTok account is linked to at most one Loop user there
  /// at a time; Postgres treats NULLs as distinct.
  activeTiktokOpenId    String?
  /// The `username` TikTok reported at link time, when `user.info.profile` was granted. Display only.
  handleAtLink          String?
  /// CONNECTED, EXPIRED or REVOKED (`TIKTOK_CONNECTION_STATUSES` in @emgloop/shared).
  status                String
  /// The scopes TikTok granted, exactly as reported (comma-separated there, one per element here).
  grantedScopes         String[]  @default([])
  /// The scopes this connection asked for. A requested scope that was not granted was declined
  /// on TikTok's screen (the connection reads PARTIAL).
  requestedScopes       String[]  @default([])
  /// The sealed refresh token. NULL unless CONNECTED.
  refreshTokenSealed    Bytes?
  /// The sealed access token and when TikTok said it expires. Present exactly when the refresh
  /// token is; a fresh one is fetched (and the refresh token rotated) when it is about to expire.
  accessTokenSealed     Bytes?
  accessTokenExpiresAt  DateTime?
  sealVersion           String?
  keyRef                String?
  /// When the current grant was stored.
  connectedAt           DateTime
  /// The last time a token was used to call TikTok.
  lastUsedAt            DateTime?
  /// The last COMPLETED read of the account's facts (user info, and videos when granted).
  lastReadAt            DateTime?
  /// When TikTok refused the stored grant and Loop stopped using it.
  expiredAt             DateTime?
  /// `TIKTOK_CONNECTION_FAILURE_CLASSES`. Never TikTok's text.
  lastFailureClass      String?
  revokedAt             DateTime?
  revokedByUserId       String?
  /// `TIKTOK_REVOCATION_REASONS`.
  revocationReason      String?
  /// When TikTok confirmed the revocation. NULL on a revoked row means Loop deleted its copy
  /// but TikTok did not confirm (see `lastFailureClass`).
  revocationConfirmedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   OrganizationMembership @relation("TikTokConnectionMember", fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)
  revokedBy    User?                  @relation("TikTokConnectionRevoker", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@unique([organizationId, activeTiktokOpenId])
  @@map("tiktok_connections")
}

/// One attempt to connect TikTok: the OAuth `state`, single-use and short-lived.
///
/// BOUND TO WHO STARTED IT. Organization, user AND the browser session: the callback is
/// honoured only in the same session, within ten minutes, once. Only the hash of the state is
/// stored; the value travels through TikTok and back and nowhere else. There is no nonce: TikTok
/// issues no ID token, and the account is named by the token endpoint's `open_id`.
model TikTokOAuthState {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  sessionId      String
  /// SHA-256 (hex) of the state value.
  stateHash      String    @unique
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   OrganizationMembership @relation("TikTokOAuthStateMember", fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)
  session      UserSession            @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, expiresAt])
  @@map("tiktok_oauth_states")
}

/// A person's OWN background conversation source: Microsoft Teams or Telegram, connected by
/// that person, in ONE organization, and readable only by them (source-connection.ts;
/// docs/architecture — Connections). It is the Teams/Telegram sibling of GoogleConnection and
/// follows the same discipline; it does NOT fork a second connection framework.
///
/// USER-PRIVATE, NOT MERELY ORGANIZATION-FIRST. Both ids are on the row and the repository takes
/// both: there is no org-only read path. Employee-private by default -- no promotion of a private
/// match to organization scope happens here.
///
/// THE STATE IS DERIVED, NEVER ASSERTED. `state` comes from capability facts via
/// deriveConnectionState: authentication alone is never READY. A claimed background capability that
/// a provider restriction blocks leaves the connection CONNECTED_LIMITED, stated honestly.
///
/// THE CREDENTIAL IS SEALED. AES-256-GCM with a key the database never holds, bound to
/// organization, user, provider and credential kind, so a sealed secret copied to another row does
/// not open. The provider's own text is never stored: failures are classes. No message content --
/// no subject, body, title or display name -- has a column here, by design.
///
/// ONE CONNECTION PER PROVIDER PER PERSON. `@@unique([organizationId, userId, provider])`: an
/// employee sees exactly one Microsoft Teams tile and one Telegram tile. The Teams `adapter`
/// (GRAPH vs INTERACTIVE_SESSION) is an internal detail chosen after authentication.
model SourceConnection {
  id                    String    @id @default(cuid())
  organizationId        String
  userId                String
  /// MICROSOFT_TEAMS | TELEGRAM (CONNECTION_PROVIDERS in @emgloop/shared).
  provider              String
  /// Internal Teams adapter: GRAPH | INTERACTIVE_SESSION (TEAMS_ADAPTERS). Chosen after
  /// authentication; NULL until known. Never surfaced to the employee.
  adapter               String?
  /// Truthful headline state (CONNECTION_STATES). Derived from capability facts.
  state                 String    @default("NOT_CONNECTED")
  /// OAUTH_REFRESH_TOKEN | MTPROTO_SESSION (CONNECTION_CREDENTIAL_KINDS). NULL until a credential
  /// is held.
  credentialKind        String?
  /// The sealed credential, with its format and key reference. NULL unless a live credential is held.
  secretSealed          Bytes?
  sealVersion           String?
  keyRef                String?
  /// Display only, as the provider reported it at connect time (an account label / handle). Never an
  /// identifier Loop keys on, and never message content.
  accountLabel          String?
  /// Whether the claimed background-observation capability is operational (CAPABILITY_STATUSES:
  /// OPERATIONAL | GATED | UNAVAILABLE). GATED keeps the connection CONNECTED_LIMITED, honestly.
  backgroundObservation String    @default("UNAVAILABLE")
  /// Opaque per-connection observation cursor (the worker's resume point). Never content.
  cursor                String?
  /// Last failure class (CONNECTION-level), never the provider's text.
  lastFailureClass      String?
  connectingStartedAt   DateTime?
  connectedAt           DateTime?
  lastObservedAt        DateTime?
  reconnectRequiredAt   DateTime?
  disconnectedAt        DateTime?
  disconnectedByUserId  String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership     OrganizationMembership @relation("SourceConnectionMember", fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)
  disconnectedBy User?                  @relation("SourceConnectionDisconnector", fields: [disconnectedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId, provider])
  @@index([organizationId, state])
  @@map("source_connections")
}

/// A content-free observation from a background source (Teams, Telegram): WHO a conversation was
/// between and WHEN, never what was said. This is the durable landing place for the metadata the
/// worker normalizes (ConversationEvent), so the who/when signal is not thrown away before Loop can
/// turn it into cross-source intelligence -- and it is minimized and governed, not a message mirror.
///
/// GOVERNED RETENTION, BY SHAPE AND BY POLICY. There is NO column that can hold message text, a
/// subject, a title, media, a caption, a chat name or a person's name. Identifiers are one-way HMAC
/// keys (conversationKey, senderKey, participantKeys), never raw ids. `hadText` is a boolean, never
/// the text. Rows are purged past a retention horizon (SourceObservationRepository.purgeOlderThan),
/// and they belong to the membership, so offboarding removes them with the person.
///
/// EMPLOYEE-PRIVATE. Both ids are on the row and every repository method takes both; there is no
/// org-only read path. IDEMPOTENT: unique on (org, user, provider, providerEventId), so the worker
/// can re-observe after a failure without duplicating -- the cursor never has to outrun this store.
model SourceObservation {
  id              String   @id @default(cuid())
  organizationId  String
  userId          String
  /// MICROSOFT_TEAMS | TELEGRAM (CONNECTION_PROVIDERS).
  provider        String
  /// The provider's stable id for this event, keyed so it never carries a raw chat id
  /// (`<conversationKey>:<messageId>`). Unique per (org, user, provider) for idempotency.
  providerEventId String
  /// One-way HMAC key for the conversation; never the raw chat/peer id.
  conversationKey String
  /// One-way HMAC key for the sender; NULL when the provider did not say. Never a raw id.
  senderKey       String?
  /// One-way HMAC keys for the known participants; never raw ids, never names.
  participantKeys String[] @default([])
  /// INBOUND | OUTBOUND | UNKNOWN.
  direction       String
  /// Whether the message had text -- the boolean only, never the text.
  hadText         Boolean
  /// When it happened, per the provider (UTC).
  occurredAt      DateTime
  /// When Loop observed it (UTC).
  observedAt      DateTime
  createdAt       DateTime @default(now())

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   OrganizationMembership @relation("SourceObservationMember", fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)

  @@unique([organizationId, userId, provider, providerEventId])
  @@index([organizationId, userId, provider, occurredAt])
  @@index([observedAt])
  @@map("source_observations")
}

/// A GOVERNED HISTORICAL BASELINE checkpoint for a background source (Telegram, Slice 1). It walks a
/// connection's history BACKWARD from the connect point to an employee-chosen floor, landing the SAME
/// content-free SourceObservation rows the live sweep does (who/when only, never content) -- but on a
/// checkpoint that is COMPLETELY INDEPENDENT of the live observation cursor (SourceConnection.cursor).
/// The baseline code path never writes that live cursor; it advances only `checkpointCursor` here.
///
/// EMPLOYEE-SELECTED DEPTH, BOUNDED. `windowDays` is one of an allowlist [30, 90, 180, 365] (there is
/// no all-time option); `windowFloorAt` is the precomputed instant the walk stops at. The employee can
/// change the window or revoke it; REVOKED stops further processing immediately, and already-written
/// observations expire only via the existing retention policy (baseline depth is not retention).
///
/// EMPLOYEE-PRIVATE, ONE PER PROVIDER. Both ids are on the row and every repository method takes both.
/// The composite foreign key is to the MEMBERSHIP, so offboarding cascades this away with the person.
/// No message content, no name, no raw id: `checkpointCursor` is an opaque backward offset, never content.
model SourceBaselineCheckpoint {
  id             String @id @default(cuid())
  organizationId String
  userId         String
  /// MICROSOFT_TEAMS | TELEGRAM (CONNECTION_PROVIDERS). Only TELEGRAM is walked in Slice 1.
  provider       String

  /// Employee-selected depth, one of SOURCE_CONNECTION_BASELINE_WINDOWS ([30, 90, 180, 365]).
  windowDays    Int
  /// The instant the backward walk stops at: (connectedAt ?? consentAt) minus windowDays. Never content.
  windowFloorAt DateTime
  /// When the employee authorized (or last re-scoped) this baseline.
  consentAt     DateTime

  /// NOT_STARTED | IN_PROGRESS | COMPLETE | REVOKED (BASELINE_STATES, deriveBaselineState).
  state            String    @default("NOT_STARTED")
  /// Opaque BACKWARD offset the walk resumes from. NEVER content, and NEVER the live observation cursor.
  checkpointCursor String?
  /// The oldest occurredAt the walk has reached so far (for honest progress). Never content.
  oldestReachedAt  DateTime?

  startedAt        DateTime?
  completedAt      DateTime?
  lastRunAt        DateTime?
  /// Last failure class (AUTH | TRANSIENT | SINK_UNAVAILABLE | FLOOD_WAIT). Never a provider's text.
  lastFailureClass String?
  /// Set when Telegram asked Loop to wait (FLOOD_WAIT): the checkpoint holds until then.
  backoffUntil     DateTime?
  revokedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   OrganizationMembership @relation("SourceBaselineCheckpointMember", fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)

  @@unique([organizationId, userId, provider])
  @@index([state, lastRunAt])
  @@map("source_baseline_checkpoints")
}

/// EMPLOYEE CONTENT-PROCESSING CONSENT for a background source (Telegram, content-triage slice). This
/// is the employee's EXPLICIT, revocable authorization for Loop to read message CONTENT transiently and
/// have AI decide whether a new inbound message is meaningfully actionable. It is a SEPARATE consent
/// from connecting the source and from the content-free history baseline: connection alone is NOT this
/// consent, and this table is the only place that consent is recorded.
///
/// NO CONTENT, EVER. `contentCursor` is an opaque content-free message id (the worker's resume point
/// for the content sweep) -- never a message, a name or a raw id. There is no column that can hold a
/// body. The AI reads bodies transiently in the worker and drops them; nothing content-bearing lands here.
///
/// EMPLOYEE-PRIVATE, ONE PER PROVIDER. Both ids are on the row and every repository method takes both.
/// The composite foreign key is to the MEMBERSHIP, so offboarding cascades this away with the person.
/// Authorized means `authorizedAt` set and `revokedAt` null; a revoke stamps `revokedAt` and stops all
/// further content processing immediately. The content sweep NEVER writes the live observation cursor
/// or the baseline checkpoint -- it advances only `contentCursor` here.
model SourceContentAuthorization {
  id             String @id @default(cuid())
  organizationId String
  userId         String
  /// MICROSOFT_TEAMS | TELEGRAM (CONNECTION_PROVIDERS). Only TELEGRAM is triaged in this slice.
  provider       String

  /// When the employee authorized (or last re-affirmed) content processing.
  authorizedAt DateTime
  /// Set when the employee withdrew consent. Non-null means REVOKED: no further content is processed.
  revokedAt    DateTime?

  /// Opaque content-free message id the content sweep resumes from. NEVER content, and NEVER the live
  /// observation cursor or the baseline checkpoint.
  contentCursor    String?
  lastRunAt        DateTime?
  /// Last failure class (AUTH | TRANSIENT | PROVIDER_NOT_CONFIGURED | FLOOD_WAIT | REFUSED_BY_LOOP, the
  /// last suffixed with the specific AiAdmissionRefusal(s), e.g. REFUSED_BY_LOOP:BUDGET_TASK_EXHAUSTED).
  /// A class, never a provider's text and never a secret.
  lastFailureClass String?
  /// Set when the provider asked Loop to wait (FLOOD_WAIT): the sweep holds until then.
  backoffUntil     DateTime?

  /// v2 CONVERSATION-TRIAGE HISTORICAL BACKFILL. These columns track a one-off, resumable transient read
  /// of the ALREADY-IMPORTED recent window (the baseline's floor), surfacing obligations still unresolved
  /// without waiting for a new message. They are advanced ONLY by the historical content sweep and are
  /// PROVABLY INDEPENDENT of every other cursor: NEVER the live observation cursor (source_connections),
  /// NEVER the baseline checkpoint (source_baseline_checkpoints), and NEVER the forward contentCursor above.
  /// NOT_STARTED | IN_PROGRESS | COMPLETE (a revoke stops it via revokedAt). No content column is added.
  historicalState            String    @default("NOT_STARTED")
  /// Opaque DIALOG-pagination frontier the historical sweep resumes from. NEVER content, and DISTINCT from
  /// the live cursor, the baseline checkpoint and the forward contentCursor.
  historicalCursor           String?
  /// The instant the backfill's transient reads stop at (the baseline window floor, set when enabled).
  historicalWindowFloorAt    DateTime?
  /// The oldest conversation activity the backfill has reached so far (honest progress). Never content.
  historicalOldestReachedAt  DateTime?
  historicalLastRunAt        DateTime?
  /// Last historical failure class (AUTH | TRANSIENT | PROVIDER_NOT_CONFIGURED | FLOOD_WAIT | REFUSED_BY_LOOP,
  /// the last suffixed with the specific AiAdmissionRefusal(s), exactly as `lastFailureClass` above).
  historicalLastFailureClass String?
  /// Set when the provider asked Loop to wait (FLOOD_WAIT): the historical sweep holds until then.
  historicalBackoffUntil     DateTime?
  /// Conversations the backfill advanced past on a PERMANENT triage failure -- counted, never silently lost.
  historicalFailedItems      Int       @default(0)

  /// CHATS INTELLIGENCE INITIALIZATION ("hydration", 2026-09-25). A DIGEST-ONLY, one-off, resumable pass
  /// that gives an already-authorized person a CHATS digest per recent conversation without waiting for a
  /// new message. It writes ONLY digests -- never a WorkItem, never a reconciliation -- and is advanced ONLY
  /// by the hydration sweep: PROVABLY INDEPENDENT of the live cursor, the baseline checkpoint, the forward
  /// contentCursor and the historicalCursor. NOT_STARTED | IN_PROGRESS | COMPLETE (DB CHECK). Existing rows
  /// default to NOT_STARTED, so every authorized person is eligible with no re-authorization. A revoke stops
  /// it via revokedAt; a re-authorization after a revoke resets it to NOT_STARTED.
  intelligenceHydrationState            String    @default("NOT_STARTED")
  /// Opaque DIALOG-pagination frontier the hydration sweep resumes from. Distinct from every other cursor.
  intelligenceHydrationCursor           String?
  intelligenceHydrationLastRunAt        DateTime?
  /// Last hydration failure class (AUTH | TRANSIENT | FLOOD_WAIT | HYDRATION_BUDGET_RESERVE |
  /// REFUSED_BY_LOOP[:refusals] | CONSENT_NOT_IN_FORCE | NOT_AN_ACTIVE_MEMBER | NOT_MIGRATED). A class, never text.
  intelligenceHydrationLastFailureClass String?
  /// Set when the provider asked Loop to wait (FLOOD_WAIT): the hydration sweep holds until then.
  intelligenceHydrationBackoffUntil     DateTime?
  /// Conversations passed over on a PERMANENT triage failure -- counted, never silently lost (forward
  /// triage still reads them when a new message arrives).
  intelligenceHydrationFailedItems      Int       @default(0)
  /// The triage output schema a COMPLETED hydration covered (e.g. telegram-content-triage.v4). Recorded so a
  /// future schema bump can decide to re-arm by comparison; nothing re-arms on it today.
  intelligenceHydrationSchemaId         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   OrganizationMembership @relation("SourceContentAuthorizationMember", fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)

  @@unique([organizationId, userId, provider])
  @@index([revokedAt, lastRunAt])
  @@index([historicalState, historicalLastRunAt])
  @@index([intelligenceHydrationState, intelligenceHydrationLastRunAt], map: "source_content_authorizations_hydration_due_idx")
  @@map("source_content_authorizations")
}

// ---------------------------------------------------------------------------
// Loop Intelligence -- DOMAIN INTELLIGENCE digests (PR A, approved 2026-09-24)
//
// AUTHORITATIVE EVIDENCE -> DOMAIN INTELLIGENCE (this) -> domain UI / Briefing -> Headlines ->
// Investigation -> Work. Intelligence is NOT Work. One current row per subject, overwritten on
// regeneration: a REBUILDABLE PROJECTION of evidence kept elsewhere, never truth. PRINCIPAL-private;
// ORGANIZATION scope is reserved and refused by a CHECK and by the repository. Nothing writes it in
// PR A. See IntelligenceDigestRepository and @emgloop/shared intelligence-digest.ts.
// ---------------------------------------------------------------------------

model IntelligenceDigest {
  id             String    @id @default(cuid())
  organizationId String
  /// PRINCIPAL (one person's) or ORGANIZATION (governed Loop records only; checked: no user, no
  /// provider, basis LOOP_RECORDS, never CHATS/MAIL/CALENDAR). PR 2, 2026-09-26.
  scope          String
  /// Required for PRINCIPAL, null for ORGANIZATION (checked). With organizationId, a composite FK to the membership.
  userId         String?
  /// A domain of @emgloop/shared INTELLIGENCE_DOMAIN_REGISTRY (the database checks the pattern only).
  domain         String
  /// CONVERSATION, THREAD, DOMAIN, ENTITY or EVENT.
  subjectKind    String
  /// A keyed reference, never a raw provider id. 'domain' for a DOMAIN rollup.
  subjectRef     String
  /// The source provider (TELEGRAM, GMAIL, ...): how a consent revoke finds these rows.
  provider       String?
  /// Minimized structured intelligence (DigestContent). Bounded; never a body, text, quote or message.
  content        Json
  /// The coverage contract value recorded at generation.
  coverage       String
  windowStart    DateTime
  windowEnd      DateTime
  evidenceCount  Int
  lastEvidenceAt DateTime?
  /// Keyed source refs, anchor event ids, aiInvocationId, taskId, taskVersion, schemaId, producerVersion.
  provenance     Json
  aiInvocationId String?
  /// Canonical entity references (@emgloop/shared entity-ref.ts), at most 32. PR 2, 2026-09-26.
  /// The default is the DATABASE's (dbgenerated), deliberately not Prisma's `@default([])`: a client-side
  /// default is SENT on every create, so code deployed before the migration would name a column the
  /// database does not have yet. (`prisma migrate diff` always re-proposes a same-value SET DEFAULT for a
  /// dbgenerated array default -- a known Prisma limitation, harmless.)
  entityRefs     String[]  @default(dbgenerated("ARRAY[]::TEXT[]"))
  /// Changes only when the digest's meaning changes; an unchanged fingerprint writes nothing.
  fingerprint    String
  version        Int       @default(1)
  /// CURRENT, STALE or WITHDRAWN.
  status         String
  generatedAt    DateTime
  /// Stamped at write from the retention policy; the worker's sweep deletes past it.
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   OrganizationMembership? @relation("IntelligenceDigestMember", fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)

  // Uniqueness is per scope, by two PARTIAL unique indexes Prisma cannot express (migration
  // 20261006000000_intelligence_org_digests): (org, user, domain, subject) WHERE scope = 'PRINCIPAL' and
  // (org, domain, subject) WHERE scope = 'ORGANIZATION'. This plain index is the lookup beside them.
  @@index([organizationId, userId, domain, subjectKind, subjectRef])
  @@index([organizationId, userId, domain, status])
  @@index([organizationId, scope, domain, status])
  @@index([entityRefs], type: Gin)
  @@index([organizationId, userId, provider])
  @@index([expiresAt])
  @@map("intelligence_digests")
}

// ---------------------------------------------------------------------------
// Daily Loop -- one employee's own work state (DL-1)
//
// docs/architecture/daily-loop-employee-intelligence.md §17.
//
// USER-FIRST, NOT MERELY ORGANIZATION-FIRST. Every table here belongs to ONE PERSON
// inside one organization, and is readable only by that person: not by OWNER, not by
// ADMIN, not by a report, not by an aggregate. Both ids are on every row, and every
// repository method takes both -- there is no org-only read path, by construction.
//
// The composite foreign key is to the MEMBERSHIP, so a row cannot be filed under an
// organization the person does not belong to, and offboarding cascades these away.
//
// WHAT IS NOT HERE, DELIBERATELY: no message body, no snippet, no attachment, no file
// content -- under the current grant there is nothing to store, and a nullable column
// would be an invitation. Stage 2 adds what it earns, in the migration that says so.
// ---------------------------------------------------------------------------

/// Where ingestion got to, per person per source. Advanced monotonically; never reset by a
/// setter (the ProviderPollCheckpoint discipline).
model WorkSourceCursor {
  id             String @id @default(cuid())
  organizationId String
  userId         String

  /// `WORK_SOURCES`.
  source     String
  /// `WORK_CURSOR_KINDS` -- what the value means for this source.
  cursorKind String?
  /// Gmail historyId / Calendar syncToken / Drive pageToken. Opaque here.
  cursor     String?

  lastSyncStartedAt   DateTime?
  lastSyncCompletedAt DateTime?
  /// `WORK_SYNC_FAILURE_CLASSES`. Never a provider's text.
  lastFailureClass    String?
  /// Set when the provider asked Loop to wait. Nothing reads it until DL-3.
  backoffUntil        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   OrganizationMembership @relation("WorkSourceCursorMember", fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)

  @@unique([organizationId, userId, source])
  @@map("work_source_cursors")
}

/// One ingestion pass, recorded so a stalled pipeline is visible without opening the database.
model WorkSyncRun {
  id             String @id @default(cuid())
  organizationId String
  userId         String

  /// `WORK_SOURCES`.
  source       String
  startedAt    DateTime
  finishedAt   DateTime?
  /// `WORK_SYNC_OUTCOMES`. NULL while the run is in flight.
  outcome      String?
  /// How many provider records this pass looked at, and how many rows it wrote. NULL means
  /// not measured -- never 0, which is a different claim.
  examined     Int?
  written      Int?
  /// `WORK_SYNC_FAILURE_CLASSES`, set only on a FAILED run.
  failureClass String?

  createdAt DateTime @default(now())

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   OrganizationMembership @relation("WorkSyncRunMember", fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)

  @@index([organizationId, userId, startedAt])
  @@map("work_sync_runs")
}

/// An address this employee corresponds with. NOT a Party, NOT a CRM contact, and never
/// automatically either: turning one into canonical identity is a governed act under
/// `identityResolution` (§11.1). The address is stored hashed for matching, with the
/// readable form beside it because a person must recognise who it is.
model WorkCorrespondent {
  id             String @id @default(cuid())
  organizationId String
  userId         String

  /// SHA-256 of the normalized address. The join key; a raw address never goes here.
  addressHash    String
  /// The readable address and the display name the sender chose. Labels, never identity.
  displayAddress String
  displayName    String?
  /// The address domain, lower-cased. Evidence for a company, never a company fact.
  domain         String?

  firstSeenAt   DateTime
  lastSeenAt    DateTime
  inboundCount  Int      @default(0)
  outboundCount Int      @default(0)
  /// Set by the person's own correction ("never flag this sender"). Per employee, reversible.
  suppressed    Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   OrganizationMembership @relation("WorkCorrespondentMember", fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)

  @@unique([organizationId, userId, addressHash])
  @@index([organizationId, userId, domain])
  @@index([organizationId, userId, lastSeenAt])
  @@map("work_correspondents")
}

/// A mail conversation: THE unit of everything Daily Loop does, because a person thinks in
/// conversations and because it is the cache key that keeps Stage 2 affordable (§14.4 seam 1).
model WorkThread {
  id             String @id @default(cuid())
  organizationId String
  userId         String

  /// `WORK_PROVIDERS` and the provider's own thread id.
  provider String
  threadId String

  /// The sender's words. Treated as COMMUNICATION_CONTENT even though the metadata scope
  /// permits it (§17.4).
  subject           String?
  /// Correspondent address hashes on the thread. Hashes, so a join never needs the address.
  participantHashes String[]  @default([])
  messageCount      Int       @default(0)
  firstMessageAt    DateTime?
  lastMessageAt     DateTime?
  /// `WORK_DIRECTIONS` -- which way the newest message went.
  lastDirection     String?
  /// The newest message's provider id. With `threadId` it is the change gate: unchanged
  /// means nothing to recompute, and at Stage 2 nothing to re-analyse.
  lastMessageId     String?
  labels            String[]  @default([])

  /// `WORK_CLASSES`, and the version of the rule that decided it. DL-8 writes these; DL-1
  /// leaves them null rather than guessing.
  derivedClass       String?
  classRuleVersion   String?
  /// The rhythm this pair actually keeps, in minutes. NULL means not enough history -- not zero.
  medianReplyMinutes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   OrganizationMembership @relation("WorkThreadMember", fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)

  @@unique([organizationId, userId, provider, threadId])
  @@index([organizationId, userId, derivedClass, lastMessageAt])
  @@index([organizationId, userId, lastMessageAt])
  @@map("work_threads")
}

/// One message's METADATA. There is deliberately no body column, no snippet and no
/// attachment: adding one requires a migration that says so out loud.
model WorkMessage {
  id             String @id @default(cuid())
  organizationId String
  userId         String

  provider  String
  messageId String
  threadId  String

  /// The provider's own timestamp for the message.
  internalDate    DateTime
  /// `WORK_DIRECTIONS`.
  direction       String
  /// Header roles, as correspondent hashes.
  fromHash        String?
  toHashes        String[] @default([])
  ccHashes        String[] @default([])
  subject         String?
  /// RFC 5322 threading headers, kept so a conversation can be reconstructed without Gmail --
  /// and so a reply can be threaded correctly without asking Gmail for the thread again.
  headerMessageId String?
  inReplyTo       String?
  /// The `References` chain, in order. Header identifiers only: no address and no content.
  references      String[] @default([])
  labels          String[] @default([])
  /// When Loop read it, as against when it was sent.
  observedAt      DateTime @default(now())

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   OrganizationMembership @relation("WorkMessageMember", fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)

  @@unique([organizationId, userId, provider, messageId])
  @@index([organizationId, userId, threadId, internalDate])
  @@map("work_messages")
}

/// One reply an employee is writing, or has sent, from inside Loop (GM-2).
///
/// IT HOLDS THE EMPLOYEE'S OWN WORDS, not correspondence: everything here was typed by them or
/// proposed to them and then accepted by them. That is why it is the one place Loop stores a
/// message body at all -- and why the body is CLEARED the moment it is sent, since from then on
/// the message lives in Gmail and comes back as an ordinary SENT message on the next sync.
///
/// ONE OPEN DRAFT PER THREAD PER PERSON, so a half-written reply survives navigation and cannot
/// be duplicated by a retry. A send CLAIMS the row before calling Gmail; a claim that has not
/// completed blocks a second send rather than racing it.
model WorkDraft {
  id             String @id @default(cuid())
  organizationId String
  userId         String

  /// `WORK_PROVIDERS` and the conversation this reply belongs to.
  provider           String
  threadId           String
  /// The message being replied to, and the headers that keep the reply in the conversation.
  inReplyToMessageId String
  /// `WORK_REPLY_MODES`.
  mode               String

  /// Recipients as the employee will send them. CONTACT_IDENTIFIER, never a hash: a person has
  /// to be able to read and edit who they are writing to.
  toAddresses String[] @default([])
  ccAddresses String[] @default([])
  subject     String?
  /// The employee's own words. Empty once sent.
  body        String   @default("")

  /// `WORK_DRAFT_SOURCES` -- typed, or proposed by Loop and then edited by a person.
  source         String  @default("MANUAL")
  /// Provenance when Loop proposed it: the invocation that produced it, and the task version.
  aiInvocationId String?
  aiTaskVersion  String?
  /// True while the employee has not changed a proposed draft. Presentation only; never authority.
  aiUnedited     Boolean @default(false)

  /// `WORK_DRAFT_SEND_STATES`: DRAFT, SENDING, SEND_UNKNOWN, SENT. There is no time-based way out
  /// of SENDING or SEND_UNKNOWN -- an expired claim is how an accepted message gets sent twice.
  sendState String @default("DRAFT")

  /// THE ATTEMPT, STORED BEFORE GMAIL IS CALLED, so an attempt whose answer is lost -- or whose
  /// process stopped after Gmail accepted it -- can be reconciled against Sent mail instead of
  /// being sent again. The id makes every later write conditional on THIS attempt; the
  /// fingerprint is a SHA-256 of the exact words sent, which is what reconciliation matches.
  sendAttemptId        String?
  sendAttemptStartedAt DateTime?
  sendAttemptBodyHash  String?
  /// When Gmail was last asked about an unconfirmed attempt, and how the doubt was settled.
  sendReconciledAt     DateTime?
  /// `WORK_SEND_RESOLUTIONS`.
  sendResolution       String?

  /// The send, as facts: when it completed and what Gmail called it.
  sentAt           DateTime?
  sentMessageId    String?
  /// `WORK_SEND_FAILURE_CLASSES`. Never a provider's text. In SEND_UNKNOWN it says why Loop does
  /// not know; in DRAFT, why the last attempt is known to have failed.
  sendFailureClass String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   OrganizationMembership @relation("WorkDraftMember", fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)

  @@unique([organizationId, userId, provider, threadId])
  @@index([organizationId, userId, updatedAt])
  @@map("work_drafts")
}

/// A calendar event, as a work object. Attendees are COUNTED, never listed as subjects: an
/// attendee address is a contact identifier, and matching one to a Party is the identity
/// matching Loop forbids (meeting-intelligence.md §2).
model WorkEvent {
  id             String @id @default(cuid())
  organizationId String
  userId         String

  provider         String
  eventId          String
  recurringEventId String?
  /// For an instance of a series, the moment the series said it would start, before any move.
  originalStartsAt DateTime?

  /// A TIMED event has instants. An ALL-DAY event has dates, and a date is not a moment until
  /// somebody says whose day it is -- so the two are stored apart and neither is invented from
  /// the other (DL-2, and the Loop Time Authority). `endDateExclusive` keeps Google's own
  /// semantics: a one-day event on the 18th ends on the 19th.
  startsAt         DateTime?
  endsAt           DateTime?
  allDay           Boolean   @default(false)
  startDate        DateTime? @db.Date
  endDateExclusive DateTime? @db.Date
  /// The calendar's own IANA zone where the provider states one. Never the reader's.
  eventTimeZone    String?
  /// `CALENDAR_EVENT_STATUSES`. A cancelled event is kept, not deleted: it is how a meeting
  /// leaves the day, and deleting it would make the history ambiguous.
  status           String?
  /// `CALENDAR_EVENT_KINDS`. An out-of-office block is not a meeting, and a later rule needs to
  /// know that without reading a title.
  kind             String?
  /// `CALENDAR_TIME_BLOCKING`. An event that does not block time is not a conflict.
  blocking         String?

  /// The event's title. CONTENT, and the minimum the approved Day experience needs (DL-2 found
  /// it missing). Deliberately the ONLY content field: no description, no location, no
  /// attendee addresses, no joining link, no attachment.
  summary String?

  organizerHash         String?
  organizerIsSelf       Boolean  @default(false)
  /// Whether the provider stated who is attending at all. FALSE means the counts are UNKNOWN,
  /// which is a different fact from nobody being invited.
  attendanceKnown       Boolean  @default(false)
  attendeeCount         Int?
  externalAttendeeCount Int?
  /// D2 (approved 2026-09-19). The SAME one-way key as `organizerHash` and a correspondent's
  /// `addressHash`, one per person invited other than the connected person (rooms excluded),
  /// capped. Keys, never addresses (a CHECK refuses anything else): they join this person's own
  /// mail to their own calendar, and nothing else. Empty when attendance is unknown.
  attendeeHashes        String[] @default([])
  /// `CALENDAR_RESPONSES` -- the connected person's own answer, when the provider states one.
  selfResponse          String?
  hasConference         Boolean  @default(false)

  /// The provider's own last-modified stamp, and when Loop read it.
  providerUpdatedAt DateTime?
  observedAt        DateTime  @default(now())

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   OrganizationMembership @relation("WorkEventMember", fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)

  @@unique([organizationId, userId, provider, eventId])
  @@index([organizationId, userId, startsAt])
  @@map("work_events")
}

/// A document's METADATA. `drive.metadata.readonly` returns no content, and Loop stores none.
model WorkDocument {
  id             String @id @default(cuid())
  organizationId String
  userId         String

  provider String
  fileId   String

  name        String?
  mimeType    String?
  ownerHashes String[]  @default([])
  modifiedAt  DateTime?
  webViewLink String?
  observedAt  DateTime  @default(now())

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   OrganizationMembership @relation("WorkDocumentMember", fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)

  @@unique([organizationId, userId, provider, fileId])
  @@index([organizationId, userId, modifiedAt])
  @@map("work_documents")
}

/// Something that needs this person. The queue row.
///
/// PRODUCER-AGNOSTIC BY DESIGN (§14.4 seam 2): a rule writes it today and a Stage 3 task
/// writes the same row with `producerKind = 'MODEL'`, so intelligence arriving later is not
/// a second queue. `recurrenceKey` is the producer's rule plus its subject -- never a
/// timestamp -- so the same situation tomorrow is this row with a later `lastDetectedAt`.
model WorkItem {
  id             String @id @default(cuid())
  organizationId String
  userId         String

  recurrenceKey String
  /// `WORK_CLASSES`.
  class         String
  /// `WORK_SUBJECT_KINDS` and the subject's own reference (a thread id, an event id).
  subjectKind   String
  subjectRef    String
  /// One line, in the person's language.
  title         String?

  /// `WORK_PRODUCER_KINDS`, the producer's id and its version, so history stays
  /// interpretable after the producer's logic changes.
  producerKind    String
  producerId      String
  producerVersion String
  /// References to the facts that raised it (thread, message, event ids -- keyed, never raw) plus, for a
  /// MODEL producer, its MINIMIZED paraphrase fields (a topic, a next step, a grounded deadline) and the
  /// source's own label for the conversation (e.g. Telegram's contact name / group title). Never a
  /// message body, never a quotation.
  evidence        Json   @default("{}")

  /// A Stage 2 seam, always NULL here: a short quotation that makes "why this matters"
  /// legible without opening Gmail, capped at 240 characters by a CHECK (§17.4).
  evidenceQuote    String?
  /// The message the quote came from.
  evidenceQuoteRef String?

  firstDetectedAt DateTime
  lastDetectedAt  DateTime
  detectionCount  Int      @default(1)

  /// Projection of `observations`, written in the same transaction as the observation that
  /// causes it. `WORK_ITEM_STATES`.
  state          String    @default("OPEN")
  stateChangedAt DateTime?
  snoozedUntil   DateTime?
  resolvedAt     DateTime?
  /// `WORK_ITEM_OUTCOMES`. Present exactly when the item is closed -- keeping "Loop should
  /// not have raised it" apart from "real, and handled" is the only accuracy signal the
  /// rules ever get.
  outcome        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   OrganizationMembership @relation("WorkItemMember", fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)
  observations WorkItemObservation[]  @relation("WorkItemObservations")

  @@unique([organizationId, userId, recurrenceKey])
  @@index([organizationId, userId, state, lastDetectedAt])
  @@map("work_items")
}

/// What happened to an item, append-only. The log is the truth; `WorkItem`'s state columns
/// are its projection.
model WorkItemObservation {
  id             String @id @default(cuid())
  organizationId String
  userId         String
  itemId         String

  /// Monotonic per item. The ordering key for state.
  sequence        Int
  /// `WORK_OBSERVATION_TYPES`.
  observationType String
  /// When it happened in the world, and when Loop learned it.
  occurredAt      DateTime
  recordedAt      DateTime @default(now())
  /// `WORK_ACTOR_TYPES`. There is no AI actor.
  actorType       String
  actorUserId     String?
  /// Why the transition happened, from a closed vocabulary or the person's own reason.
  reason          String?
  previousState   String?
  newState        String?

  item         WorkItem               @relation("WorkItemObservations", fields: [itemId], references: [id], onDelete: Cascade)
  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   OrganizationMembership @relation("WorkItemObservationMember", fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)

  @@unique([itemId, sequence])
  @@index([organizationId, userId, itemId, sequence])
  @@map("work_item_observations")
}

/// One day's brief: an immutable record of what Loop examined, what it found and what it
/// could not see. Never recomputed in place -- a regeneration is a new version, so "what
/// happened while I was out on Friday" answers with Friday's brief and not today's data.
model WorkBrief {
  id             String @id @default(cuid())
  organizationId String
  userId         String

  /// The calendar day in the employee's own zone that this brief covers.
  localDate DateTime @db.Date
  /// Regeneration writes a new version; nothing overwrites a brief.
  version   Int      @default(1)

  windowStart DateTime
  windowEnd   DateTime
  /// What Loop could and could not read, per source. An honest empty state depends on it.
  coverage    Json     @default("{}")
  /// Counts by class. A count Loop could not compute is absent, never 0.
  counts      Json     @default("{}")
  /// References to the items and threads this brief points at.
  items       Json     @default("[]")

  /// A Stage 3 seam, always NULL here: the narrative sentence, which needs content and a
  /// model. Its absence is why the brief renders as counts today (§14.4 seam 4).
  headline String?

  generatedAt      DateTime @default(now())
  generatorVersion String

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   OrganizationMembership @relation("WorkBriefMember", fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)

  @@unique([organizationId, userId, localDate, version])
  @@index([organizationId, userId, localDate])
  @@map("work_briefs")
}

/// A correction, append-only. It tunes THIS person's surface and never becomes a global
/// rule -- which is both Loop's rule (§12.5) and Google's Limited Use policy.
model WorkFeedback {
  id             String @id @default(cuid())
  organizationId String
  userId         String

  /// `WORK_FEEDBACK_KINDS`.
  kind        String
  /// `WORK_SUBJECT_KINDS` and the subject it is about.
  subjectKind String
  subjectRef  String
  reason      String?

  createdAt       DateTime @default(now())
  createdByUserId String

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   OrganizationMembership @relation("WorkFeedbackMember", fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)
  createdBy    User                   @relation("WorkFeedbackAuthor", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, subjectKind, subjectRef])
  @@index([organizationId, userId, createdAt])
  @@map("work_feedback")
}

/// The employee's own settings. The timezone here is the first stored display zone in Loop:
/// until now the web app resolved it from the device, which cannot schedule anything.
model EmployeeWorkPreferences {
  id             String @id @default(cuid())
  organizationId String
  userId         String

  /// An IANA zone, validated by the Loop Time Authority before it is written.
  timeZone          String  @default("UTC")
  /// Minutes past local midnight: when the working day starts, and the quiet window.
  dayStartMinutes   Int     @default(480)
  quietStartMinutes Int?
  quietEndMinutes   Int?
  briefEnabled      Boolean @default(true)
  /// Which sources feed this person's surface, when they have chosen.
  sources           Json    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   OrganizationMembership @relation("EmployeeWorkPreferencesMember", fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("employee_work_preferences")
}

/// An organization holding a different retention window from the approved default.
///
/// The POLICY lives in `@emgloop/shared` (`WORK_RETENTION_CATEGORIES`) as reviewed, versioned
/// code -- one place, per category, never one universal number. This table exists so a window
/// can be represented per organization without a deployment, and so the effective policy is
/// auditable. No row here means the approved default applies.
model WorkRetentionOverride {
  id             String @id @default(cuid())
  organizationId String

  /// A category name from `WORK_RETENTION_CATEGORIES`.
  category      String
  /// The window in days. NULL is not "forever": it means this category is not a day count
  /// (never stored, tied to its parent, governed elsewhere) and may not be overridden here.
  days          Int?
  /// The policy version this override was written against, so a later policy change is
  /// detectable rather than silently mixed.
  policyVersion String
  reason        String?

  setByUserId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  setBy        User?        @relation("WorkRetentionOverrideAuthor", fields: [setByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, category])
  @@map("work_retention_overrides")
}

// ===========================================================================
// Creator Hub (2026-09-22) -- the creator domain, and what it composes.
//
// ONE BUSINESS, TWO SEATS, THE SAME ROWS. A managed creator and EMG look at the
// same Content, the same Versions, the same Work and the same commercial records
// through two authorized projections. Nothing below is a "creator copy" of
// something another authority owns:
//
//   - Work OS stays the authority for execution. A Production IS a WorkInstance
//     (an Edit step, then a Creator-review step; a change request appends the
//     next round to the same instance). `WorkInstruction` extends Work OS with
//     the one thing an external participant's request needs: an instruction set
//     with provenance (who originated it, who entered it, which version it is
//     about, which version answered it).
//   - CRM stays the authority for commercial intent. `CrmOpportunity` and
//     `CrmCampaign` are the locked shapes of commercial-opportunity-campaign.md,
//     built at the minimum the creator seat needs, with append-only transition
//     logs. `CampaignDeliverable` is what the creator owes on a campaign; its
//     requirements are what "complete" means, and the record reads them.
//   - The creator domain owns only what nothing else does: the creator's
//     profile attributes and the login that acts for them, Content and its
//     immutable Versions (bytes live in object storage; only the KEY is here),
//     approvals as marks on a specific version, and manual publication marks.
//   - Performance, audience and compensation rows exist so the product can be
//     tested end to end; every row carries its `source`, and SEEDED_DEMO rows
//     are labelled as such wherever they are shown. Nothing here pretends a
//     platform or a payment rail is connected.
// ===========================================================================

/// Work OS: an instruction set on a work item, with provenance.
///
/// WHO SAID IT AND WHO TYPED IT ARE TWO FACTS. A creator's change request is
/// originated and entered by the creator. A brand's note relayed by an EMG
/// employee is originated by the brand and entered by that employee, and the
/// history never lets the second look like the first.
///
/// APPEND-ONLY. A sent instruction set is never edited; a later set supersedes
/// it. `answeredByVersionId` is stamped once, when a version answers it, and
/// `addressed` records what the answering person said about each note.
model WorkInstruction {
  id             String  @id @default(cuid())
  organizationId String
  workInstanceId String
  workStageId    String?

  /// Monotonic per work instance: set 1, set 2, ...
  sequence Int

  /// CREATOR | EMG | BRAND_RELAYED.
  originatorKind  String
  /// The originator's creator-visible label when it is not a Loop user (e.g. the brand's
  /// designated name), else null.
  originatorLabel String?
  /// The Loop user who entered it.
  enteredByUserId String

  /// The content version the instruction is about (scalar id; the creator domain resolves it).
  refersToVersionId String?
  /// The free-text part of the request.
  summary           String?
  /// Timestamped notes: [{ id, atSeconds, untilSeconds?, kind: 'CHANGE'|'KEEP', text }].
  notes             Json      @default("[]")
  /// What the requester asked for, if they said.
  requestedReturnAt DateTime?

  /// Stamped when a version answers this set; never changed afterwards.
  answeredByVersionId String?
  answeredAt          DateTime?
  /// [{ noteId, addressed: boolean, reply: string|null }] as recorded by the answering person.
  addressed           Json      @default("[]")

  visibleToCreator Boolean  @default(true)
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workInstance WorkInstance @relation(fields: [workInstanceId], references: [id], onDelete: Cascade)

  @@unique([workInstanceId, sequence])
  @@index([organizationId, workInstanceId])
  @@map("work_instructions")
}

/// The creator domain's binding of a PERSON Party to a creator seat and its
/// creator-only attributes. NOT identity: the Party stays the identity; this row
/// says which login acts as the creator and what the creator maintains about
/// themselves. `partyId` is a scalar id, like every identity reference here.
model CreatorProfile {
  id             String  @id @default(cuid())
  organizationId String
  partyId        String
  /// The login that acts as this creator (a CREATOR membership). Null until invited.
  userId         String? @unique

  displayName         String
  handle              String?
  bio                 String?
  categories          String[] @default([])
  /// [{ platform, handle, state: 'NOT_CONNECTED'|'SEEDED_DEMO', audience?: number }]
  socialAccounts      Json     @default("[]")
  /// NOT_SET_UP | SEEDED_DEMO. No bank detail is ever stored in Loop.
  payoutState         String   @default("NOT_SET_UP")
  /// EMG-maintained commercial fields the creator may see (designated), e.g. rate cards.
  rateInfo            Json     @default("{}")
  documents           Json     @default("[]")
  preferences         Json     @default("{}")
  /// The EMG editor who receives this creator's edit requests by default, if any.
  defaultEditorUserId String?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contents     CreatorContent[]

  @@unique([organizationId, partyId])
  @@index([organizationId])
  @@map("creator_profiles")
}

/// A creator's piece of work through its life. The durable creator-facing record.
/// Owns its name and its version lineage; everything else it shows is a projection.
model CreatorContent {
  id               String @id @default(cuid())
  organizationId   String
  creatorProfileId String

  title String
  /// VIDEO | PHOTO
  kind  String

  /// Commercial context, by id (CRM owns it). Null for independent content.
  campaignId    String?
  deliverableId String?
  opportunityId String?

  createdByUserId String
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creatorProfile CreatorProfile           @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  versions       ContentVersion[]
  approvals      ContentVersionApproval[]
  publications   ContentPublication[]
  productions    ContentProduction[]

  @@index([organizationId, creatorProfileId, createdAt])
  @@index([organizationId, campaignId])
  @@map("creator_contents")
}

/// One immutable version of a piece of content. NEVER OVERWRITTEN: a new cut is a
/// new row with the next number. The bytes live in object storage under
/// `storageKey`; this row is their meaning -- who uploaded it, from which
/// production, answering which instruction set, and the marks it carries.
model ContentVersion {
  id             String @id @default(cuid())
  organizationId String
  contentId      String

  /// 0 is the Original; edits count up from 1.
  number Int
  /// 'Original', 'Edit v1', ...
  label  String
  /// ORIGINAL | EDIT
  kind   String

  storageKey  String  @unique
  contentType String
  byteSize    Int?
  fileName    String?
  /// PENDING (URL issued, bytes not confirmed) | READY (verified in storage) | FAILED
  uploadState String  @default("PENDING")

  /// Facts read from the file in the uploader's browser (duration, dimensions), labelled as such.
  durationSeconds Float?
  width           Int?
  height          Int?
  clientFacts     Json   @default("{}")

  uploadedByUserId String
  /// CREATOR | EMG
  uploadedByKind   String

  /// The production (work instance) that produced it, if any, and the instruction set it answers.
  producedByWorkInstanceId String?
  answersInstructionId     String?

  /// The uploader's note for the creator (visible) and for EMG only (never shown to the creator).
  noteToCreator    String?
  internalNote     String?
  /// A version an editor saved without sending: EMG-only until it is returned for review.
  visibleToCreator Boolean @default(true)

  readyAt   DateTime?
  createdAt DateTime  @default(now())

  content      CreatorContent           @relation(fields: [contentId], references: [id], onDelete: Cascade)
  approvals    ContentVersionApproval[]
  publications ContentPublication[]

  @@unique([contentId, number])
  @@index([organizationId, contentId])
  @@map("content_versions")
}

/// An approval is a mark on ONE version, for ONE requirement, by ONE actor. A
/// later version inherits nothing; the mark stays visible in history forever.
model ContentVersionApproval {
  id             String @id @default(cuid())
  organizationId String
  contentId      String
  versionId      String

  /// creator | emg | brand -- the deliverable requirement this mark satisfies.
  requirementKey   String
  /// CREATOR | EMG | BRAND_RELAYED
  approverKind     String
  /// The Loop user who recorded it (for BRAND_RELAYED, the relaying employee).
  approvedByUserId String
  /// The originator's creator-visible label when relayed (e.g. the brand's designated name).
  originatorLabel  String?
  note             String?
  approvedAt       DateTime @default(now())

  content CreatorContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  version ContentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, requirementKey])
  @@index([organizationId, contentId])
  @@map("content_version_approvals")
}

/// A manual publication mark: the creator says which version went where, and links the post.
model ContentPublication {
  id             String @id @default(cuid())
  organizationId String
  contentId      String
  versionId      String

  platform       String
  url            String?
  publishedAt    DateTime
  markedByUserId String
  createdAt      DateTime @default(now())

  content CreatorContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  version ContentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([organizationId, contentId])
  @@map("content_publications")
}

/// A production cycle on a piece of content: the join to the Work OS instance that
/// executes it. A new edit after a completed production is a NEW row (Production 2)
/// on the same content; a completed instance is never reopened.
model ContentProduction {
  id             String @id @default(cuid())
  organizationId String
  contentId      String

  /// Production 1, 2, ... per content.
  number Int
  /// EDIT (the only kind today; thumbnails, cutdowns and localisation are later kinds).
  kind   String @default("EDIT")

  workInstanceId  String @unique
  sourceVersionId String

  requestedByUserId String
  requestedReturnAt DateTime?
  createdAt         DateTime  @default(now())
  completedAt       DateTime?

  content CreatorContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, number])
  @@index([organizationId, contentId])
  @@map("content_productions")
}

/// CRM: a commercial pursuit (commercial-opportunity-campaign.md §3.4, the locked
/// shape at its minimum). Category is governed; the stage is an organization
/// label within OPEN; the creator sees only the designated creator-visible state
/// and never the forecast, the notes or the internal stage names.
model CrmOpportunity {
  id             String @id @default(cuid())
  organizationId String

  title                 String
  /// OPEN | CLOSED_WON | CLOSED_LOST
  category              String  @default("OPEN")
  /// The organization's stage label within OPEN.
  stage                 String
  /// The represented creator this pursuit concerns (a PERSON Party, by id).
  creatorPartyId        String
  /// What the creator sees, designated by EMG: BRAND_INTEREST | PITCHING | NEGOTIATING |
  /// CONFIRMED | DIDNT_GO_AHEAD, or null (not shown to the creator at all).
  creatorVisibleState   String?
  /// The brand as the creator may see it. Shown only when designated visible.
  brandLabel            String?
  brandVisibleToCreator Boolean @default(false)
  /// EMG's creator-facing overview, in words written for the creator.
  summaryForCreator     String?
  /// EMG only.
  internalNotes         String?

  /// Human-authored forecast (never computed). Attribution and time on every change.
  forecastProbability      Int?
  forecastAuthoredByUserId String?
  forecastAuthoredAt       DateTime?
  amountMinor              Int?
  currency                 String?
  expectedCloseDate        DateTime? @db.Date

  /// Set when closed.
  outcome    String?
  lossReason String?

  /// Optional: the Relationship this pursuit sits under (PD-F-02).
  relationshipId String?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transitions  CrmOpportunityTransition[]
  campaigns    CrmCampaign[]

  @@index([organizationId, creatorPartyId])
  @@index([organizationId, category])
  @@map("crm_opportunities")
}

/// APPEND-ONLY stage and state history of an Opportunity.
model CrmOpportunityTransition {
  id             String @id @default(cuid())
  organizationId String
  opportunityId  String

  sequence       Int
  fromCategory   String?
  fromStage      String?
  toCategory     String
  toStage        String
  actorUserId    String?
  occurredAt     DateTime @default(now())
  note           String?
  /// Whether the creator's timeline shows this move.
  creatorVisible Boolean  @default(false)

  opportunity CrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, sequence])
  @@map("crm_opportunity_transitions")
}

/// CRM: the agreed commercial program (§4.4 at its minimum). Human-declared
/// lifecycle; execution truth (deliverables, versions, work) is composed, never copied.
model CrmCampaign {
  id             String @id @default(cuid())
  organizationId String

  name  String
  /// DRAFT | AGREED | ACTIVE | PAUSED | ENDED | CANCELLED
  state String @default("DRAFT")

  opportunityId  String?
  creatorPartyId String

  brandLabel            String?
  brandVisibleToCreator Boolean   @default(false)
  startDate             DateTime? @db.Date
  endDate               DateTime? @db.Date

  /// Creator-facing brief (visible) and the commercial terms summary (EMG only).
  creatorBrief String?
  termsSummary String?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunity  CrmOpportunity?         @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  transitions  CrmCampaignTransition[]
  deliverables CampaignDeliverable[]

  @@index([organizationId, creatorPartyId])
  @@map("crm_campaigns")
}

/// APPEND-ONLY lifecycle history of a Campaign.
model CrmCampaignTransition {
  id             String @id @default(cuid())
  organizationId String
  campaignId     String

  sequence       Int
  fromState      String?
  toState        String
  actorUserId    String?
  occurredAt     DateTime @default(now())
  note           String?
  creatorVisible Boolean  @default(false)

  campaign CrmCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, sequence])
  @@map("crm_campaign_transitions")
}

/// What the creator owes on a campaign. Its `requirements` are what "complete"
/// means for it -- the record reads them, it never invents them:
/// [{ key: 'creator'|'emg'|'brand'|'published', label, required: true, dueAt? }]
model CampaignDeliverable {
  id             String @id @default(cuid())
  organizationId String
  campaignId     String
  creatorPartyId String

  title           String
  /// REEL | VIDEO | PHOTO | STORY | OTHER
  deliverableType String
  dueAt           DateTime?
  requirements    Json      @default("[]")
  /// Whether an unedited Original may enter approval without an EMG production.
  acceptsUnedited Boolean   @default(false)

  /// The content fulfilling it, once one is attached.
  contentId   String?
  /// OPEN | COMPLETE (derived from the requirements, stamped when they are all met).
  status      String    @default("OPEN")
  completedAt DateTime?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     CrmCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([organizationId, campaignId])
  @@index([organizationId, creatorPartyId])
  @@map("campaign_deliverables")
}

/// Performance evidence for a published version or a creator's account, per
/// platform and window. `source` is PLATFORM (a connected platform reported it)
/// or SEEDED_DEMO (loaded for testing, and labelled so everywhere it appears).
model CreatorPerformanceSnapshot {
  id               String  @id @default(cuid())
  organizationId   String
  creatorProfileId String
  contentId        String?
  versionId        String?

  platform    String
  windowStart DateTime
  windowEnd   DateTime
  /// { views, reach, likes, comments, saves, shares, completionPct, ... }
  metrics     Json
  source      String
  observedAt  DateTime
  createdAt   DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, creatorProfileId, platform, windowEnd])
  @@index([organizationId, contentId])
  @@map("creator_performance_snapshots")
}

/// Audience evidence per platform over time. Same `source` rule.
model CreatorAudienceSnapshot {
  id               String @id @default(cuid())
  organizationId   String
  creatorProfileId String

  platform     String
  observedAt   DateTime
  followers    Int
  growth30dPct Float?
  source       String
  createdAt    DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, creatorProfileId, platform, observedAt])
  @@map("creator_audience_snapshots")
}

/// Compensation and payment state, as append-only entries that trace to their
/// business context. No payment rail exists: every row today is SEEDED_DEMO and
/// says so. The states are the product's: EXPECTED | PENDING | RECEIVED_BY_EMG |
/// AVAILABLE | TRANSFER_PENDING | PAID.
model CreatorCompensationEntry {
  id               String  @id @default(cuid())
  organizationId   String
  creatorProfileId String
  campaignId       String?
  deliverableId    String?

  description     String
  amountMinor     Int
  currency        String   @default("USD")
  state           String
  occurredAt      DateTime
  source          String
  createdByUserId String?
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, creatorProfileId, occurredAt])
  @@map("creator_compensation_entries")
}

/// Loop Intelligence PR 2 (the fabric), 2026-09-26. An EXPLICIT, governed relationship between two
/// canonical entity references (@emgloop/shared entity-ref.ts): "this CallGrid buyer IS this Party",
/// "this page is PART_OF this web property". Never a model's guess: the basis is a human declaration, a
/// deterministic rule, or an import, and each link names its source. It never alters the entity's own
/// authority (a SAME_AS link does not merge Parties -- identity resolution does that). Reversal is a
/// stamp, not a delete, so what was believed when stays readable.
///
/// Scope as intelligence_digests: PRINCIPAL links are one person's (and may name their private
/// evidence); ORGANIZATION links name nobody and may not reference a principal-only kind (checked).
model EntityLink {
  id               String    @id @default(cuid())
  organizationId   String
  scope            String
  userId           String?
  fromRef          String
  toRef            String
  /// SAME_AS, PART_OF, LOCATED_IN or REPRESENTS.
  relation         String
  /// HUMAN_DECLARED, RULE or IMPORTED. Never MODEL.
  basis            String
  /// Registry source id or rule id that established the link.
  source           String
  sourceRef        String?
  /// Who declared it, for HUMAN_DECLARED (checked).
  declaredByUserId String?
  effectiveFrom    DateTime
  reversedAt       DateTime?
  reversedByUserId String?
  createdAt        DateTime  @default(now())

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   OrganizationMembership? @relation("EntityLinkMember", fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)

  // One ACTIVE link per (owner, from, relation, to): two partial unique indexes in the migration.
  @@index([organizationId, scope, fromRef])
  @@index([organizationId, scope, toRef])
  @@index([organizationId, userId])
  @@map("entity_links")
}

/// Loop Intelligence PR 2 (the fabric), 2026-09-26. A durable, COALESCING request that one intelligence
/// target be refreshed. Metadata only -- a reason, a source revision, a fingerprint -- never content.
/// At most one PENDING request per target (partial unique indexes, per scope, so a principal request and
/// an organization request for the same domain never collapse into each other). A worker claims one with
/// a lease; completing deletes it; a failure goes back to PENDING with a backoff, and past the attempt
/// limit it is HELD for an operator. Nothing enqueues on page render.
model IntelligenceRefreshRequest {
  id               String    @id @default(cuid())
  organizationId   String
  scope            String
  userId           String?
  domain           String
  subjectKind      String
  subjectRef       String
  reason           String
  sourceId         String?
  sourceRevision   String?
  fingerprint      String?
  requestCount     Int       @default(1)
  firstRequestedAt DateTime
  lastRequestedAt  DateTime
  notBefore        DateTime
  /// PENDING, CLAIMED or HELD.
  state            String
  attempts         Int       @default(0)
  leaseOwner       String?
  leaseExpiresAt   DateTime?
  lastOutcome      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   OrganizationMembership? @relation("IntelligenceRefreshMember", fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)

  @@index([state, notBefore])
  @@index([state, leaseExpiresAt])
  @@index([organizationId, scope, domain, state])
  @@index([organizationId, userId])
  @@map("intelligence_refresh_queue")
}
