}

// ---------------------------------------------------------------------------
// Provider Abstraction & Integration Plumbing
// ---------------------------------------------------------------------------

// A tenant's connection to an external provider (one row per connected provider).
model ProviderConnection {
  id                String           @id @default(cuid())
  organizationId    String
  category          ProviderCategory
  provider          String // e.g. "anthropic", "twilio", "telnyx", "stripe"
  displayName       String?
  status            ConnectionStatus @default(PENDING)
  externalAccountId String?
  // Secrets are NOT stored raw here in production — store a reference to a
  // secrets manager. Kept generic and provider-agnostic.
  credentialsRef    String?
  config            Json             @default("{}")
  scopes            String[]         @default([])
  connectedAt       DateTime?
  lastSyncedAt      DateTime?
  metadata          Json             @default("{}")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integrationEvents IntegrationEvent[]

  @@unique([organizationId, category, provider])
  @@index([organizationId, category])
  @@map("provider_connections")
}

// Inbound/outbound events from providers (webhooks, syncs) — generic envelope.
/// Why a canonical provider fact changed, or why two answers disagreed.
///
/// BOUNDED BY CHANGES, NOT BY OBSERVATIONS. A poller re-reading a 48-hour
/// overlap every fifteen minutes produces ~192 observations per call and almost
/// always zero revisions: a row exists only when a fact moved, or when two
/// settled values disagreed. A postback settles once.
model ProviderFactRevision {
  id                 String    @id @default(cuid())
  organizationId     String
  provider           String
  /// The provider's own call id. Deliberately not a relation to MarketplaceCall:
  /// a revision explains an observation and must survive a projection rebuild.
  externalId         String
  /// From the closed CALLGRID_FACT_KINDS vocabulary. Text so it can widen
  /// without DDL; readers fail closed on a value they do not recognise.
  fact               String
  /// UPDATE or CONFLICT only. KEEP_EXISTING and REMAIN_UNKNOWN are not recorded
  /// -- a row per non-event is how a table becomes a log.
  decision           String
  /// Rendered, not typed: one table holds money and booleans, and a reader needs
  /// to see what was there. NULL means unknown on that side of the change.
  fromValue          String?
  toValue            String?
  observationSource  String
  observedAt         DateTime
  integrationEventId String?
  /// Set only when the canonical value actually moved. NULL on a CONFLICT.
  appliedAt          DateTime?
  reason             String
  createdAt          DateTime  @default(now())

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integrationEvent IntegrationEvent? @relation(fields: [integrationEventId], references: [id], onDelete: SetNull)

  @@index([organizationId, provider, externalId], map: "provider_fact_revisions_org_provider_external_idx")
  @@index([organizationId, decision, observedAt], map: "provider_fact_revisions_org_decision_observedAt_idx")
  @@map("provider_fact_revisions")
}

model IntegrationEvent {
  id                   String                 @id @default(cuid())
  organizationId       String
  providerConnectionId String?
  category             ProviderCategory?
  provider             String?
  eventType            String // provider-defined event name
  externalId           String? // provider event/delivery id (idempotency)
  status               IntegrationEventStatus @default(RECEIVED)
  payload              Json                   @default("{}")
  error                String?

  /// When LOOP first durably received this delivery. Loop time, immutable, and
  /// never rewritten -- re-observing the same provider identity reuses the row
  /// and leaves this alone. It is the honest record of what Loop had and when,
  /// which is what makes "Loop received nothing between 2026-08-10 and 08-14" a
  /// checkable statement rather than a story.
  receivedAt DateTime @default(now())

  /// How this event FIRST reached Loop: WEBHOOK, API_POLL or API_RECOVERY.
  /// Written once on create and NEVER rewritten -- a webhook call later seen by
  /// the poller must keep saying WEBHOOK. NULL means the row predates the
  /// column, which is not the same as an unknown transport. Stored as text so
  /// the vocabulary can widen without production DDL; readers fail closed.
  firstIngestionSource String?

  /// Every path that has EVER observed this event, ordered first-seen.
  ///
  /// A SET, NOT A LOG. The question is "which paths have seen this call", which
  /// has at most three answers, so a child observation table would record ~192
  /// rows per call for a poller re-reading a 48-hour overlap every fifteen
  /// minutes -- storage spent on repetition.
  observedSources String[] @default([])

  /// When the provider most recently CONFIRMED this event. Advances on every
  /// observation, including one that changed nothing.
  ///
  /// NOT A MODIFICATION TIME. CallGrid exposes no per-call updatedAt and its
  /// records mutate after postback, so "we looked again and it was there" is the
  /// only honest claim available. Whether a later answer REPLACES an earlier one
  /// is a fact-merge policy and does not live here.
  lastObservedAt DateTime?

  /// When the PROVIDER says the call happened. Provider time, nullable.
  ///
  /// Populated on write from the occurrence the adapter already resolved, so
  /// persistence never re-resolves it and the two cannot disagree. NULL means
  /// the row predates this column -- resolve from the payload -- and never that
  /// the call has no occurrence. It is deliberately NOT defaulted: the only
  /// value DDL could supply is now(), which would fabricate a provider fact out
  /// of a Loop one.
  occurredAt DateTime?

  processedAt DateTime?
  createdAt   DateTime  @default(now())

  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerConnection ProviderConnection?    @relation(fields: [providerConnectionId], references: [id], onDelete: SetNull)
  factRevisions      ProviderFactRevision[]

  @@unique([provider, externalId])
  @@index([organizationId, status])
  @@index([providerConnectionId])
  @@index([organizationId, provider, occurredAt])
  @@map("integration_events")
}

