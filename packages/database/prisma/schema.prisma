  PUBLIC
}

/// Lawful basis for holding/using the data. Absence (NONE) denies by default.
enum ConsentBasis {
  CONSENT
  CONTRACT
  LEGITIMATE_INTEREST
  LEGAL_OBLIGATION
  VITAL_INTEREST
  PUBLIC_TASK
  NONE
}

enum GovernancePolicyStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

/// The active-state projection domain. Domain-specific — never one giant blob.
enum ActiveStateDomain {
  COMMERCE
  SERVICE_JOURNEY
  COMMUNICATION
  RELATIONSHIP
  SUPPORT
  COMMERCIAL
  ACCOUNT
  RISK
  OPERATIONAL
