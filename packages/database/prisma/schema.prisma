// EMG Loop — Platform Database Schema
// AI-first, industry-agnostic, multi-tenant SaaS.
//
// Design rules:
//  - Every tenant-scoped row carries organizationId (multi-tenancy boundary).
//  - Industry-specific shape lives in JSON \`metadata\` / \`attributes\` columns,
//    NOT in industry-specific tables. The core stays generic.
//  - Providers are abstracted: we store ProviderConnection + provider/externalId
//    references rather than hard-coding Twilio/Stripe/etc.
//  - Soft, append-only intelligence (Signal) is first-class, not bolted on.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum IndustryType {
  HOME_SERVICES
  NAIL_SALON
  BARBERSHOP
  MEDICAL
  DENTAL
  RESTAURANT
  PIZZERIA
  LAW_FIRM
  AUTOMOTIVE
  BEAUTY_SPA
  FITNESS
  GENERIC
}

enum OrganizationStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum ChannelType {
  PHONE
  SMS
  EMAIL
  WEB_CHAT
  WHATSAPP
  IN_PERSON
  SOCIAL
  OTHER
}

enum InteractionDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum ConversationStatus {
  OPEN
  PENDING
  SNOOZED
  CLOSED
}

enum ActorType {
  CUSTOMER
  HUMAN_AGENT
  AI_AGENT
  SYSTEM
}

enum MessageType {
  TEXT
  AUDIO
  IMAGE
  FILE
  TRANSCRIPT
  EVENT
  SYSTEM
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  RESCHEDULED
  COMPLETED
  NO_SHOW
  CANCELED
}

enum OrderStatus {
  DRAFT
  PLACED
  IN_PROGRESS
  READY
  FULFILLED
  CANCELED
  REFUNDED
}

enum FulfillmentType {
  PICKUP
  DELIVERY
  DINE_IN
  ON_SITE
  REMOTE
}

enum ServiceRequestStatus {
  NEW
  QUALIFYING
  QUOTED
  WON
  LOST
  ON_HOLD
}

enum SignalType {
  INTENT
  SENTIMENT
  CHURN_RISK
  UPSELL_OPPORTUNITY
  LIFETIME_VALUE
  NO_SHOW_RISK
  SATISFACTION
  LANGUAGE
  TOPIC
  CUSTOM
}

enum WorkflowTrigger {
  EVENT
  SCHEDULE
  MANUAL
  WEBHOOK
  SIGNAL
}

enum WorkflowRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum AIAgentType {
  PHONE
  SMS
  CHAT
  ORDER_TAKING
  RECEPTIONIST
  FOLLOW_UP
  CUSTOM
}

enum ProviderCategory {
  AI
  VOICE
  SMS
  EMAIL
  PAYMENT
  CALENDAR
  INGESTION
  ANALYTICS
}

enum ConnectionStatus {
  PENDING
  CONNECTED
  ERROR
  DISCONNECTED
}

enum IntegrationEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

// ---------------------------------------------------------------------------
// Tenancy & Identity
// ---------------------------------------------------------------------------

model Organization {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  industry  IndustryType       @default(GENERIC)
  status    OrganizationStatus @default(TRIAL)
  timezone  String             @default("UTC")
  // Source attribution. ServicesInMyCity is the FIRST data source, not the product.
  sourceKey String? // e.g. "servicesinmycity"
  settings  Json               @default("{}")
  metadata  Json               @default("{}")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  locations                Location[]
  users                    User[]
  memberships              OrganizationMembership[]
  customerPartyLinks       CustomerPartyLink[]
  roles                    Role[]
  customers                Customer[]
  interactions             Interaction[]
  conversations            Conversation[]
  messages                 Message[]
  bookings                 Booking[]
  orders                   Order[]
  serviceRequests          ServiceRequest[]
  signals                  Signal[]
  workflows                Workflow[]
  workflowRuns             WorkflowRun[]
  aiAgents                 AIAgent[]
  aiEmployees              AIEmployee[]
  voiceProfiles            VoiceProfile[]
  providerConnections      ProviderConnection[]
  integrationEvents        IntegrationEvent[]
  providerFactRevisions    ProviderFactRevision[]
  auditLogs                AuditLog[]
  domainEvents             DomainEvent[]
  // --- Sprint 2: identity & OS core ---
  organizationSettings     OrganizationSettings?
  organizationPreferences  OrganizationPreferences?
  organizationDNA          OrganizationDNA?
  invitations              Invitation[]
  passwordResets           PasswordReset[]
  sessions                 UserSession[]
  customPermissions        Permission[]
  capabilities             OrganizationCapability[]
  // --- Commercial Intelligence Stage 1 ---
  performanceObjectives    PerformanceObjective[]
  // --- Commercial Intelligence Stage 2 ---
  commercialSignals        CommercialSignal[]
  // --- Commercial Intelligence Stage 3 ---
  measureBindings          ObjectiveMeasureBinding[]
  headlines                Headline[]
  observationDays          ProviderObservationDay[]
  pollCheckpoints          ProviderPollCheckpoint[]
  memberExpectations       ProviderMemberExpectation[]
  reconciliationDays       ProviderReconciliationDay[]
  reconciliationMembers    ProviderReconciliationMember[]
  measurementSources       MeasurementSource[]
  measurementSourceMetrics MeasurementSourceMetric[]
  sourceAuthorities        MeasureSourceAuthority[]
  // --- Commercial Intelligence Stage 4 ---
  caseParticipants         CaseParticipant[]
  // --- Work OS execution governance ---
  // The first Work OS tables with a real foreign key to an organization. The
  // originals carry organizationId as a bare string, which is why deleting an
  // organization orphans them; new tables do not repeat that.
  workStageEvents          WorkStageEvent[]
  workDependencies         WorkDependency[]

  crmRelationships            CrmRelationship[]
  crmRelationshipEvents       CrmRelationshipEvent[]
  crmParticipants             CrmParticipant[]
  aiInvocations               AiInvocation[]
  // --- Brain durable execution (B4) ---
  brainJobs                   BrainJob[]
  brainJobTransitions         BrainJobTransition[]
  brainJobSteps               BrainJobStep[]
  brainJobWaits               BrainJobWait[]
  brainCommands               BrainCommand[]
  brainEvents                 BrainEvent[]
  aiControls                  AiControl[]
  aiControlCurrent            AiControlCurrent[]
  /// Google Workspace connection (Private V1). One per member; see GoogleConnection.
  googleConnections           GoogleConnection[]
  /// TikTok Login Kit connection (Creator Hub). One per member; see TikTokConnection.
  tiktokConnections           TikTokConnection[]
  /// Background conversation sources (Teams, Telegram). One per member per provider; see
  /// SourceConnection.
  sourceConnections           SourceConnection[]
  /// Content-free observations from those sources (who/when, never content); see SourceObservation.
  sourceObservations          SourceObservation[]
  /// Historical baseline checkpoints (Telegram): per member per provider; see SourceBaselineCheckpoint.
  sourceBaselineCheckpoints   SourceBaselineCheckpoint[]
  /// Content-processing authorizations (Telegram content-triage): per member per provider; see
  /// SourceContentAuthorization. The employee's explicit consent to process message content with AI.
  sourceContentAuthorizations SourceContentAuthorization[]
  /// Loop Intelligence (PR A). Principal-private domain intelligence; always read with a userId as well.
  intelligenceDigests         IntelligenceDigest[]
  entityLinks                 EntityLink[]
  intelligenceRefreshRequests IntelligenceRefreshRequest[]
  /// Daily Loop (DL-1). Employee-private work state; always read with a userId as well.
  workSourceCursors           WorkSourceCursor[]
  workDrafts                  WorkDraft[]
  workSyncRuns                WorkSyncRun[]
  workCorrespondents          WorkCorrespondent[]
  workThreads                 WorkThread[]
  workMessages                WorkMessage[]
  workEvents                  WorkEvent[]
  workDocuments               WorkDocument[]
  workItems                   WorkItem[]
  workItemObservations        WorkItemObservation[]
  workBriefs                  WorkBrief[]
  workFeedback                WorkFeedback[]
  employeeWorkPreferences     EmployeeWorkPreferences[]
  workRetentionOverrides      WorkRetentionOverride[]

  googleOAuthStates GoogleOAuthState[]
  tiktokOAuthStates TikTokOAuthState[]

  /// Creator Hub (2026-09-22): the creator domain and the CRM commercial records it composes.
  workInstructions            WorkInstruction[]
  creatorProfiles             CreatorProfile[]
  creatorContents             CreatorContent[]
  crmOpportunities            CrmOpportunity[]
  crmCampaigns                CrmCampaign[]
  campaignDeliverables        CampaignDeliverable[]
  creatorPerformanceSnapshots CreatorPerformanceSnapshot[]
  creatorAudienceSnapshots    CreatorAudienceSnapshot[]
  creatorCompensationEntries  CreatorCompensationEntry[]

  @@index([sourceKey])
  @@map("organizations")
}

model Location {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String?
  timezone       String   @default("UTC")
  phone          String?
  email          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  region         String?
  postalCode     String?
  country        String?
  latitude       Float?
  longitude      Float?
  hours          Json     @default("{}") // weekly hours / exceptions
  metadata       Json     @default("{}")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings        Booking[]
  orders          Order[]
  serviceRequests ServiceRequest[]
  aiAgents        AIAgent[]
  aiEmployees     AIEmployee[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("locations")
}

model Role {
  id             String   @id @default(cuid())
  organizationId String
  name           String // e.g. "owner", "manager", "agent"
  description    String?
  isSystem       Boolean  @default(false)
  permissions    Json     @default("[]") // array of permission keys
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

model User {
  id             String     @id @default(cuid())
  organizationId String
  roleId         String?
  email          String
  name           String?
  phone          String?
  status         UserStatus @default(INVITED)
  // Auth is provider-agnostic: store external auth subject, never raw passwords.
  authProvider   String? // e.g. "clerk", "auth0", "supabase"
  externalAuthId String?
  lastLoginAt    DateTime?
  metadata       Json       @default("{}")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role?        @relation(fields: [roleId], references: [id], onDelete: SetNull)

  assignedConversations      Conversation[]              @relation("ConversationAssignee")
  auditLogs                  AuditLog[]
  // --- Sprint 2 ---
  sentInvitations            Invitation[]                @relation("InvitationInviter")
  passwordResets             PasswordReset[]
  userSessions               UserSession[]
  // --- Commercial Intelligence Stage 1 ---
  // Two distinct relations: the objectives that are ABOUT this user, and the
  // ones this user WROTE. Neither implies the other, and neither implies any
  // authority over anybody else.
  scopedObjectives           PerformanceObjective[]      @relation("PerformanceObjectiveScopedUser")
  authoredObjectives         PerformanceObjective[]      @relation("PerformanceObjectiveAuthor")
  // Stage 3: who confirmed a measure binding, and who dismissed a headline.
  // Attribution only — neither implies authority over anybody else, and neither
  // is read as an organizational relationship anywhere.
  confirmedMeasureBindings   ObjectiveMeasureBinding[]   @relation("ObjectiveMeasureBindingConfirmer")
  dismissedHeadlines         Headline[]                  @relation("HeadlineDismisser")
  /// The expectation declarations this person made about a provider's population
  /// members. Attribution only.
  declaredMemberExpectations ProviderMemberExpectation[] @relation("ProviderMemberExpectationDeclarer")
  declaredSourceAuthorities  MeasureSourceAuthority[]    @relation("MeasureSourceAuthorityDeclarer")

  /// Commercial Intelligence Stage 4. The investigations this person is involved
  /// in, and the ones they asked somebody else to be involved in. Participation
  /// is NOT work: none of these rows carries a due date, a status or a
  /// completion, because Work OS owns execution.
  caseParticipations       CaseParticipant[]  @relation("CaseParticipantUser")
  addedCaseParticipants    CaseParticipant[]  @relation("CaseParticipantAdder")
  releasedCaseParticipants CaseParticipant[]  @relation("CaseParticipantReleaser")
  reportedEvidence         DecisionEvidence[] @relation("DecisionEvidenceReporter")

  /// CRM P0.2d. Parties this person established as canonical identity, and
  /// records they marked superseded. Attribution only.
  establishedIdentities      CognitiveIdentity[] @relation("CognitiveIdentityEstablisher")
  supersededIdentities       CognitiveIdentity[] @relation("CognitiveIdentitySuperseder")
  /// CRM P0.2e. Customer -> Party links this person created, and reversed.
  createdCustomerPartyLinks  CustomerPartyLink[] @relation("CustomerPartyLinkCreator")
  reversedCustomerPartyLinks CustomerPartyLink[] @relation("CustomerPartyLinkReverser")

  /// CRM Phase Zero P0.2b. The organizations this login belongs to, and the
  /// memberships this person invited somebody into. See OrganizationMembership.
  memberships        OrganizationMembership[] @relation("MembershipUser")
  invitedMemberships OrganizationMembership[] @relation("MembershipInviter")

  crmRelationshipsOwned     CrmRelationship[]       @relation("CrmRelationshipOwner")
  crmRelationshipsCreated   CrmRelationship[]       @relation("CrmRelationshipCreator")
  crmRelationshipEvents     CrmRelationshipEvent[]  @relation("CrmRelationshipEventActor")
  crmParticipantsAdded      CrmParticipant[]        @relation("CrmParticipantCreator")
  crmParticipantsEnded      CrmParticipant[]        @relation("CrmParticipantEnder")
  crmParticipantsVoided     CrmParticipant[]        @relation("CrmParticipantVoider")
  aiInvocations             AiInvocation[]          @relation("AiInvocationPrincipal")
  /// Brain durable execution (B4). Attribution only; a job's principal is bound
  /// through its organization membership, not here.
  brainJobsCancelled        BrainJob[]              @relation("BrainJobCancelActor")
  brainJobTransitions       BrainJobTransition[]    @relation("BrainJobTransitionActor")
  brainJobWaitsAnswered     BrainJobWait[]          @relation("BrainJobWaitResponder")
  brainCommandsIssued       BrainCommand[]          @relation("BrainCommandIssuer")
  brainEvents               BrainEvent[]            @relation("BrainEventActor")
  aiControlsRecorded        AiControl[]             @relation("AiControlActor")
  /// Google connections this person revoked (their own, or a member's). Attribution only.
  googleConnectionsRevoked  GoogleConnection[]      @relation("GoogleConnectionRevoker")
  /// TikTok connections this person revoked (their own). Attribution only.
  tiktokConnectionsRevoked  TikTokConnection[]      @relation("TikTokConnectionRevoker")
  /// Source connections this person disconnected (their own, or a member's). Attribution only.
  sourceConnectionsEnded    SourceConnection[]      @relation("SourceConnectionDisconnector")
  /// Daily Loop (DL-1). Corrections this person recorded, and retention overrides they set.
  workFeedbackAuthored      WorkFeedback[]          @relation("WorkFeedbackAuthor")
  workRetentionOverridesSet WorkRetentionOverride[] @relation("WorkRetentionOverrideAuthor")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([externalAuthId])
  @@map("users")
}

/// Where a membership stands. Mirrors the lifecycle `User` already carries --
/// `INVITED`, `ACTIVE`, `DISABLED` -- plus `REMOVED`, which the repository has
/// expressed until now as a DISABLED user with `metadata.removedAt`. DISABLED is
/// a suspension an admin can lift; REMOVED ended the membership.
enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
  REMOVED
}

/// CRM Phase Zero P0.2b -- an authenticated User belongs to, and may act within,
/// an Organization under a governed system role.
///
/// SEPARATE FROM THE LOGIN, ON PURPOSE. `User` is the authentication principal
/// and the stable actor id every attribution column points at. Until now the
/// User row was also the membership (`User.organizationId` is scalar), which is
/// why one person in two organizations had to be two unrelated logins. This
/// table carries membership on its own so that can change without re-keying a
/// single historical actor.
///
/// NOT A COMMERCIAL ROLE, NOT AN IDENTITY. `systemRole` is an authorization level
/// inside the organization. It never says buyer, brand, creator, source or
/// participant, and a membership never creates or implies a Party.
///
/// THE AUTHORITY SINCE P0.2c. Session resolution and permission checks read a
/// User's standing and system role here. It is written in the same transaction as
/// every User lifecycle write and was backfilled from `User.organizationId`; the
/// User row remains a fail-closed compatibility guard -- a membership that
/// disagrees with it denies (see `resolveMembershipAuthority`).
model OrganizationMembership {
  id              String           @id @default(cuid())
  organizationId  String
  userId          String
  systemRole      SystemRole
  status          MembershipStatus
  /// Who invited this person. NULL for every membership backfilled from an
  /// existing User: nothing on the User row records an inviter, and inferring one
  /// from the invitation history would be a guess.
  invitedByUserId String?
  /// When this membership period began. Backfilled rows use `User.createdAt`,
  /// the moment the User-row membership came into existence.
  effectiveFrom   DateTime         @default(now())
  /// When the membership ended (REMOVED). NULL while it has not.
  effectiveTo     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization                Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                        User                         @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy                   User?                        @relation("MembershipInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  /// B4. Brain work runs on a membership's authority: a job's principal must hold one here.
  brainJobs                   BrainJob[]                   @relation("BrainJobPrincipal")
  brainJobWaits               BrainJobWait[]               @relation("BrainJobWaitPrincipal")
  /// A Google connection belongs to a membership: the person, in THIS organization.
  googleConnection            GoogleConnection[]           @relation("GoogleConnectionMember")
  googleOAuthStates           GoogleOAuthState[]           @relation("GoogleOAuthStateMember")
  /// A TikTok connection belongs to a membership the same way: the creator, in THIS organization.
  tiktokConnection            TikTokConnection[]           @relation("TikTokConnectionMember")
  tiktokOAuthStates           TikTokOAuthState[]           @relation("TikTokOAuthStateMember")
  /// A source connection (Teams, Telegram) belongs to a membership: the person, in THIS
  /// organization, so offboarding takes it with them.
  sourceConnections           SourceConnection[]           @relation("SourceConnectionMember")
  /// Content-free observations from those sources belong to the membership too, so offboarding
  /// takes them with the person.
  sourceObservations          SourceObservation[]          @relation("SourceObservationMember")
  /// The Telegram historical-baseline checkpoint belongs to the membership too, so offboarding
  /// takes it with the person.
  sourceBaselineCheckpoints   SourceBaselineCheckpoint[]   @relation("SourceBaselineCheckpointMember")
  /// The content-processing authorization belongs to the membership too, so offboarding takes the
  /// employee's content consent with them.
  sourceContentAuthorizations SourceContentAuthorization[] @relation("SourceContentAuthorizationMember")
  /// Loop Intelligence (PR A). One person's domain intelligence belongs to their membership.
  intelligenceDigests         IntelligenceDigest[]         @relation("IntelligenceDigestMember")
  entityLinks                 EntityLink[]                 @relation("EntityLinkMember")
  intelligenceRefreshRequests IntelligenceRefreshRequest[] @relation("IntelligenceRefreshMember")
  /// Daily Loop (DL-1). One person's own work state, in THIS organization: it belongs to the
  /// membership, so offboarding takes it with them.
  workSourceCursors           WorkSourceCursor[]           @relation("WorkSourceCursorMember")
  workDrafts                  WorkDraft[]                  @relation("WorkDraftMember")
  workSyncRuns                WorkSyncRun[]                @relation("WorkSyncRunMember")
  workCorrespondents          WorkCorrespondent[]          @relation("WorkCorrespondentMember")
  workThreads                 WorkThread[]                 @relation("WorkThreadMember")
  workMessages                WorkMessage[]                @relation("WorkMessageMember")
  workEvents                  WorkEvent[]                  @relation("WorkEventMember")
  workDocuments               WorkDocument[]               @relation("WorkDocumentMember")
  workItems                   WorkItem[]                   @relation("WorkItemMember")
  workItemObservations        WorkItemObservation[]        @relation("WorkItemObservationMember")
  workBriefs                  WorkBrief[]                  @relation("WorkBriefMember")
  workFeedback                WorkFeedback[]               @relation("WorkFeedbackMember")
  employeeWorkPreferences     EmployeeWorkPreferences[]    @relation("EmployeeWorkPreferencesMember")
  /// Identity match suggestions resting on this person's private evidence (D1).
  privateHypotheses           IntelligenceHypothesis[]     @relation("IntelligenceHypothesisPrivateTo")

  @@unique([userId, organizationId])
  @@index([organizationId, status])
  @@map("organization_memberships")
}

// ---------------------------------------------------------------------------
// Customer & Intelligence
// ---------------------------------------------------------------------------

/// CRM Phase Zero P0.2e -- an authorized person's assertion that a tenant's
/// Customer record is a canonical Party.
///
/// A PROJECTION LINK, NOT IDENTITY. Customer stays the legacy intake / CRM record
/// and the Party (CognitiveIdentity) stays the identity. This row says only that
/// someone holding identityResolution:approve linked the two, when, on what basis
/// -- and, if it was undone, who undid it and why.
///
/// HISTORY IS NEVER OVERWRITTEN. A link is reversed by stamping `reversed*` on the
/// same row, never by deleting or repointing it; linking the Customer again writes
/// a NEW row. `activeCustomerId` equals `customerId` while the link is active and
/// is NULL once reversed, so its uniqueness allows at most one active link per
/// Customer (Postgres treats NULLs as distinct) without a partial index Prisma
/// cannot express. There is no relinking in place.
///
/// `partyId` is a scalar id, like every other identity reference in this schema.
model CustomerPartyLink {
  id               String                   @id @default(cuid())
  organizationId   String
  customerId       String
  partyId          String
  basis            IdentityResolutionMethod
  linkedByUserId   String?
  linkedAt         DateTime                 @default(now())
  /// Equals customerId while active; NULL once reversed. One active link per Customer.
  activeCustomerId String?                  @unique
  reversedAt       DateTime?
  reversedByUserId String?
  reversalReason   String?
  createdAt        DateTime                 @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  linkedBy     User?        @relation("CustomerPartyLinkCreator", fields: [linkedByUserId], references: [id], onDelete: SetNull)
  reversedBy   User?        @relation("CustomerPartyLinkReverser", fields: [reversedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, customerId])
  @@index([organizationId, partyId])
  @@map("customer_party_links")
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  externalId     String? // id in the source system (e.g. ServicesInMyCity)
  firstName      String?
  lastName       String?
  email          String?
  phone          String?
  locale         String?
  tags           String[] @default([])
  // Industry-specific fields live here, keeping the core generic.
  attributes     Json     @default("{}")
  metadata       Json     @default("{}")
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  interactions    Interaction[]
  conversations   Conversation[]
  bookings        Booking[]
  orders          Order[]
  serviceRequests ServiceRequest[]
  signals         Signal[]
  /// CRM P0.2e. Every governed link from this intake record to a canonical Party,
  /// active and reversed. Customer is a projection; the Party is the identity.
  partyLinks      CustomerPartyLink[]

  @@unique([organizationId, externalId])
  @@index([organizationId])
  @@index([organizationId, email])
  @@index([organizationId, phone])
  @@map("customers")
}

// A single touchpoint on the customer timeline (channel-agnostic).
model Interaction {
  id             String               @id @default(cuid())
  organizationId String
  customerId     String?
  conversationId String?
  channel        ChannelType
  kind           InteractionKind      @default(OTHER)
  direction      InteractionDirection
  occurredAt     DateTime             @default(now())
  summary        String?
  // Provider attribution without provider lock-in.
  provider       String? // e.g. "telnyx", "twilio"
  externalId     String?
  payload        Json                 @default("{}")
  metadata       Json                 @default("{}")
  createdAt      DateTime             @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([organizationId, kind])
  @@index([customerId])
  @@index([conversationId])
  /// One Intake Record's timeline, newest first (Universal Activity, slice A2).
  /// PERFORMANCE ONLY: `(customerId)` already answers this query, by reading every
  /// row that record holds and sorting them. Semantics are identical.
  @@index([organizationId, customerId, occurredAt])
  @@map("interactions")
}

// A threaded conversation spanning one or more messages on a channel.
model Conversation {
  id             String             @id @default(cuid())
  organizationId String
  customerId     String?
  assigneeId     String?
  aiAgentId      String?
  channel        ChannelType
  status         ConversationStatus @default(OPEN)
  subject        String?
  lastMessageAt  DateTime?
  metadata       Json               @default("{}")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignee     User?         @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  aiAgent      AIAgent?      @relation(fields: [aiAgentId], references: [id], onDelete: SetNull)
  messages     Message[]
  interactions Interaction[]
  signals      Signal[]

  @@index([organizationId, status])
  @@index([customerId])
  @@map("conversations")
}

model Message {
  id             String      @id @default(cuid())
  organizationId String
  conversationId String
  actorType      ActorType
  actorId        String? // userId, customerId, or aiAgentId depending on actorType
  type           MessageType @default(TEXT)
  body           String?
  // Provider attribution (e.g. message SID) without coupling to a provider.
  provider       String?
  externalId     String?
  attachments    Json        @default("[]")
  metadata       Json        @default("{}")
  sentAt         DateTime    @default(now())
