{
  "name": "emgloop-platform",
  "version": "0.1.0",
  "private": true,
  "description": "EMG Loop \u2014 an AI-first operating system for customer-facing businesses.",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "npm run -w @emgloop/database generate",
    "db:migrate": "npm run -w @emgloop/database migrate",
    "db:studio": "npm run -w @emgloop/database studio",
    "certify:observation-days": "tsx scripts/operations/certify-observation-days.ts",
    "reconcile:provider-day": "tsx scripts/diagnostics/reconcile-provider-day.ts",
    "reconcile:provider-days": "tsx scripts/operations/reconcile-provider-days.ts",
    "declare:member-expectations": "tsx scripts/operations/declare-member-expectations.ts",
    "register:measurement-source": "tsx scripts/operations/register-measurement-source.ts",
    "declare:source-authority": "tsx scripts/operations/declare-measure-source-authority.ts",
    "correct:source-metric-definition": "tsx scripts/operations/correct-measurement-source-metric-definition.ts",
    "bootstrap:stage3": "tsx scripts/operations/bootstrap-stage3-production.ts",
    "read:reconciliation-evidence": "tsx scripts/operations/read-reconciliation-evidence.ts",
    "read:event-coverage": "tsx scripts/operations/read-integration-event-coverage.ts",
    "poll:callgrid": "tsx scripts/operations/poll-callgrid-interval.ts",
    "test:operations": "node --import tsx --test scripts/operations/*.test.ts",
    "test:diagnostics": "node --import tsx --test scripts/diagnostics/*.test.ts",
    "typecheck:operations": "tsc --noEmit -p scripts/tsconfig.json"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "tsx": "^4.16.2",
    "turbo": "^2.1.0",
    "typescript": "^5.5.4"
  },
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20.0.0"
  }
}
